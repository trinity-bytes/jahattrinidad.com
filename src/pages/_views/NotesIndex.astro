---
import Base from '../../layouts/Base.astro';
import Notes from '../../components/sections/Notes.astro';
import PageHero from '../../components/sections/PageHero.astro';
import PageContact from '../../components/sections/PageContact.astro';
import PageFooter from '../../components/sections/PageFooter.astro';
import { collectionPath, listLinks, listPosts, type Locale } from '../../lib/content';
import { breadcrumbNode, buildSeo, jsonLdGraph, pageTitle, personNode } from '../../lib/seo';
import { getImage } from 'astro:assets';
import profile from '../../assets/profile/jahat.jpg';
import { getDictionary, localeGroup, localizedPath } from '../../lib/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
// S7: posts are English-only for now; every locale lists the English entries.
const postsLang: Locale = 'en';
const t = getDictionary(lang);
const links = (await listLinks()).map((link) => link.data);

const site = Astro.site;
if (!site) {
  throw new Error(
    'astro.config.mjs must define `site` before this page can compute canonical URLs.'
  );
}

const posts = await listPosts({ lang: postsLang });
// The links collection contains profiles, not dated individual posts.
const elsewhere = links.filter((link) => ['LinkedIn', 'Instagram', 'YouTube'].includes(link.label))
  .map((link) => ({ platform: link.label, href: link.url }));

const portrait = await getImage({ src: profile, width: 600, height: 600, format: 'jpg' });
const person = personNode({
  site,
  description: t.meta.homeDescription,
  sameAs: links.map((link) => link.url),
  image: portrait.src,
});
const jsonLd = jsonLdGraph([
  person,
  breadcrumbNode(site, [
    { name: t.nav.home, path: localizedPath(lang, '/') },
    { name: t.nav.notes, path: collectionPath('posts', lang) },
  ]),
]);

const seo = buildSeo({
  jsonLd,
  title: pageTitle(t.nav.notes, t.meta.notesWhat),
  description: t.meta.notesDescription,
  path: collectionPath('posts', lang),
  lang,
  site,
  group: localeGroup(collectionPath('posts', 'en')),
});
---

<Base lang={lang} seo={seo} contactOnPage profileLinks={links.map((link) => ({ label: link.label, href: link.url }))}>
  <PageHero variant="notes" word={t.nav.notes}>
    <p class="eyebrow">{t.notes.eyebrow}</p>
    <p class="headline">{t.notes.headline}</p>
    <p class="sub">{t.notes.sub}</p>
  </PageHero>
  <!-- Writing content comes from the same collection as Home. -->
  <Notes index lang={lang} postsLang={postsLang} marker={t.notes.writingMarker} headline={t.notes.writingHeading}
    strings={{ ...t.notes, elsewhereLatest: t.footer.elsewhere }} inside={t.home.inside.notes} posts={posts} elsewhere={elsewhere} allWritingHref="/rss.xml" />
  <PageContact lang={lang} links={links} marker={t.notes.contactMarker} />
  <PageFooter slot="footer" lang={lang} links={links} contactOnPage compact />
</Base>
