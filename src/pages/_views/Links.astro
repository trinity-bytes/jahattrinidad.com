---
import { Image, Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/ui/Icon.astro';
import { collectionPath, entryPath, entrySlug, listLinks, listPosts, listProjects, type Locale } from '../../lib/content';
import { buildSeo } from '../../lib/seo';
import { cvPath } from '../../lib/cv';
import { getDictionary, localeGroup, localizedPath } from '../../lib/i18n';
import sky from '../../assets/hero/sky.png';
import hill from '../../assets/hero/near-hill.png';
import profile from '../../assets/profile/jahat.jpg';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
// S7: posts are English-only for now; every locale lists the English entries.
const postsLang: Locale = 'en';
const t = getDictionary(lang);
const newTab = t.common.newTab;
const copy = t.links;

const site = Astro.site;
if (!site) {
  throw new Error(
    'astro.config.mjs must define `site` before this page can compute canonical URLs.'
  );
}

// listLinks() takes no `lang`: the links collection is language-agnostic (D5 exception).
const links = (await listLinks()).map((link) => link.data);
const projects = await listProjects({ lang });
const caseStudies = projects.filter((project) => project.data.tier === 'case-study').length;
const [latest] = await listPosts({ lang: postsLang, order: 'newest', limit: 1 });

const seo = buildSeo({
  title: t.nav.links,
  description: t.meta.linksDescription,
  path: localizedPath(lang, '/links/'),
  lang,
  site,
  group: localeGroup('/links/'),
});

const cards = [
  { href: collectionPath('projects', lang), title: copy.workTitle, sub: copy.workSub(projects.length, caseStudies) },
  { href: collectionPath('posts', lang), title: copy.notesTitle, sub: copy.notesSub },
  ...(latest
    ? [{ href: entryPath('posts', postsLang, entrySlug(latest.entry)), title: latest.entry.data.title, sub: copy.latestSub(latest.readingTime) }]
    : []),
];
---

<Base lang={lang} seo={seo} nav={false}>
  <div class="page">
    <div class="landscape" aria-hidden="true">
      <Picture src={sky} formats={['avif', 'webp']} widths={[768, 1440, 2400, 3400]} sizes="(min-width: 64.0625rem) 115vw, 260vw" alt="" class="layer sky" loading="eager" fetchpriority="high" />
      <Picture src={hill} formats={['avif', 'webp']} widths={[768, 1440, 2400, 2952]} sizes="(min-width: 64.0625rem) 115vw, 310vw" alt="" class="layer hill" loading="eager" />
      <div class="veil"></div>
    </div>
    <div class="content">
      <section class="identity" aria-labelledby="links-name">
        <Image class="avatar" src={profile} alt="" width={288} height={288} densities={[1, 2]} loading="eager" />
        <h1 id="links-name">{t.nav.brand}</h1>
        <p class="description">{copy.description}</p>
        <p class="availability"><span class="dot" aria-hidden="true"></span>{copy.availability}</p>
      </section>
      <nav class="cards" aria-label={t.nav.links}>
        <ul>
          {cards.map((card) => (
            <li><a class="card" href={card.href}><span class="text"><span class="title">{card.title}</span><span class="sub">{card.sub}</span></span><Icon name="arrow-right" size={20} /></a></li>
          ))}
          <li><a class="card" href={cvPath(lang)} target="_blank" rel="noopener noreferrer"><span class="text"><span class="title">{copy.cvTitle}</span><span class="sub">{copy.cvSub}</span></span><Icon name="arrow-up-right" size={20} /><span class="visually-hidden"> {newTab}</span></a></li>
          <li><a class="card filled" href={`${localizedPath(lang, '/')}#contact`}><span class="text"><span class="title">{copy.writeTitle}</span><span class="sub">{copy.writeSub}</span></span><Icon name="arrow-right" size={20} /></a></li>
        </ul>
      </nav>
      <section class="elsewhere" aria-labelledby="links-elsewhere">
        <h2 id="links-elsewhere">{copy.elsewhere}</h2>
        <ul>
          {links.map((link) => (
            <li><a class="logo" href={link.url} target="_blank" rel="me noopener noreferrer" aria-label={`${link.label} ${newTab}`}><Icon name={link.icon} size={20} /></a></li>
          ))}
        </ul>
      </section>
    </div>
    <p class="domain">{site.host}</p>
  </div>
</Base>

<style>
  .page {
    --sky-w: 1981.415px; --sky-left: calc(50cqw - 736px); --sky-top: -402px;
    --hill-w: 2371.521px; --hill-left: calc(50cqw - 929px); --hill-top: -345px;
    --veil-h: 520px;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    min-height: 940px;
    padding: 56px var(--gutter) 24px;
    background: var(--color-bg);
    color: var(--color-text);
  }
  .landscape { position: absolute; inset: 0; z-index: -1; overflow: hidden; background: var(--color-light-sun); }
  .layer { position: absolute; display: block; max-width: none; height: auto; }
  .sky { width: var(--sky-w); left: var(--sky-left); top: var(--sky-top); }
  .hill { width: var(--hill-w); left: var(--hill-left); top: var(--hill-top); }
  .veil { position: absolute; inset: 0 0 auto; height: var(--veil-h); background: linear-gradient(to bottom, color-mix(in srgb, var(--cream) 55%, transparent), transparent); }

  .content { display: flex; flex-direction: column; gap: 24px; width: 100%; max-width: 440px; margin-inline: auto; }
  ul { margin: 0; padding: 0; list-style: none; }
  p, h1, h2 { margin: 0; }

  .identity { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .avatar { width: 84px; height: 84px; border: 3px solid var(--white); border-radius: 50%; object-fit: cover; }
  h1 { font: 600 34px / 38px var(--font-display), sans-serif; letter-spacing: -0.02em; color: var(--color-heading); }
  .description { max-width: 440px; font: 400 17px / 24px var(--font-sans), sans-serif; }
  .availability { display: flex; align-items: center; gap: 8px; font: 500 12px / 1.3 var(--font-mono), monospace; letter-spacing: 0.04em; text-transform: uppercase; color: var(--green-900); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--sun); }

  .cards ul { display: flex; flex-direction: column; gap: 10px; }
  .card { display: flex; align-items: center; gap: 12px; padding: 16px 18px 16px 20px; background: var(--color-card); border: 1px solid var(--green-950); border-radius: 20px; color: var(--green-950); text-decoration: none; }
  .card:hover { background: var(--white); }
  .text { display: flex; flex: 1; flex-direction: column; gap: 3px; min-width: 0; }
  .title { font: 500 17px / 22px var(--font-sans), sans-serif; text-wrap: balance; }
  .sub { font: 500 12px / 1.3 var(--font-mono), monospace; letter-spacing: 0.03em; text-transform: uppercase; color: var(--green-700); }
  .card :global(svg) { flex: none; }
  .card.filled { background: var(--green-950); border-color: var(--green-950); color: var(--white); }
  .card.filled:hover { background: var(--green-900); }
  .card.filled .sub { color: var(--green-300); }

  .elsewhere { display: flex; flex-direction: column; gap: 10px; }
  .elsewhere h2 { font: 500 12px / 1.3 var(--font-mono), monospace; letter-spacing: 0.06em; text-transform: uppercase; color: var(--green-900); }
  .elsewhere ul { display: flex; flex-wrap: wrap; gap: 10px; }
  .logo { display: grid; place-items: center; width: 52px; height: 52px; background: var(--color-card); border: 1px solid var(--green-950); border-radius: 50%; color: var(--green-950); }
  .logo:hover { background: var(--white); }

  .domain { width: 100%; max-width: 440px; margin: auto auto 0; padding-top: 48px; font: 500 12px / 1.3 var(--font-mono), monospace; letter-spacing: 0.04em; color: var(--white); }
  .card, .logo { transition: background-color 150ms ease; }
  @media (prefers-reduced-motion: reduce) { .card, .logo { transition: none; } }

  @media (min-width: 48rem) {
    .page {
      --sky-w: 2972px; --sky-left: calc(50cqw - 1486px); --sky-top: -600px;
      --hill-w: 3320px; --hill-left: calc(50cqw - 1660px); --hill-top: -699px;
      --veil-h: 620px;
      min-height: 1040px;
      padding: 96px var(--gutter) 28px;
    }
  }
  @media (min-width: 64.0625rem) {
    .page {
      --sky-w: 1645px; --sky-left: calc(50cqw - 720px); --sky-top: -197px;
      --hill-w: 1617px; --hill-left: calc(50cqw - 806px); --hill-top: -13px;
      --veil-h: 640px;
      min-height: 900px;
      padding: 222px 0 28px;
    }
    .content { display: grid; grid-template-columns: 460px 520px; grid-template-areas: 'identity cards' 'elsewhere cards'; align-items: center; column-gap: 80px; row-gap: 40px; max-width: none; width: auto; }
    .identity { grid-area: identity; align-self: end; }
    .cards { grid-area: cards; grid-row: 1 / span 2; }
    .elsewhere { grid-area: elsewhere; align-self: start; }
    .avatar { width: 96px; height: 96px; border-width: 3.4px; }
    h1 { font-size: 56px; line-height: 60px; letter-spacing: -0.02em; }
    .description { font-size: 20px; line-height: 28px; max-width: 440px; }
    .domain { width: 1060px; max-width: none; margin: 0; padding-top: 0; position: absolute; bottom: 24px; left: calc(50% - 530px); }
  }
</style>
