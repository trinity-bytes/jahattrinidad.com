---
import Button from '../../components/ui/Button.astro';
import BackLink from '../../components/ui/BackLink.astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/sections/PageHero.astro';
import PageContact from '../../components/sections/PageContact.astro';
import PageFooter from '../../components/sections/PageFooter.astro';
import Icon from '../../components/ui/Icon.astro';
import CaseStudy from '../../components/sections/CaseStudy.astro';
import NextCaseStudy from '../../components/sections/NextCaseStudy.astro';
import ProjectPage from '../../components/sections/ProjectPage.astro';
import { collectionPath, entryPath, ogImagePath, listLinks, listProjects, entrySlug, getTranslationGroup, renderEntry, type Locale, type Project } from '../../lib/content';
import { breadcrumbNode, buildSeo, isLiveApp, jsonLdGraph, metaDescription, pageTitle, personNode, projectNode, absoluteUrl, whatItIs } from '../../lib/seo';
import { getImage } from 'astro:assets';
import profile from '../../assets/profile/jahat.jpg';
import { getDictionary, localizedPath } from '../../lib/i18n';

export interface Props {
  entry: Project;
  lang: Locale;
}

const { entry, lang } = Astro.props;
const t = getDictionary(lang);
const newTab = t.common.newTab;
const links = (await listLinks()).map((link) => link.data);

const site = Astro.site;
if (!site) {
  throw new Error(
    'astro.config.mjs must define `site` before this page can compute canonical URLs.'
  );
}

// projects do not carry a reading time — that is a posts-only derived
// field (design.md §4); do not import getReadingTime here.
const group = await getTranslationGroup('projects', entry);

const slug = entrySlug(entry);
const pagePath = entryPath('projects', lang, slug);
const cardPath = ogImagePath('projects', lang, slug);
const description = metaDescription(
  entry.data.description,
  t.meta.projectSignatures,
  entry.data.page?.sub ?? entry.data.heroDescription,
);

const portrait = await getImage({ src: profile, width: 600, height: 600, format: 'jpg' });
const person = personNode({
  site,
  description: t.meta.homeDescription,
  sameAs: links.map((link) => link.url),
  image: portrait.src,
});
const jsonLd = jsonLdGraph([
  person,
  breadcrumbNode(site, [
    { name: t.nav.home, path: localizedPath(lang, '/') },
    { name: t.nav.work, path: collectionPath('projects', lang) },
    { name: entry.data.title, path: pagePath },
  ]),
  projectNode({
    site,
    url: absoluteUrl(pagePath, site).href,
    lang,
    name: entry.data.title,
    description,
    image: cardPath,
    datePublished: entry.data.publishDate,
    dateModified: entry.data.updatedDate,
    app: isLiveApp(slug, entry.data.demoUrl),
    solo: entry.data.team?.solo ?? false,
    demoUrl: entry.data.demoUrl,
  }),
]);

const seo = buildSeo({
  jsonLd,
  title: pageTitle(entry.data.title, whatItIs(entry.data.title, entry.data.kind, t.meta.projectWhat)),
  description,
  path: pagePath,
  image: { path: cardPath, alt: entry.data.title },
  lang,
  site,
  group,
  type: 'article',
  publishDate: entry.data.publishDate,
  updatedDate: entry.data.updatedDate,
});

const { Content } = await renderEntry(entry);
const all = await listProjects({ lang });
const nextCase = all.find(project => project.id !== entry.id && project.data.tier === 'case-study');
// Project pages link to the next project page in list order, wrapping around.
const projectPages = all.filter(project => project.data.tier === 'project' && project.data.page);
const nextProject = projectPages.length > 1 ? projectPages[(projectPages.findIndex(project => project.id === entry.id) + 1) % projectPages.length] : undefined;

const { data } = entry;
const eyebrow = [data.page ? t.projectPage.eyebrow : t.caseStudy.eyebrow, data.kind].filter(Boolean).join(' · ');
---

<Base lang={lang} seo={seo} contactOnPage profileLinks={links.map((link) => ({ label: link.label, href: link.url }))}>
  <PageHero variant="case">
    <BackLink href={collectionPath('projects', lang)} label={t.caseStudy.allWork} />
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="title">{data.page?.headline ?? data.title}</h1>
    <p class="sub">{data.page?.sub ?? data.heroDescription ?? data.description}</p>
    {(data.demoUrl || data.repoUrl) && (
      <div class="actions">
        {data.demoUrl && <Button data-magnetic href={data.demoUrl} label={data.demoLabel ?? t.caseStudy.openProject} newTab={newTab} />}
        {data.repoUrl && <Button data-magnetic href={data.repoUrl} label={t.caseStudy.source} newTab={newTab} variant="secondary" />}
      </div>
    )}
  </PageHero>
  {data.page ? <ProjectPage page={data.page} decisions={data.decisions} cover={data.coverImage} coverAlt={data.coverImageAlt} website={data.demoUrl} strings={t} /> : data.caseStudy ? <CaseStudy data={data.caseStudy} decisions={data.decisions} cover={data.coverImage} coverAlt={data.coverImageAlt} website={data.demoUrl} strings={t.caseStudy}><Content /></CaseStudy> : <div class="container">
  <article>
    {entry.data.role && <p><strong>{t.project.role}:</strong> {entry.data.role}</p>}
    {entry.data.timeframe && <p><strong>{t.project.timeframe}:</strong> {entry.data.timeframe}</p>}
    <p>
      <strong>{t.project.stack}:</strong> {entry.data.stack.join(', ')}
    </p>
    <Content />
  </article>
  </div>}
  {data.page && nextProject && <NextCaseStudy marker={t.projectPage.nextProject} project={nextProject} href={entryPath('projects', lang, entrySlug(nextProject))} allWorkHref={collectionPath('projects', lang)} strings={t} />}
  {data.caseStudy && nextCase && <NextCaseStudy project={nextCase} href={entryPath('projects', lang, entrySlug(nextCase))} allWorkHref={collectionPath('projects', lang)} strings={t} />}
  <PageContact lang={lang} links={links} marker={t.caseStudy.contactMarker} />
  <PageFooter slot="footer" lang={lang} links={links} contactOnPage compact />
</Base>
