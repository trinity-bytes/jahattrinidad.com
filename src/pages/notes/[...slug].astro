---
import BackLink from '../../components/ui/BackLink.astro';
import Button from '../../components/ui/Button.astro';
import TextLink from '../../components/ui/TextLink.astro';
import { getImage, Image } from 'astro:assets';
import profile from '../../assets/profile/jahat.jpg';
import PostRow from '../../components/content/PostRow.astro';
import PullQuote from '../../components/content/PullQuote.astro';
import Note from '../../components/content/Note.astro';
import Figure from '../../components/content/Figure.astro';
import Icon from '../../components/ui/Icon.astro';
import KeepHyphenated from '../../components/ui/KeepHyphenated.astro';
import { localizedPath } from '../../lib/i18n';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/sections/PageHero.astro';
import SkyBand from '../../components/sections/SkyBand.astro';
import PageFooter from '../../components/sections/PageFooter.astro';
import {
  collectionPath,
  entryPath,
  ogImagePath,
  listLinks,
  listPosts,
  postRoutes,
  getReadingTime,
  getTranslationGroup,
  renderEntry,
  type Post,
} from '../../lib/content';
import { absoluteUrl, blogPostingNode, breadcrumbNode, buildSeo, jsonLdGraph, metaDescription, pageTitle, personNode, POST_TITLE_MAX } from '../../lib/seo';
import { getDictionary } from '../../lib/i18n';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  return postRoutes('en');
}

export interface Props {
  entry: Post;
}

const { entry } = Astro.props;
const lang = 'en' as const;
const t = getDictionary(lang);
const newTab = t.common.newTab;
const links = (await listLinks()).map((link) => link.data);

const site = Astro.site;
if (!site) {
  throw new Error(
    'astro.config.mjs must define `site` before this page can compute canonical URLs.'
  );
}

const readingTime = getReadingTime(entry);
const group = await getTranslationGroup('posts', entry);

const pagePath = entryPath('posts', lang, entry.id);
const cardPath = ogImagePath('posts', lang, entry.id);
const description = metaDescription(entry.data.description, t.meta.postSignatures);
const typeLabel = t.notes[entry.data.type];

const portrait = await getImage({ src: profile, width: 600, height: 600, format: 'jpg' });
const person = personNode({
  site,
  description: t.meta.homeDescription,
  sameAs: links.map((link) => link.url),
  image: portrait.src,
});
const jsonLd = jsonLdGraph([
  person,
  breadcrumbNode(site, [
    { name: t.nav.home, path: localizedPath(lang, '/') },
    { name: t.nav.notes, path: collectionPath('posts', lang) },
    { name: entry.data.title, path: pagePath },
  ]),
  blogPostingNode({
    site,
    url: entry.data.canonicalUrl ?? absoluteUrl(pagePath, site).href,
    lang,
    name: entry.data.title,
    description,
    image: cardPath,
    datePublished: entry.data.publishDate,
    dateModified: entry.data.updatedDate,
  }),
]);

const seo = buildSeo({
  jsonLd,
  title: pageTitle(entry.data.title, typeLabel, { max: POST_TITLE_MAX }),
  description,
  path: pagePath,
  image: { path: cardPath, alt: entry.data.title },
  lang,
  site,
  // A canonicalUrl override suppresses all hreflang alternates (D10).
  canonicalOverride: entry.data.canonicalUrl,
  group,
  type: 'article',
  publishDate: entry.data.publishDate,
  updatedDate: entry.data.updatedDate,
});

const { Content, headings } = await renderEntry(entry);
const morePosts = (await listPosts({ lang })).filter((post) => post.entry.id !== entry.id).slice(0, 2);
// "In this post" lists the h2 sections only; without any, the block is left out entirely.
const sections = headings.filter((heading) => heading.depth === 2);
---

<Base lang={lang} seo={seo} profileLinks={links.map((link) => ({ label: link.label, href: link.url }))}>
  <PageHero variant="post">
    <div class="meta">
      <BackLink class="meta-back" href={collectionPath('posts', lang)} label={t.notes.allNotes} />
      <span class="meta-line">
        {typeLabel}{' · '}<time datetime={entry.data.publishDate.toISOString()}>{formatDate(entry.data.publishDate, lang)}</time>{' · '}{t.post.readingTime(readingTime)}
      </span>
    </div>
    <h1 class="title"><KeepHyphenated text={entry.data.title} /></h1>
    <p class="sub">{entry.data.description}</p>
  </PageHero>
  <section class="article-section">
    <div class="article-layout">
      <aside class="contents" aria-label={t.post.inThisPost}>
        {sections.length > 0 && <><h2>{t.post.inThisPost}</h2><ul>{sections.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></>}
        {entry.data.canonicalUrl && <TextLink class="canonical" href={entry.data.canonicalUrl} destination="external" label={t.post.published} newTab={newTab} />}
      </aside>
      <article class="article">
        <div class="prose" data-copy={t.post.copy} data-copied={t.post.copied} data-code={t.post.code}><Content components={{ PullQuote, Note, Figure }} /></div>
        <template data-copied-icon><Icon name="check" size={14} /></template>
        <div class="article-end">
          {(entry.data.updatedDate || entry.data.tags.length > 0) && <p class="updated">{entry.data.updatedDate && <span>{t.post.updated} {formatDate(entry.data.updatedDate, lang)}</span>}{entry.data.updatedDate && entry.data.tags.length > 0 && <span aria-hidden="true"> · </span>}{entry.data.tags.join(' · ')}</p>}
          <div class="author"><Image class="avatar" src={profile} alt="" width={112} height={112} densities={[1, 2]} loading="lazy" /><div><p class="author-name">{t.post.author}</p><p class="author-role">{t.post.authorRole}</p><Button href={`${localizedPath(lang, '/')}#contact`} label={t.post.write} icon="arrow-right" /></div></div>
          {morePosts.length > 0 && <div class="more"><h2>{t.post.keepReading}</h2><ul>{morePosts.map(({ entry: post, readingTime }) => <li><PostRow detailed href={entryPath('posts', lang, post.id)} title={post.data.title} type={post.data.type} typeLabel={t.notes[post.data.type]} meta={`${formatDate(post.data.publishDate, lang)} · ${t.post.readingTime(readingTime)}`} /></li>)}</ul></div>}
        </div>
      </article>
    </div>
  </section>
  <SkyBand />
  <PageFooter slot="footer" lang={lang} links={links} compact />
</Base>

<script>
  import { createFlash } from '../../lib/flash';
  import { activeHeadingIndex, readingLine } from '../../lib/toc';

  const contents = document.querySelector<HTMLElement>('.contents');
  if (contents) {
    const sections = [...contents.querySelectorAll<HTMLAnchorElement>('li a')].flatMap((link) => {
      const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
      return heading ? [{ link, heading }] : [];
    });
    if (sections.length) {
      type Section = (typeof sections)[number];
      const mark = (current: Section) => {
        for (const { link } of sections) {
          if (link === current.link) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        }
      };
      /** A clicked section stays current while the page travels to it. */
      let target: Section | null = null;
      let frame = 0;
      const update = () => {
        frame = 0;
        // The headings' scroll-margin-top is where a jump lands them, so it is also where reading starts.
        const line = readingLine(getComputedStyle(sections[0]!.heading).scrollMarginTop);
        if (target) {
          if (Math.abs(target.heading.getBoundingClientRect().top - line) > 2) return;
          target = null;
        }
        mark(sections[activeHeadingIndex(sections.map(({ heading }) => heading.getBoundingClientRect().top), line)]!);
      };
      const schedule = () => { frame ||= requestAnimationFrame(update); };
      for (const section of sections) {
        section.link.addEventListener('click', () => {
          target = section;
          mark(section);
        });
      }
      // The visitor takes over the scroll: follow the page again.
      for (const type of ['wheel', 'touchstart', 'pointerdown', 'keydown']) {
        window.addEventListener(type, () => { target = null; }, { passive: true });
      }
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule);
      update();
    }
  }

  for (const prose of document.querySelectorAll<HTMLElement>('.prose')) {
    for (const pre of prose.querySelectorAll<HTMLPreElement>('pre')) {
      const code = pre.querySelector('code');
      if (!code) continue;
      const wrapper = document.createElement('div'); wrapper.className = 'code-block';
      // The block stays dark in the Outside lens, so focus rings inside it are the light green.
      wrapper.dataset.surface = 'dark';
      const bar = document.createElement('div'); bar.className = 'code-bar';
      const label = document.createElement('span'); label.textContent = pre.dataset.title || prose.dataset.code || '';
      // pre is a focusable scroll region (Shiki gives it tabindex), so it needs a name.
      pre.setAttribute('role', 'region'); pre.setAttribute('aria-label', label.textContent || '');
      const button = document.createElement('button'); button.type = 'button';
      const caption = (text: string) => {
        const span = document.createElement('span'); span.className = 'copy-label'; span.textContent = text;
        return span;
      };
      button.replaceChildren(caption(prose.dataset.copy || ''));
      const status = document.createElement('span'); status.className = 'copy-status'; status.setAttribute('aria-live', 'polite');
      const copied = createFlash(
        () => {
          const icon = document.querySelector<HTMLTemplateElement>('[data-copied-icon]')?.content.cloneNode(true);
          button.replaceChildren(...(icon ? [icon] : []), caption(prose.dataset.copied || ''));
          status.textContent = prose.dataset.copied || '';
        },
        () => { button.replaceChildren(caption(prose.dataset.copy || '')); status.textContent = ''; },
        1600,
      );
      button.addEventListener('click', async () => {
        // A denied clipboard changes nothing: no false "Copied".
        try { await navigator.clipboard.writeText(code.textContent || ''); copied(); }
        catch { status.textContent = ''; }
      });
      const scroller = document.createElement('div'); scroller.className = 'code-scroll';
      bar.append(label, button, status); pre.before(wrapper); scroller.append(pre); wrapper.append(bar, scroller);
      const edge = () => { scroller.toggleAttribute('data-more', pre.scrollLeft + pre.clientWidth < pre.scrollWidth - 1); };
      pre.addEventListener('scroll', edge, { passive: true });
      new ResizeObserver(edge).observe(pre);
    }
  }
</script>
<style>
  /* Boards 2522:1287, 2522:1713 and 2522:2326. */
  .article-section { background: var(--cream); color: var(--green-950); }
  /* The reading column shares the hero's left edge (NL-08). */
  .article-layout { max-width: calc(var(--content-max) + 2 * var(--gutter)); margin: auto; padding: var(--section-pad) var(--gutter); display: flex; flex-direction: column; gap: var(--space-2xl); }
  .article { min-width: 0; }
  /* One 40px step between every block of the article. */
  .prose { color: var(--green-900); font: 400 var(--font-size-body)/1.5 var(--font-sans), sans-serif; overflow-wrap: anywhere; }
  .prose > :global(*) { margin-block: 0; }
  .prose > :global(* + *) { margin-top: var(--space-2xl); }
  .prose :global(:is(h2, h3, h4)) { color: var(--color-heading); font-family: var(--font-display), sans-serif; font-weight: 600; letter-spacing: -0.02em; overflow-wrap: normal; }
  .prose :global(h2) { font-size: var(--font-size-h2); line-height: 1.1; }
  .prose :global(h3) { font-size: var(--font-size-h3); line-height: 1.15; }
  .prose :global(h4) { font-size: var(--font-size-h4); line-height: 1.2; }
  /* In-page jumps land below the sticky nav (69px), at the same offset as the sticky contents. */
  .prose :global(:is(h2, h3, h4)) { scroll-margin-top: 6rem; }
  .prose :global(:not(pre) > code) { color: var(--color-text-muted); font: 400 var(--font-size-caption)/1.6 var(--font-mono), monospace; }

  /* Code block (components 2520:35 and 2522:2318). Shiki writes its background inline on the pre. */
  .prose :global(pre) { padding: var(--space-sm); overflow-x: auto; border-radius: var(--radius-md); background: var(--color-footer) !important; font: 400 var(--font-size-caption)/1.6 var(--font-mono), monospace; overflow-wrap: normal; }
  .prose :global(.code-block) { display: flex; flex-direction: column; gap: var(--space-xs); padding: var(--space-sm); overflow: hidden; border-radius: var(--radius-md); background: var(--color-footer); color: var(--white); }
  .prose :global(.code-bar) { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-md); font: var(--type-meta); letter-spacing: 0.02em; overflow-wrap: anywhere; }
  /* Padded to a 48px hit area; it sets the bar's height. */
  .prose :global(.code-bar button) { display: inline-flex; flex: none; align-items: center; gap: var(--space-xs); padding: var(--space-md) var(--space-sm); color: var(--white); background: transparent; border: 0; border-radius: var(--radius-sm); cursor: pointer; font: var(--type-meta); letter-spacing: 0.02em; }
  .prose :global(.copy-label) { text-underline-offset: 0.2em; }
  @media (hover: hover) and (pointer: fine) { .prose :global(.code-bar button:hover .copy-label) { text-decoration: underline 1px; } }
  .prose :global(.code-scroll) { position: relative; min-width: 0; }
  .prose :global(.code-block pre) { margin: 0; padding: 0; border-radius: 0; }
  .prose :global(.copy-status) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

  /* Component 2520:102. */
  .contents h2, .more h2 { margin: 0 0 var(--space-sm); font: var(--type-meta); letter-spacing: var(--type-meta-tracking); text-transform: uppercase; color: var(--color-text-muted); }
  .contents ul, .more ul { padding: 0; margin: 0; list-style: none; }
  .contents li + li { margin-top: var(--space-sm); }
  .contents li a { display: flex; align-items: center; gap: var(--space-xs); width: fit-content; padding-block: var(--space-2xs); color: var(--color-text-muted); font: 400 var(--font-size-body)/1.5 var(--font-sans), sans-serif; text-decoration: none; }
  .contents li a[aria-current='location'] { color: var(--color-heading); font-weight: 500; }
  .contents li a[aria-current='location']::before { content: ''; flex: none; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: currentColor; }
  .contents li a:active { text-decoration: underline; }
  @media (hover: hover) and (pointer: fine) { .contents li a:hover { text-decoration: underline; } }
  .contents .canonical { margin-block-start: calc(var(--space-xl) - var(--hit-pad)); }

  .article-end { display: flex; flex-direction: column; align-items: stretch; gap: var(--space-2xl); margin-top: var(--space-2xl); }
  .updated { margin: 0; font: var(--type-meta); letter-spacing: var(--type-meta-tracking); text-transform: uppercase; color: var(--color-text-muted); }
  .author { display: flex; align-items: flex-start; gap: var(--space-xl); padding: var(--space-xl); background: var(--color-card); border-radius: var(--radius-lg); }
  .avatar { width: 3.5rem; height: 3.5rem; flex: none; border-radius: 50%; object-fit: cover; background: var(--green-200); }
  .author > div { display: flex; flex: 1; min-width: 0; flex-direction: column; align-items: flex-start; gap: var(--space-md); }
  .author p { margin: 0; color: var(--color-heading); }
  .author-name { font: 600 var(--font-size-h5)/1.25 var(--font-display), sans-serif; letter-spacing: -0.02em; }
  .author-role { font: 400 var(--font-size-body)/1.5 var(--font-sans), sans-serif; }
  @media (min-width: 64.0625rem) {
    .article-layout { display: grid; grid-template-columns: minmax(0, 42.5rem) 15rem; justify-content: start; align-items: start; }
    .contents { grid-column: 2; grid-row: 1; position: sticky; top: 6rem; }
    .article { grid-column: 1; grid-row: 1; }
  }
  @media (max-width: 47.999rem) {
    /* NL-23: a 40px fade says the code line scrolls; it leaves at the end of the line. */
    .prose :global(.code-scroll[data-more]::after) { content: ''; position: absolute; inset: 0 0 0 auto; width: 2.5rem; pointer-events: none; background: linear-gradient(to right, color-mix(in srgb, var(--color-footer) 0%, transparent), var(--color-footer)); }
    .updated span:first-child { display: block; }
  }
</style>
