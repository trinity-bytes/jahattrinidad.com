---
import { Image } from 'astro:assets';
import profile from '../../assets/profile/jahat.jpg';
import PostRow from '../../components/content/PostRow.astro';
import PullQuote from '../../components/content/PullQuote.astro';
import Note from '../../components/content/Note.astro';
import Figure from '../../components/content/Figure.astro';
import Icon from '../../components/ui/Icon.astro';
import { localizedPath } from '../../lib/i18n';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/sections/PageHero.astro';
import SkyBand from '../../components/sections/SkyBand.astro';
import PageFooter from '../../components/sections/PageFooter.astro';
import {
  collectionPath,
  entryPath,
  ogImagePath,
  listLinks,
  listPosts,
  postRoutes,
  getReadingTime,
  getTranslationGroup,
  renderEntry,
  type Post,
} from '../../lib/content';
import { buildSeo } from '../../lib/seo';
import { getDictionary } from '../../lib/i18n';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  return postRoutes('en');
}

export interface Props {
  entry: Post;
}

const { entry } = Astro.props;
const lang = 'en' as const;
const t = getDictionary(lang);
const newTab = t.common.newTab;
const links = (await listLinks()).map((link) => link.data);

const site = Astro.site;
if (!site) {
  throw new Error(
    'astro.config.mjs must define `site` before this page can compute canonical URLs.'
  );
}

const readingTime = getReadingTime(entry);
const group = await getTranslationGroup('posts', entry);

const seo = buildSeo({
  title: entry.data.title,
  description: entry.data.description,
  path: entryPath('posts', lang, entry.id),
  image: { path: ogImagePath('posts', lang, entry.id), alt: entry.data.title },
  lang,
  site,
  // A canonicalUrl override suppresses all hreflang alternates (D10).
  canonicalOverride: entry.data.canonicalUrl,
  group,
  type: 'article',
  publishDate: entry.data.publishDate,
  updatedDate: entry.data.updatedDate,
});

const { Content, headings } = await renderEntry(entry);
const morePosts = (await listPosts({ lang })).filter((post) => post.entry.id !== entry.id).slice(0, 2);
const typeLabel = entry.data.type === 'essay' ? t.notes.essay : t.notes.tutorial;
---

<Base lang={lang} seo={seo} profileLinks={links.map((link) => ({ label: link.label, href: link.url }))}>
  <PageHero variant="post">
    <div class="meta">
      <a href={collectionPath('posts', lang)}><span aria-hidden="true">←&nbsp;</span>{t.notes.allNotes}</a>
      <span class="meta-line">
        <span class="lead" aria-hidden="true">·</span>
        <span>{typeLabel}</span>
        <span aria-hidden="true">·</span>
        <time datetime={entry.data.publishDate.toISOString()}>{formatDate(entry.data.publishDate, lang)}</time>
        <span aria-hidden="true">·</span>
        <span>{t.post.readingTime(readingTime)}</span>
      </span>
    </div>
    <h1 class="title">{entry.data.title}</h1>
    <p class="sub">{entry.data.description}</p>
  </PageHero>
  <section class="article-section">
    <div class="article-layout">
      <aside class="contents" aria-label={t.post.inThisPost}>
        {headings.length > 0 && <><h2>{t.post.inThisPost}</h2><ul>{headings.filter((heading) => heading.depth === 2).map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></>}
        {entry.data.canonicalUrl && <a class="canonical" href={entry.data.canonicalUrl} target="_blank" rel="noopener noreferrer">{t.post.published} <Icon name="arrow-up-right" size={15} /><span class="visually-hidden"> {newTab}</span></a>}
      </aside>
      <article class="article">
        <div class="prose" data-copy={t.post.copy} data-copied={t.post.copied} data-code={t.post.code}><Content components={{ PullQuote, Note, Figure }} /></div>
        <div class="article-end">
          {(entry.data.updatedDate || entry.data.tags.length > 0) && <p class="updated">{entry.data.updatedDate && <span>{t.post.updated} {formatDate(entry.data.updatedDate, lang)}</span>}{entry.data.updatedDate && entry.data.tags.length > 0 && <span aria-hidden="true"> · </span>}{entry.data.tags.join(' · ')}</p>}
          <div class="author"><Image class="avatar" src={profile} alt="" width={112} height={112} densities={[1, 2]} loading="lazy" /><div><p class="author-name">{t.post.author}</p><p class="author-role">{t.post.authorRole}</p></div><a class="author-link" href={`${localizedPath(lang, '/')}#contact`}>{t.post.write} <span aria-hidden="true">→</span></a></div>
          {morePosts.length > 0 && <div class="more"><h2>{t.post.keepReading}</h2><ul>{morePosts.map(({ entry: post, readingTime }) => <li><PostRow detailed href={entryPath('posts', lang, post.id)} title={post.data.title} description={post.data.description} type={post.data.type} typeLabel={t.notes[post.data.type]} meta={`${formatDate(post.data.publishDate, lang)} · ${t.notes.minutes(readingTime)}`} /></li>)}</ul></div>}
        </div>
      </article>
    </div>
  </section>
  <SkyBand />
  <PageFooter slot="footer" lang={lang} links={links} compact />
</Base>

<script>
  const contents = document.querySelector<HTMLElement>('.contents');
  if (contents && 'IntersectionObserver' in window) {
    const sections = [...contents.querySelectorAll<HTMLAnchorElement>('li a')].flatMap((link) => {
      const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
      return heading ? [{ link, heading }] : [];
    });
    if (sections.length) {
      const update = () => {
        const line = window.innerHeight * 0.3;
        const current = sections.filter(({ heading }) => heading.getBoundingClientRect().top <= line).at(-1) ?? sections[0];
        for (const { link } of sections) {
          if (link === current.link) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        }
      };
      let observer: IntersectionObserver;
      const observe = () => {
        observer?.disconnect();
        // Keep future headings in the region so large jumps cross its top edge.
        observer = new IntersectionObserver(update, {
          rootMargin: `-${window.innerHeight * 0.3}px 0px ${document.documentElement.scrollHeight}px 0px`,
        });
        for (const { heading } of sections) observer.observe(heading);
        update();
      };
      contents.dataset.tracking = '';
      observe();
      window.addEventListener('resize', observe);
    }
  }

  for (const prose of document.querySelectorAll<HTMLElement>('.prose')) {
    for (const pre of prose.querySelectorAll<HTMLPreElement>('pre')) {
      const code = pre.querySelector('code');
      if (!code) continue;
      const wrapper = document.createElement('div'); wrapper.className = 'code-block';
      const bar = document.createElement('div'); bar.className = 'code-bar';
      const label = document.createElement('span'); label.textContent = pre.dataset.title || prose.dataset.code || '';
      const button = document.createElement('button'); button.type = 'button'; button.textContent = prose.dataset.copy || '';
      const status = document.createElement('span'); status.className = 'copy-status'; status.setAttribute('aria-live', 'polite');
      button.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(code.textContent || ''); status.textContent = prose.dataset.copied || ''; }
        catch { status.textContent = ''; }
      });
      bar.append(label, button, status); pre.before(wrapper); wrapper.append(bar, pre);
    }
  }
</script>
<style>
  .article-section { background: var(--cream); color: var(--green-950); }
  .article-layout { max-width: calc(var(--content-max) + 2 * var(--gutter)); margin: auto; padding: 4.5rem var(--gutter); display: flex; flex-direction: column; gap: 2.5rem; }
  .article { min-width: 0; max-width: 42.5rem; }
  .prose { font: 400 1.1875rem/1.65 var(--font-sans); color: color-mix(in srgb, var(--green-950) 88%, transparent); overflow-wrap: anywhere; }
  .prose :global(p) { margin: 0 0 1.75rem; }
  .prose :global(h2) { margin: 3rem 0 1rem; font: 600 2rem/1.2 var(--font-display); color: var(--green-950); }
  .prose :global(:not(pre) > code) { font: 500 .9em/1.65 var(--font-mono); color: var(--green-700); }
  .prose :global(pre) { margin: 0 0 1.75rem; padding: 1.25rem; overflow-x: auto; border-radius: .75rem; font: 400 .75rem/1.6 var(--font-mono); }
  .prose :global(.code-block) { overflow: hidden; margin-bottom: 1.75rem; border-radius: .75rem; background: var(--green-950); }
  .prose :global(.code-block pre) { margin: 0; border-radius: 0; }
  .prose :global(.code-bar) { display: flex; justify-content: space-between; gap: 1rem; padding: .625rem 1.25rem; background: var(--green-900); color: var(--cream); font: 400 .75rem/1.4 var(--font-mono); }
  .prose :global(.code-bar button) { color: var(--green-200); background: transparent; border: 0; cursor: pointer; font: 500 .75rem/1.4 var(--font-mono); }
  .prose :global(.copy-status) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .contents h2, .more h2 { margin: 0 0 1rem; text-transform: uppercase; color: var(--green-700); font: 500 .75rem/1.3 var(--font-mono); }
  .contents ul, .more ul { padding: 0; margin: 0; list-style: none; }
  .contents li + li { margin-top: .875rem; }
  .contents a { color: var(--green-900); font: 400 .9375rem/1.4 var(--font-sans); text-decoration: none; }
  .contents[data-tracking] li a { position: relative; display: inline-block; padding-left: 1rem; color: color-mix(in srgb, var(--green-900) 75%, transparent); }
  .contents[data-tracking] li a[aria-current='location'] { color: var(--green-950); font-weight: 500; }
  .contents[data-tracking] li a[aria-current='location']::before { content: ''; position: absolute; left: 0; top: .45em; width: .4rem; height: .4rem; border-radius: 50%; background: currentColor; }
  .contents a:hover { text-decoration: underline; }
  .contents .canonical { display: inline-flex; align-items: center; gap: .25rem; margin-top: 1.75rem; color: var(--green-700); font-weight: 500; }
  .article-end { border-top: 1px solid color-mix(in srgb, var(--green-950) 20%, transparent); padding-top: 1.5rem; }
  .updated { margin: 0 0 1.5rem; color: var(--green-700); font: 400 .75rem/1.5 var(--font-mono); }
  .author { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; padding: 1.5rem; background: var(--card); border: 1px solid color-mix(in srgb, var(--green-950) 12%, transparent); border-radius: 1rem; }
  .avatar { width: 3.5rem; height: 3.5rem; flex: none; border-radius: 50%; object-fit: cover; background: var(--green-200); }
  .author > div { flex: 1; min-width: 12rem; } .author p { margin: 0; } .author-name { font: 500 1.0625rem/1.4 var(--font-sans); } .author-role { margin-top: .25rem !important; font: 400 .9375rem/1.5 var(--font-sans); color: var(--green-900); }
  .author-link { padding: .75rem 1.25rem; border-radius: 999px; background: var(--green-950); color: var(--white); text-decoration: none; font: 500 .9375rem/1.3 var(--font-sans); }
  .more { margin-top: 1.5rem; }
  @media (min-width: 48rem) { .article-layout { padding-block: 6rem; } }
  @media (min-width: 64.0625rem) { .article-layout { display: grid; grid-template-columns: minmax(0, 680px) 240px; justify-content: center; gap: 6rem; padding-block: 7.5rem; } .contents { grid-column: 2; grid-row: 1; position: sticky; top: 6rem; align-self: start; } .article { grid-column: 1; grid-row: 1; } }
  @media (max-width: 47.999rem) { .prose :global(h2) { margin: 2.5rem 0 .75rem; } .updated span:first-child { display: block; } .author-link { width: 100%; text-align: center; } }
</style>
