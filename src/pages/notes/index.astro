---
import Base from '../../layouts/Base.astro';
import { collectionPath, entryPath, listPosts } from '../../lib/content';
import { buildSeo } from '../../lib/seo';
import { getDictionary } from '../../lib/i18n';

const lang = 'en' as const;
const t = getDictionary(lang);

const site = Astro.site;
if (!site) {
  throw new Error(
    'astro.config.mjs must define `site` before this page can compute canonical URLs.'
  );
}

const posts = await listPosts({ lang });

const seo = buildSeo({
  title: t.nav.notes,
  description: 'Posts about building and shipping this site.',
  path: collectionPath('posts', lang),
  lang,
  site,
});
---

<Base lang={lang} seo={seo}>
  <h1>{t.nav.notes}</h1>
  <ul>
    {posts.map(({ entry, readingTime }) => (
      <li>
        <a href={entryPath('posts', lang, entry.id)}>{entry.data.title}</a>
        <p>{entry.data.description} — {t.post.readingTime(readingTime)}</p>
      </li>
    ))}
  </ul>
</Base>
