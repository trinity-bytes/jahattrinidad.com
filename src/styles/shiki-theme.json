{
  "name": "portfolio-brand",
  "type": "dark",
  "colors": {
    "editor.background": "#0A200B",
    "editor.foreground": "#FAF6E8"
  },
  "tokenColors": [
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#FAF6E8"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#F6D653"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#88E88C"
      }
    },
    {
      "scope": [
        "string",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#61D56A"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#FBEBA0"
      }
    },
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#7FA882",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "punctuation",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#B3F3B4"
      }
    },
    {
      "scope": [
        "comment punctuation"
      ],
      "settings": {
        "foreground": "#7FA882",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string punctuation"
      ],
      "settings": {
        "foreground": "#61D56A"
      }
    }
  ]
}
