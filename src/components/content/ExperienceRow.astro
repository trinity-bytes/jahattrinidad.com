---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Annotation from '../ui/Annotation.astro';

interface Props {
  /** Already formatted, e.g. "Mar–Dec 2023". */
  period: string;
  role: string;
  organisation: string;
  description: string;
  tags: string[];
  image?: ImageMetadata;
  imageAlt?: string;
  /** Inside: an annotation on the chip whose text is `tag`. `n` is its number in the section's list. */
  toolNote?: { n: number; tag: string; title: string; note: string };
}

const { period, role, organisation, description, tags, image, imageAlt = '', toolNote } = Astro.props;
---
<li class="row">
  <p class="period" data-background-text>{period}</p>
  <div class="body">
    <h4 class="heading" data-background-text><span class="role">{role}</span> <span class="organisation">{organisation}</span></h4>
    <p class="description" data-background-text>{description}</p>
    {image && <div class="photo"><Image src={image} alt={imageAlt} width={640} height={400} widths={[320, 640, 960]} sizes="(min-width: 48rem) 320px, 100vw" /></div>}
    {tags.length > 0 && <ul class="tags">{tags.map((tag) => (
      <li data-background-text>
        {tag}
        {toolNote?.tag === tag && (
          <Annotation
            n={toolNote.n}
            x="calc(100% + 5px)"
            y="50%"
            pinX="calc(100% + 5px)"
            pinY="-5px"
            title={toolNote.title}
            note={toolNote.note}
            bound={{ x: '-5px', y: '-5px', width: 'calc(100% + 10px)', height: 'calc(100% + 10px)' }}
          />
        )}
      </li>
    ))}</ul>}
  </div>
</li>
<style>
  /* Home / Experience row 2538:103 and Home / Chip 2538:75. */
  .row { display: grid; grid-template-columns: 1fr; gap: var(--space-xs); padding-block: var(--space-xl); border-top: 1px solid var(--color-border); }
  .period { margin: 0; font: var(--type-meta); letter-spacing: 0.02em; color: var(--color-text-muted); }
  .body { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-xs); min-width: 0; }
  .heading { display: flex; flex-direction: column; gap: var(--space-2xs); margin: 0; font-weight: 400; }
  .role { font: 500 var(--font-size-body)/1.5 var(--font-sans); color: var(--color-heading); }
  .organisation { font: 400 var(--font-size-small)/1.5 var(--font-sans); color: var(--color-text); }
  .description { margin: 0; font: 400 var(--font-size-small)/1.5 var(--font-sans); color: var(--color-text); }
  .photo { width: 100%; aspect-ratio: 35 / 24; overflow: hidden; border-radius: var(--radius-md); }
  .photo :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .tags { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin: 0; padding: var(--space-2xs) 0 0; list-style: none; }
  .tags li { position: relative; padding: var(--space-2xs) var(--space-sm); border: 1px solid var(--color-chip-border); border-radius: var(--radius-full); font: var(--type-meta); letter-spacing: 0.02em; color: var(--color-chip-text); }
  @media (min-width: 48rem) {
    .row { grid-template-columns: 7rem 1fr; gap: var(--space-2xl-b); }
    .heading { flex-direction: row; flex-wrap: wrap; align-items: baseline; gap: 0 var(--space-xs); }
    .organisation::before { content: '·'; margin-right: 0.3em; }
    .photo { width: 20rem; aspect-ratio: 8 / 5; }
  }
</style>
