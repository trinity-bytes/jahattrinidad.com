---
interface Props {
  href: string;
  title: string;
  /** Localized chip text, e.g. "ESSAY". */
  typeLabel: string;
  type: 'essay' | 'tutorial';
  /** Reading time, and the date when featured; already formatted. */
  meta: string;
  /** The featured post is a card with its description. */
  featured?: boolean;
  description?: string;
}

const { href, title, typeLabel, type, meta, featured = false, description } = Astro.props;
---
<a class:list={['post', { featured }]} href={href}>
  <span class={`chip ${type}`} data-background-text>{typeLabel}</span>
  <span class="title" data-background-text>{title}</span>
  {featured && description && <span class="description" data-background-text>{description}</span>}
  <span class="meta" data-background-text>{meta}{featured && <span class="arrow" aria-hidden="true">&nbsp; →</span>}</span>
</a>
<style>
  .post { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-xs); padding-block: var(--space-lg); border-top: 1px solid var(--color-heading); color: var(--color-heading); text-decoration: none; }
  .chip { padding: 0.1875rem var(--space-xs); border-radius: 999px; font: 500 var(--font-size-label)/1.33 var(--font-mono); color: var(--color-heading); }
  .essay { background: var(--green-200); }
  .tutorial { background: var(--sun-soft); }
  .title { font: 400 1.125rem/1.4 var(--font-sans); }
  .meta { font: 400 var(--font-size-label)/1.33 var(--font-mono); color: var(--color-text-muted); }
  .post:hover .title, .post:focus-visible .title { text-decoration: underline; }
  .featured { gap: var(--space-md); padding: var(--space-xl); border: 0; border-radius: var(--space-md); background: var(--color-card); }
  .featured .title { font: 600 var(--font-size-heading-sm)/1.12 var(--font-display); letter-spacing: -0.015em; }
  .featured .description { font: 400 var(--font-size-body)/1.5 var(--font-sans); color: var(--color-text); }
  .featured .meta { font-size: 0.8125rem; }
  @media (min-width: 48rem) {
    .post { display: grid; grid-template-columns: 6rem 1fr auto; align-items: center; gap: var(--space-xl); }
    .chip { justify-self: start; }
    .featured { display: flex; align-items: flex-start; padding: 2.25rem 2rem; }
  }
  @media (min-width: 64.0625rem) {
    .featured { padding-inline: var(--space-2xl); }
  }
</style>
