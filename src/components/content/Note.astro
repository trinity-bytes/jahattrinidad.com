---
import type { Locale } from '../../lib/i18n';
import { getDictionary } from '../../lib/i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
---
<aside class="note"><span>{getDictionary(lang).post.note}</span><slot /></aside>
<style>
  .note { padding: var(--space-lg) var(--space-xl); border-radius: var(--radius-md); background: var(--green-50); font: 400 1.0625rem/1.55 var(--font-sans); }
  span { display: block; margin-bottom: var(--space-xs); color: var(--color-text-muted); font: var(--type-meta); letter-spacing: var(--type-meta-tracking); text-transform: uppercase; }
  .note :global(p) { margin: 0; }
</style>
