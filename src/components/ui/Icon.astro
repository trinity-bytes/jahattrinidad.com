type IconName = 'search' | 'menu' | 'x' | 'arrow-up-right' | 'message-circle' | 'copy' | 'send';
interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}
const { name, size = 24, label, class: className } = Astro.props;
---
