---
/*
 * Annotation: the Inside device. It points at one real thing on the page and says how it is
 * built. Only visible in the Inside lens (it carries data-show="inside", which the app
 * shell's rule in Base.astro applies; that also keeps it out of the accessibility tree Outside).
 *
 * Two forms, swapped at 64.0625rem:
 *   - Desktop: a 6px pin, a leader line and a two-line mono label (title, note) on one of
 *     four sides of the pin. The label sits in free space and never covers copy.
 *   - Tablet and mobile: only a numbered 14px pin. The text moves to an AnnotationList
 *     (annotation/AnnotationList.astro) that closes the section; `n` links the two.
 *
 * It positions itself against the nearest positioned ancestor (the section: give it
 * `position: relative`). x, y, pinX, pinY, leader and bound take any CSS length: a number
 * means px, a string is used as is ('calc(100cqw - 540px)', 'var(--sun-x)').
 *
 * Props
 *   n        1-based position in the section's list. Numbering restarts in every section.
 *   x, y     desktop pin centre.
 *   side     where the label goes: 'right' (default), 'left', 'above', 'below'.
 *   title    first label line, e.g. '[layer 01 · sky + far hills]'.
 *   note     second label line, e.g. 'bg-back.png · moves slowest'.
 *   leader   leader length (default 32).
 *   pinX, pinY  small-screen pin centre (defaults to x, y). Put it on the dashed bound.
 *   bound    optional dashed box { x, y, width, height } of the annotated element, drawn
 *            at every width. The desktop pin sits on its edge.
 *
 * Accessibility: the pin, leader and bound are decorative (aria-hidden). The label is real
 * text, not hidden: the note holds facts a sighted Inside reader gets (file names, sizes),
 * so a screen-reader user in the Inside lens reads them too. Below 64.0625rem the label is
 * display:none and the same text is read from the AnnotationList, so it is never read twice.
 *
 * Usage:
 *   <section style="position: relative">
 *     <Annotation n={1} x={483} y={537} side="above" title="[layer 01]" note="bg.png · moves slowest"
 *       pinX={100} pinY={471}
 *       bound={{ x: 64, y: 552, width: 807, height: 276 }} />
 *   </section>
 *   <AnnotationList items={notes} label="Layer notes" />
 */
import NumberPin from './annotation/NumberPin.astro';

type Length = string | number;
interface Props {
  n: number;
  x: Length;
  y: Length;
  side?: 'right' | 'left' | 'above' | 'below';
  title: string;
  note: string;
  leader?: Length;
  pinX?: Length;
  pinY?: Length;
  bound?: { x: Length; y: Length; width: Length; height: Length };
}
const { n, x, y, side = 'right', title, note, leader = 32, pinX = x, pinY = y, bound } = Astro.props;

const len = (value: Length) => (typeof value === 'number' ? `${value}px` : value);
const vars: Record<string, string> = {
  '--x': len(x),
  '--y': len(y),
  '--leader': len(leader),
  '--pin-x': len(pinX),
  '--pin-y': len(pinY),
};
if (bound) {
  vars['--bound-x'] = len(bound.x);
  vars['--bound-y'] = len(bound.y);
  vars['--bound-w'] = len(bound.width);
  vars['--bound-h'] = len(bound.height);
}
const style = Object.entries(vars).map(([name, value]) => `${name}: ${value}`).join('; ');
---

<div class="annotation" data-show="inside" data-side={side} style={style}>
  {bound && <div class="bound" aria-hidden="true"></div>}
  <div class="full">
    <span class="dot" aria-hidden="true"></span>
    <span class="leader" aria-hidden="true"></span>
    <p class="label"><span class="title">{title}</span><span class="note">{note}</span></p>
  </div>
  <span class="small-pin"><NumberPin n={n} /></span>
</div>

<style>
  .annotation { position: absolute; inset: 0; pointer-events: none; }

  .bound {
    position: absolute;
    box-sizing: border-box;
    left: var(--bound-x);
    top: var(--bound-y);
    width: var(--bound-w);
    height: var(--bound-h);
    border: 1px dashed var(--annotation-bound);
  }

  /* Small screens: only the numbered pin, centred on its point. */
  .small-pin { position: absolute; left: var(--pin-x); top: var(--pin-y); display: grid; transform: translate(-50%, -50%); }

  /* Desktop: a zero-size anchor at the pin centre; the parts are placed around it. */
  .full { display: none; position: absolute; left: var(--x); top: var(--y); width: 0; height: 0; }
  .dot { position: absolute; left: -3px; top: -3px; width: 6px; height: 6px; border-radius: 50%; background: var(--annotation-pin); }
  .leader { position: absolute; background: var(--annotation-leader); }
  .label {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    font: 400 var(--font-size-label) / normal var(--font-mono), monospace;
    white-space: nowrap;
  }
  .title { color: var(--annotation-title); }
  .note { color: var(--annotation-note); }

  /* The leader starts at the pin's edge (3px from its centre); the label follows it. */
  [data-side='right'] .leader { left: 3px; top: 0; width: var(--leader); height: 1px; }
  [data-side='right'] .label { left: calc(3px + var(--leader) + 8px); top: 0; transform: translateY(-50%); }
  [data-side='left'] .leader { right: 3px; top: 0; width: var(--leader); height: 1px; }
  [data-side='left'] .label { right: calc(3px + var(--leader) + 8px); top: 0; transform: translateY(-50%); align-items: flex-end; text-align: right; }
  [data-side='above'] .leader { left: 0; bottom: 3px; width: 1px; height: var(--leader); }
  [data-side='above'] .label { left: -6px; bottom: calc(3px + var(--leader)); }
  [data-side='below'] .leader { left: 0; top: 3px; width: 1px; height: var(--leader); }
  [data-side='below'] .label { left: -6px; top: calc(3px + var(--leader) + 8px); }

  @media (min-width: 64.0625rem) {
    .full { display: block; }
    .small-pin { display: none; }
  }
</style>
