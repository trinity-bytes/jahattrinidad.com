---
/**
 * Renders text so a hyphenated word ("zero-dependency") never breaks at its hyphen.
 * Markup does it because U+2011 (non-breaking hyphen) is missing from many fonts.
 */
interface Props { text: string }
const parts = Astro.props.text.split(/(\S+-\S+)/);
---
{parts.map((part, index) => (index % 2 ? <span class="keep">{part}</span> : part))}

<style>
  .keep { white-space: nowrap; }
</style>
