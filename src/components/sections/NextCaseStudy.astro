---
import type { CollectionEntry } from 'astro:content';
import type { Dictionary } from '../../lib/i18n';
import ProjectCard from '../content/ProjectCard.astro';
import Backgrounds from './Backgrounds.astro';
interface Props { project: CollectionEntry<'projects'>; href: string; allWorkHref: string; strings: Dictionary; /** Defaults to "Next case study"; project pages pass "Next project". */ marker?: string }
const { project, href, allWorkHref, strings: t, marker = t.caseStudy.nextCaseStudy } = Astro.props;
---
<section class="next"><Backgrounds variant="values" next="none" /><div class="container content"><header><div><p class="marker">{marker}</p><h2>{project.data.title}</h2></div><a href={allWorkHref}><span aria-hidden="true">← </span>{t.caseStudy.allWork}</a></header><ProjectCard project={project.data} href={href} meta={project.data.kind} problem={project.data.problem} whatItDoes={project.data.whatItDoes} labels={{...t.common, seeProject:t.work.seeProject}} insideLabels={t.home.inside.work.rowLabels} featured optimized /></div></section>
<style>
  .next {
    position: relative;
    padding: 7.5rem 0;
    background: var(--cream);
  }
  .content {
    position: relative;
  }
  header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    margin-bottom: 3rem;
  }
  .marker {
    font: 500 13px var(--font-mono);
    color: var(--green-700);
  }
  h2 {
    font: 600 var(--font-size-heading-lg)/1.1 var(--font-display);
    margin: 12px 0 0;
  }
</style>
