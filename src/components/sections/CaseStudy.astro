---
import { Image } from 'astro:assets';
import { Code } from 'astro:components';
import theme from '../../styles/shiki-theme.json';
import type { CollectionEntry } from 'astro:content';
import type { Dictionary } from '../../lib/i18n';
import Backgrounds from './Backgrounds.astro';
type Data = NonNullable<CollectionEntry<'projects'>['data']['caseStudy']>;
interface Props { decisions: CollectionEntry<'projects'>['data']['decisions']; data: Data; cover?: ImageMetadata; coverAlt?: string; website?: string; strings: Dictionary['caseStudy'] }
const { data, decisions, cover, coverAlt = '', website, strings: t } = Astro.props;
---
<article class="case-study">
  <section class="overview band">
    <Backgrounds variant="work" next="none" />
    <div class="container inner">
      {cover && <div class="browser"><div class="browser-bar"><i></i><i></i><i></i>{website && <span>{new URL(website).hostname}</span>}</div><Image src={cover} alt={coverAlt} /></div>}
      <p class="marker" data-background-text>{t.atAGlance}</p>
      <dl class="glance">{data.glance.map(f => <div><dt data-background-text>{f.label}</dt><dd data-background-text>{f.value}</dd></div>)}</dl>
    </div>
  </section>
  <section class="problem band pale"><Backgrounds variant="experience" next="none" /><div class="container inner split">
    <div><p class="marker" data-background-text>{t.problemMarker}</p><h2 data-background-text>{data.headlines.problem}</h2></div>
    <div>{data.problem.map(p => <p data-background-text>{p}</p>)}<dl class="facts"><div><dt data-background-text>{t.requirements}</dt><dd data-background-text>{data.requirements}</dd></div><div><dt data-background-text>{t.constraint}</dt><dd data-background-text>{data.constraint}</dd></div></dl></div>
  </div></section>
  <section class="features band"><Backgrounds variant="work" next="none" /><div class="container inner">
    <p class="marker" data-background-text>{t.featuresMarker}</p><h2 data-background-text>{data.headlines.features}</h2>
    {data.features.map((f) => <div class="feature">{f.image ? <div class:list={['feature-image', { phone: f.imagePresentation === 'phone' }]}><Image src={f.image} alt={f.imageAlt ?? ''} /></div> : <div class="terminal">{f.terminal && <Code code={f.terminal} lang="bash" theme={{ ...theme, type: "dark" }} />}{f.note && <small>{f.note}</small>}</div>}<div><h3 data-background-text>{f.title}</h3><p data-background-text>{f.description}</p><dl class="facts"><div><dt data-background-text>{t.underTheHood}</dt><dd data-background-text>{f.detail}</dd></div></dl></div></div>)}
  </div></section>
  <section class="decisions band pale"><Backgrounds variant="experience" next="none" /><div class="container inner"><p class="marker" data-background-text>{t.decisionsMarker}</p><h2 data-background-text>{data.headlines.decisions}</h2><div class="table-head"><span>{t.choice}</span><span>{t.why}</span><span>{t.cost}</span></div>{decisions.map(d => <div class="decision"><div><span class="stack-label">{t.choice}</span><h3 data-background-text>{d.choice}</h3><small>{d.subtitle}</small></div><div><span class="stack-label">{t.why}</span><p data-background-text>{d.because}</p></div><div><span class="stack-label">{t.cost}</span><p data-background-text>{d.cost}</p></div></div>)}</div></section>
  <section class="mistakes band"><Backgrounds variant="work" next="none" /><div class="container inner"><p class="marker" data-background-text>{t.mistakesMarker}</p><h2 data-background-text>{data.headlines.mistakes}</h2><div class="prose" data-background-text><slot /></div></div></section>
  <section class="growth band pale"><Backgrounds variant="experience" next="none" /><div class="container inner"><p class="marker" data-background-text>{t.growthMarker}</p><h2 data-background-text>{data.headlines.growth}</h2><div class="timeline">{data.milestones.map(m => <div><p class="marker" data-background-text>{m.day}</p><h3 data-background-text>{m.title}</h3><p data-background-text>{m.description}</p></div>)}</div>{data.proof && <div class="proof"><strong>{data.proof.title}</strong><p>{data.proof.text}</p></div>}{data.closing && <div class="closing">{data.closing.map(c => <div><h3 data-background-text>{c.title}</h3><p data-background-text>{c.text}</p></div>)}</div>}</div></section>
</article>
<style>
  .pale :global(.warm .light) {
    background: radial-gradient(
      ellipse at 78% 0%,
      color-mix(in srgb, var(--sun-soft) 15%, transparent),
      transparent 65%
    );
  }
  .band {
    position: relative;
    background: var(--cream);
    padding: 7.5rem 0;
  }
  .pale {
    background: var(--card);
  }
  .inner {
    position: relative;
  }
  .overview {
    padding-top: 0;
  }
  /* Contain the negative margin so the section background never covers the hero. */
  .overview .inner {
    display: flow-root;
  }
  .overview {
    padding-bottom: 11.375rem;
  }
  .browser {
    position: relative;
    max-width: 72rem;
    container-type: inline-size;
    margin: -4rem auto 7.5rem;
    overflow: hidden;
    border-radius: 1rem;
    background: var(--card);
    box-shadow: 0 24px 64px color-mix(in srgb, var(--green-950) 18%, transparent);
  }
  .browser img,
  .feature img {
    display: block;
    width: 100%;
    height: auto;
  }
  .browser-bar {
    height: clamp(12px, 3.472cqw, 40px);
    display: flex;
    align-items: center;
    gap: clamp(2px, 0.694cqw, 8px);
    padding: 0 clamp(6px, 1.736cqw, 20px);
    color: var(--green-700);
    font: clamp(4px, 1.042cqw, 12px) var(--font-mono);
  }
  .browser-bar i {
    width: clamp(3px, 0.868cqw, 10px);
    height: clamp(3px, 0.868cqw, 10px);
    border-radius: 50%;
    background: var(--green-300);
  }
  .browser-bar span {
    margin: auto;
  }
  .marker,
  dt,
  small {
    font: 500 13px/1.5 var(--font-mono);
    color: var(--green-700);
  }
  .marker {
    margin: 0;
    line-height: 1;
  }
  h2 {
    max-width: 820px;
    font: 600 var(--font-size-heading-section)/1.1 var(--font-display);
    letter-spacing: -0.02em;
    margin: 1.25rem 0 4rem;
  }
  h3 {
    font: 600 var(--font-size-heading-sm)/1.12 var(--font-display);
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }
  p {
    line-height: 1.5;
  }
  dl,
  dd {
    margin: 0;
  }
  .glance {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-top: 40px;
  }
  .glance > div {
    border-top: 1px solid var(--green-950);
    padding: 16px 24px 0 0;
  }
  .glance dd {
    font-size: 20px;
  }
  .problem h2 {
    max-width: 560px;
    margin-bottom: 0;
  }
  .features h2,
  .mistakes h2 {
    max-width: 760px;
  }
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }
  .split > div:last-child {
    max-width: 600px;
    padding-top: 36px;
  }
  .split > div:last-child > p:first-child {
    margin-top: 0;
  }
  .problem {
    padding-bottom: 10rem;
  }
  .facts > div {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 24px;
    border-top: 1px solid var(--color-border);
    padding: 16px 0;
  }
  .features {
    padding-bottom: 10rem;
  }
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 760fr) minmax(0, 472fr);
    gap: 5rem;
    align-items: center;
    border-top: 1px solid var(--color-border);
    padding: 3rem 0;
  }
  .feature-image {
    aspect-ratio: 760 / 475;
    min-width: 0;
  }
  .feature-image:not(.phone) {
    overflow: hidden;
    border-radius: 12px;
    box-shadow: 0 16px 40px color-mix(in srgb, var(--green-950) 14%, transparent);
  }
  .feature-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .feature-image.phone {
    display: flex;
    justify-content: center;
  }
  .feature-image.phone img {
    width: auto;
    max-width: 100%;
    border-radius: 24px;
    box-shadow: 0 20px 40px color-mix(in srgb, var(--green-950) 22%, transparent);
  }
  .feature h3 {
    font: 600 2rem/1.15 var(--font-display);
    letter-spacing: -0.02em;
  }
  .terminal {
    min-height: 475px;
    background: var(--green-950);
    color: var(--cream);
    padding: 2rem;
    border-radius: 1rem;
  }
  .terminal :global(pre) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font: 13px/1.7 var(--font-mono);
  }
  .terminal small {
    color: var(--green-300);
  }
  .table-head,
  .decision {
    display: grid;
    grid-template-columns: 1.05fr 1fr 1fr;
    gap: 2rem;
  }
  .table-head {
    font: 500 13px var(--font-mono);
    color: var(--green-700);
  }
  .decision {
    border-top: 1px solid var(--color-border);
    padding: 28px 0;
  }
  .decision h3 {
    font-size: 26px;
  }
  .stack-label {
    display: none;
    font: 500 12px/1.5 var(--font-mono);
    color: var(--green-700);
    margin-bottom: 10px;
  }
  .decision p {
    margin: 0;
  }
  .prose :global(h3) {
    margin-top: 4rem;
    font: 600 1.75rem/1.2 var(--font-display);
    letter-spacing: -0.02em;
  }
  .prose :global(p) {
    max-width: 45rem;
    line-height: 1.55;
  }
  .prose :global(.eras ~ h3) {
    border-top: 1px solid var(--color-border);
    padding-top: 4rem;
  }
  .prose :global(.code-pair) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .prose :global(.code-pair figure) {
    position: relative;
    width: 100%;
  }
  .prose :global(.code-annotation) {
    position: absolute;
    top: calc(2rem + 7 * 1.7 * 13px + 15px);
    right: 2rem;
    color: var(--sun);
    font: 13px/1.7 var(--font-mono);
  }
  .prose :global(pre) {
    display: block;
    width: 100%;
    padding: 2rem;
    border-radius: 1rem;
    overflow: auto;
    font: 13px/1.7 var(--font-mono);
  }
  .prose :global(.eras) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin: 70px 0 24px;
  }
  .prose :global(figure) {
    margin: 0;
  }
  .prose :global(.era) {
    position: relative;
    height: 300px;
    border-radius: 16px;
    padding: 48px 32px;
    overflow: hidden;
  }
  .prose :global(.era-sky) {
    background: linear-gradient(
      var(--garden-era-sky-start),
      var(--garden-era-light)
    );
  }
  .prose :global(.era-solid) {
    background: var(--garden-era-dark);
  }
  .prose :global(.era-dark) {
    background: var(--garden-era-dark);
  }
  .prose :global(.era-image) {
    position: absolute;
    object-fit: cover;
  }
  .prose :global(.era-image-one) {
    width: 180px;
    height: 120px;
    left: 196px;
    top: 40px;
  }
  .prose :global(.era-image-two) {
    width: 180px;
    height: 120px;
    left: 236px;
    top: 176px;
  }
  .prose :global(.era-image-bg) {
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .prose :global(.filter) {
    position: relative;
    max-width: 268px;
    padding: 20px;
    border-radius: 14px;
    background: color-mix(in srgb, white 75%, transparent);
    font: 12px var(--font-sans);
    box-shadow: 0 8px 30px #0002;
  }
  .prose :global(.filter p) {
    font: 10px var(--font-mono);
    margin: 14px 0 8px;
  }
  .prose :global(.era-solid .filter) {
    background: var(--garden-era-light);
    color: var(--garden-era-ink);
    border: 3px solid var(--garden-era-ink);
    box-shadow: 4px 4px var(--garden-era-ink);
  }
  .prose :global(.era-dark .filter) {
    background: color-mix(in srgb, var(--garden-era-dark) 75%, transparent);
    backdrop-filter: blur(12px);
    color: var(--garden-era-light);
  }
  .prose :global(figcaption) {
    font: 12px/1.8 var(--font-mono);
    margin-top: 12px;
  }
  .closing {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    margin-top: 4rem;
    border-top: 1px solid var(--color-border);
    padding-top: 2rem;
  }
  .closing h3 {
    font: 500 13px var(--font-mono);
  }
  .timeline {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: 1px solid var(--color-rule);
    margin-top: 4rem;
  }
  .timeline > div {
    position: relative;
    padding: 28px 32px 0 0;
  }
  .timeline p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
  }
  .timeline .marker {
    font-size: 13px;
    line-height: 1.3;
  }
  .timeline > div:before {
    content: "";
    position: absolute;
    top: -6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--card);
    border: 1px solid var(--green-700);
  }
  .timeline > div:last-child:before {
    background: var(--sun);
    border-color: var(--sun);
  }
  .timeline h3 {
    font-size: 26px;
    line-height: 1.18;
    margin: 14px 0;
  }
  .proof {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 4rem;
  }
  .proof::before {
    content: "";
    flex: 0 0 10px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--sun);
  }
  .proof strong {
    white-space: nowrap;
    color: var(--green-700);
    font: 500 34px var(--font-display);
  }
  .proof p {
    max-width: 40rem;
  }
  @media (max-width: 1024px) {
    .band {
      padding: 5rem 0;
    }
    .overview {
      padding-top: 0;
      padding-bottom: 6.5rem;
    }
    .browser {
      margin-bottom: 4rem;
    }
    .problem {
      padding-bottom: 5rem;
    }
    .split > div:last-child {
      max-width: none;
      padding-top: 0;
    }
    .glance {
      grid-template-columns: repeat(2, 1fr);
    }
    .closing,
    .split,
    .feature,
    .decision {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .features {
      padding-bottom: 5rem;
    }
    .feature {
      gap: 24px;
      padding: 2rem 0;
    }
    .feature h3 {
      font-size: 1.875rem;
    }
    .terminal {
      min-height: 430px;
    }
    .table-head {
      display: none;
    }
    .stack-label {
      display: block;
    }
    .prose :global(.eras) {
      margin-top: 48px;
    }
    .prose :global(.eras),
    .prose :global(.code-pair) {
      grid-template-columns: 1fr;
    }
    .prose :global(figure) {
      width: min(100%, 416px);
      margin: auto;
    }
    .timeline {
      display: block;
      border: 0;
      margin-top: 3rem;
    }
    .timeline > div {
      padding: 28px 0 0 28px;
      margin-bottom: 20px;
    }
    .timeline > div:last-child {
      margin-bottom: 0;
    }
    .timeline > div:before {
      top: 29px;
      left: 0;
    }
    .timeline > div:not(:last-child):after {
      content: "";
      position: absolute;
      top: 35px;
      bottom: -55px;
      left: 5px;
      width: 1px;
      background: var(--color-rule);
    }
    .timeline h3 {
      font-size: 24px;
    }
    .closing {
      gap: 20px;
    }
    h2 {
      margin-bottom: 3rem;
    }
    .problem h2 {
      margin-bottom: 0;
    }
    .prose :global(pre) {
      display: block;
      width: 100%;
    }
    .prose :global(.code-pair figure:first-child pre) {
      padding-bottom: calc(2rem + 1.7 * 13px);
    }
    .prose :global(.code-annotation) {
      top: calc(2rem + 8 * 1.7 * 13px + 15px);
      left: 2rem;
      right: auto;
    }
  }
  @media (max-width: 767px) {
    .band {
      padding: 5rem 0;
    }
    .overview {
      padding-top: 0;
      padding-bottom: 6.5rem;
    }
    .browser {
      margin: -4rem auto 4rem;
    }
    .glance {
      grid-template-columns: 1fr;
    }
    .feature h3 {
      font-size: 1.625rem;
    }
    .timeline h3 {
      font-size: 22px;
    }
    .prose :global(h3) {
      font-size: 1.625rem;
    }
    .facts > div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .proof {
      display: grid;
      grid-template-columns: 10px 1fr;
      column-gap: 16px;
    }
    .proof p {
      grid-column: 1 / -1;
    }
    .terminal {
      min-height: 396px;
      padding: 1.25rem;
    }
    .terminal :global(pre) {
      font: 12px/18px var(--font-mono);
    }
  }
</style>
