---
import { getImage } from 'astro:assets';
import hill from '../../assets/hero/near-hill.png';
import blueHour from '../../assets/footer/blue-hour.png';
import type { Dictionary } from '../../lib/i18n';
import Icon from '../ui/Icon.astro';

type Link = { label: string; href: string };
interface Props {
  strings: Dictionary['footer'];
  navigation: Link[];
  elsewhere: Link[];
  source: Link;
  /** Screen-reader note for the links that leave the site (Elsewhere and the source code). */
  newTab: string;
  copyright: string;
  outsideName: string;
  insideName: string;
  showShortcut?: boolean;
  /** Case study / Notes / Post boards: on desktop the columns start at 67px instead of 200px (board 2298:1304, 561px tall). */
  compact?: boolean;
}
const { strings, navigation, elsewhere, source, newTab, copyright, outsideName, insideName, showShortcut = true, compact = false } = Astro.props;
// The page walks through the day: sunset in the hero, golden hour in Contact, blue hour in the closing name.
const fill = await getImage({ src: blueHour, format: 'webp' });
---
<footer class:list={['footer', { compact }]}>
  <div class="hill" aria-hidden="true">
    <img src={hill.src} alt="" />
    <div class="fade"></div>
  </div>
  <div class="content">
    <p class="availability">{strings.availability}</p>
    <div class="columns">
      <div class="column">
        <h2>{strings.navigate}</h2>
        <ul>{navigation.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
      </div>
      <div class="column">
        <h2>{strings.elsewhere}</h2>
        <ul>{elsewhere.map((link) => <li><a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}<Icon name="arrow-up-right" sizing="inline" /><span class="visually-hidden"> {newTab}</span></a></li>)}</ul>
      </div>
      <div class="column site">
        <h2>{strings.thisSite}</h2>
        <ul>
          <li><a href={source.href} target="_blank" rel="noopener noreferrer">{source.label}<Icon name="arrow-up-right" sizing="inline" /><span class="visually-hidden"> {newTab}</span></a></li>
          <li class="keys hint" data-show="inside">{strings.insideHint}</li>
          {showShortcut && <li class="keys"><button type="button" data-shortcut-toggle data-turn-off={strings.shortcut} data-turn-on={strings.shortcutOn}>{strings.shortcut}</button></li>}
        </ul>
      </div>
    </div>
    <p class="copyright">{copyright}</p>
    <div class="signature" aria-hidden="true">
      <div class="ghost" data-outside={outsideName} data-inside={insideName} style={`--name-fill: url(${fill.src})`}></div>
    </div>
  </div>
</footer>
<script>
  /*
   * Scroll parallax as the footer comes in: the hill climbs over the contact sky faster than the page, and
   * the closing name rises out of its clipped band, landing as the page ends. Reduced motion: both rest.
   */
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.querySelectorAll<HTMLElement>('.footer:not([data-lens-preview] *)').forEach((footer) => {
    const hill = footer.querySelector<HTMLElement>('.hill');
    const name = footer.querySelector<HTMLElement>('.ghost');
    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
      const timeline = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: footer,
          start: 'top bottom',
          end: () => ScrollTrigger.maxScroll(window),
          scrub: 0.4,
          invalidateOnRefresh: true,
        },
      });
      // The hill starts at rest (its ridge hides the footer's straight top edge) and climbs past it, so it
      // must never move down. The climb stays inside the contact's bottom padding at every breakpoint.
      if (hill) timeline.fromTo(hill, { y: 0 }, { y: () => -Math.min(72, innerHeight * 0.08), duration: 1 }, 0);
      if (name) timeline.fromTo(name, { yPercent: 45 }, { yPercent: 0, duration: 1 }, 0);
    });
  });
  new MutationObserver(() => ScrollTrigger.refresh()).observe(document.documentElement, { attributes: true, attributeFilter: ['data-lens'] });

  const key = 'lens-shortcut-disabled';
  document.querySelectorAll<HTMLButtonElement>('[data-shortcut-toggle]').forEach((button) => {
    let disabled = false;
    try { disabled = localStorage.getItem(key) === 'true'; } catch { /* Storage can be unavailable. */ }
    // A plain button whose label names what it will do; aria-pressed would turn it into a double negative.
    const label = () => { button.textContent = (disabled ? button.dataset.turnOn : button.dataset.turnOff) ?? ''; };
    label();
    button.addEventListener('click', () => {
      disabled = !disabled;
      label();
      try { localStorage.setItem(key, String(disabled)); } catch { /* Keep the current-page setting. */ }
      window.dispatchEvent(new CustomEvent('lens-shortcut-change', { detail: { disabled } }));
    });
  });
</script>
<style>
  .footer { position: relative; background: var(--color-footer); color-scheme: dark; color: var(--color-heading); }
  .hill { position: absolute; z-index: 0; inset: -260px 0 auto; height: 380px; overflow: hidden; pointer-events: none; container-type: inline-size; }
  /* Never narrower than the footer, plus enough to push the PNG's transparent right strip (3.4%) off screen;
     past 1746px the ridge (69% down, ratio 0.7124) stays at the same height. */
  .hill img { position: absolute; width: max(1746.36px, 108cqw); max-width: none; height: auto; aspect-ratio: 1746.36 / 1244.16; left: 50%; top: calc(188.5px - 0.4916 * max(1746.36px, 108cqw)); transform: translateX(-50%); filter: brightness(.38); }
  .fade { position: absolute; inset: auto 0 0; height: 240px; background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--color-footer) 55%, transparent) 45%, color-mix(in srgb, var(--color-footer) 92%, transparent) 80%, var(--color-footer)); }
  .content { position: relative; box-sizing: border-box; max-width: calc(var(--content-max) + 2 * var(--gutter-desktop)); margin-inline: auto; padding: 152px var(--gutter-desktop) 0; }
  .columns { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .availability { position: absolute; top: 152px; right: var(--gutter-desktop); width: calc((100% - 2 * var(--gutter-desktop)) / 4); margin: 0; white-space: pre-line; font: 600 var(--font-size-h5)/1.25 var(--font-display); letter-spacing: -.02em; color: var(--color-heading); }
  h2 { margin: 0 0 var(--space-xs); font: var(--type-meta); letter-spacing: var(--type-meta-tracking); text-transform: uppercase; color: var(--color-text-muted); }
  ul { display: flex; flex-direction: column; align-items: flex-start; list-style: none; padding: 0; margin: 0; }
  /* ListLink 2512:431: rows are --list-row tall (32px desktop, 44px on touch widths). */
  a, button, .hint { display: inline-flex; align-items: center; gap: var(--space-2xs); min-height: var(--list-row); color: var(--color-heading); font: 500 var(--font-size-small)/1.25rem var(--font-sans); text-decoration: none; }
  button { padding: 0; border: 0; background: none; text-align: left; cursor: pointer; }
  @media (hover: hover) and (pointer: fine) { a:hover, button:hover { text-decoration: underline 1px; } }
  /* The keyboard shortcut means nothing on a touch layout (HO-24). */
  @media (max-width: 64rem), (pointer: coarse) {
    .keys { display: none; }
  }
  /*
   * The closing name: sized to span the content width exactly (37.7cqw = 100cqw / "Jahat"'s 2.65em
   * advance), filled with the blue-hour hills, and cut off at the bottom of the page so it reads as running past it.
   * The band's height is the visible part of the letters; the parallax raises them into it.
   */
  .signature { container-type: inline-size; overflow: hidden; margin-top: 56px; }
  .ghost { height: .62em; font: 500 37.7cqw/.86 var(--font-display); letter-spacing: -.04em; white-space: nowrap; color: var(--color-footer-name); }
  .ghost::before { content: attr(data-outside); }
  @supports (background-clip: text) or (-webkit-background-clip: text) {
    .ghost { color: transparent; background: var(--name-fill) center 50% / cover no-repeat; -webkit-background-clip: text; background-clip: text; }
  }
  /* Inside: "@trinitybytes" in mono, its 13 characters (7.02em) spanning the content width the same way. */
  :global([data-lens='inside']) .ghost { height: .74em; font-family: var(--font-mono); font-size: 14.2cqw; letter-spacing: -.06em; }
  :global([data-lens='inside']) .ghost::before { content: attr(data-inside); }
  .copyright { margin: 48px 0 0; font: 400 var(--font-size-caption)/1.4 var(--font-sans); color: var(--color-text); }
  @media (min-width: 64.0625rem) {
    /* Compact desktop footer: the columns start higher (no hill to clear). */
    .compact .content { padding-top: 67px; }
    .compact .availability { top: 67px; }
  }
  @media (max-width: 64rem) {
    .content { padding: 96px var(--gutter-tablet) 0; }
    .availability { position: static; width: auto; margin-bottom: 40px; }
    .columns { grid-template-columns: 29% 29% minmax(0, 1fr); }
  }
  @media (max-width: 47.99rem) {
    .hill { top: -250px; }
    .content { padding: 88px var(--gutter-mobile) 0; }
    .columns { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 30px; }
    .site { grid-column: 1 / -1; }
    .signature { margin-top: 40px; }
  }
  @media (forced-colors: active) { .signature { display: none; } .content { padding-bottom: 25px; } }
</style>
