---
import type { Dictionary } from '../../lib/i18n';
import Backgrounds from './Backgrounds.astro';
import Annotation from '../ui/Annotation.astro';
import AnnotationList from '../ui/annotation/AnnotationList.astro';

interface Props {
  copy: Dictionary['home']['outside']['values'];
  /** The Inside copy: another reading of the same section, shown only in the Inside lens. */
  insideCopy: Dictionary['home']['inside']['values'];
  /** The Garden case study. */
  gardenHref: string;
  gardenImage: { src: string; alt: string };
}

const { copy, insideCopy, gardenHref, gardenImage } = Astro.props;

// The table and the proof card are rendered once per lens; the app shell shows the active one.
const lenses = [
  { show: 'outside', copy },
  { show: 'inside', copy: insideCopy },
] as const;
const notes = [insideCopy.annotations.source];
---

<section class="values" aria-labelledby="values-heading">
  <Backgrounds variant="values" next="surface" seed={2} />
  <div class="container content">
    <header>
      <p class="marker" data-background-text data-reveal="text">
        <span data-show="outside">{copy.marker}</span><span data-show="inside">{insideCopy.marker}</span>
      </p>
      <h2 id="values-heading" data-background-text data-reveal="text">
        <span data-show="outside">{copy.headline}</span><span data-show="inside">{insideCopy.headline}</span>
      </h2>
      <p class="sub" data-show="outside" data-background-text data-reveal="text">{copy.sub}</p>
      <div class="sub sub-frame" data-show="inside" data-reveal>
        <p data-background-text>{insideCopy.sub}</p>
        <Annotation
          n={1}
          x="calc(100% + 8px)"
          y="50%"
          pinX="-8px"
          pinY="-8px"
          bound={{ x: '-8px', y: '-8px', width: 'calc(100% + 16px)', height: 'calc(100% + 16px)' }}
          {...notes[0]}
        />
      </div>
    </header>

    {
      lenses.map(({ show, copy }) => (
        <div class="layout" data-show={show}>
          <div class="table">
            <p class="column-labels label" aria-hidden="true" data-reveal>
              <span>{copy.valueLabel}</span>
              <span>{copy.teamLabel}</span>
            </p>
            <ul class="rows" data-reveal-children>
              {
                copy.rows.map((row) => (
                  <li>
                    <h3 data-background-text>{row.title}</h3>
                    <p data-background-text>{row.description}</p>
                  </li>
                ))
              }
            </ul>
          </div>

          <aside class="proof" data-reveal aria-labelledby={`proof-label-${show}`}>
            <p id={`proof-label-${show}`} class="label" data-background-text>{copy.proofLabel}</p>
            <div class="card">
              <img src={gardenImage.src} alt={gardenImage.alt} width="376" height="196" loading="lazy" />
              <div class="card-body">
                <h3 data-background-text>{copy.gardenTitle}</h3>
                <p data-background-text>{copy.gardenDescription}</p>
                <dl>
                  {
                    copy.facts.map((fact) => (
                      <div>
                        <dt><span data-background-text>{fact.figure}</span></dt>
                        <dd data-background-text>{fact.description}</dd>
                      </div>
                    ))
                  }
                </dl>
                <a href={gardenHref} data-background-text>
                  <span class="underlined">{copy.gardenLink}</span> <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </aside>
        </div>
      ))
    }
  </div>
  <AnnotationList items={notes} label={insideCopy.notesLabel} />
</section>

<style>
  .values {
    position: relative;
    padding: 5rem 0;
    background: var(--color-bg);
  }

  .content {
    position: relative;
  }

  h2,
  h3,
  p,
  dl,
  dd,
  ul {
    margin: 0;
    padding: 0;
  }

  .marker,
  .label {
    font: 500 var(--font-size-label) / 1.5 var(--font-mono);
    color: var(--color-text-muted);
  }

  .marker {
    font-size: 0.8125rem;
  }

  h2 {
    max-width: 62rem;
    margin-top: var(--space-xs);
    font: 600 var(--font-size-heading-lg) / 1.05 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--color-heading);
  }

  .sub {
    max-width: 40rem;
    margin-top: var(--space-xl);
    font-size: var(--font-size-body);
    line-height: 1.6;
  }

  /* The Inside sub is narrower than the Outside one, and carries the annotation. */
  .sub-frame {
    position: relative;
    max-width: 38.75rem;
  }

  .layout {
    /* Label row height plus its padding: where the full-width rule sits on desktop. */
    --head: calc(var(--font-size-label) * 1.5 + var(--space-sm));
    position: relative;
    margin-top: var(--space-2xl);
  }

  .column-labels {
    display: none;
  }

  .rows {
    list-style: none;
    border-top: 1px solid var(--color-heading);
  }

  .rows li {
    padding: var(--space-xl) 0;
    border-bottom: 1px solid var(--color-heading);
  }

  .rows h3 {
    max-width: 26rem;
    font: 600 var(--font-size-heading-sm) / 1.1 var(--font-display);
    letter-spacing: -0.015em;
    color: var(--color-heading);
  }

  .rows p {
    margin-top: var(--space-sm);
    font-size: var(--font-size-body);
    line-height: 1.6;
  }

  .proof {
    margin-top: var(--space-3xl);
  }

  .proof .label {
    margin-bottom: var(--space-sm);
  }

  .card {
    overflow: hidden;
    background: var(--color-card);
    border-radius: 1rem;
  }

  .card img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 376 / 196;
    object-fit: cover;
  }

  .card-body {
    padding: var(--space-xl) var(--space-xl) var(--space-sm);
  }

  .card h3 {
    font: 500 1.5rem / 1.2 var(--font-display);
    color: var(--color-heading);
  }

  .card-body {
    font-size: 1rem;
  }

  .card-body > p {
    margin-top: var(--space-xs);
    line-height: 1.5;
  }

  dl {
    margin-top: var(--space-md);
  }

  dl div {
    display: grid;
    grid-template-columns: 7.75rem minmax(0, 1fr);
    align-items: center;
    padding: 0.625rem 0;
    border-top: 1px solid var(--color-border);
  }

  dt span {
    padding: 0.125rem 0.375rem;
    font-weight: 500;
    color: var(--color-heading);
    background: var(--color-light-sun);
    border-radius: 0.25rem;
  }

  /* Inside: the figure marker flips to the accent colors instead of the sun. */
  [data-show='inside'] dt span {
    color: var(--color-accent-text);
    background: var(--color-accent);
  }

  dd {
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .card a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: 2.75rem;
    margin-top: var(--space-xs);
    color: var(--color-heading);
  }

  .underlined {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  @media (min-width: 48rem) {
    .values {
      padding: 6rem 0 6.5rem;
    }

    .layout {
      margin-top: 4.5rem;
    }

    .column-labels,
    .rows li {
      display: grid;
      grid-template-columns: 18.5rem minmax(0, 1fr);
      gap: var(--space-xl);
    }

    .column-labels {
      padding-bottom: var(--space-sm);
      border-bottom: 1px solid var(--color-heading);
    }

    .rows {
      border-top: 0;
    }

    .rows li {
      padding: 2rem 0;
    }

    .rows p {
      margin-top: 0.375rem;
    }

    .proof {
      margin-top: var(--space-3xl);
    }
  }

  @media (min-width: 64.0625rem) {
    .values {
      padding: 7.5rem 0 11.25rem;
    }

    .layout {
      display: grid;
      grid-template-columns: minmax(0, 876fr) minmax(0, 376fr);
      gap: 3.75rem;
    }

    /* The rule under the column labels also runs above the proof card. */
    .layout::before {
      content: '';
      position: absolute;
      inset: var(--head) 0 auto;
      border-top: 1px solid var(--color-heading);
    }

    .column-labels {
      border-bottom: 0;
    }

    .column-labels,
    .rows li {
      grid-template-columns: minmax(0, 496fr) minmax(0, 380fr);
      gap: 0;
    }

    .rows li {
      min-height: 12.5rem;
      padding: 1.875rem 0 1.5rem;
    }

    .proof {
      margin-top: 0;
    }

    .proof .label {
      /* Same height as the column labels and their rule, then a 24px gap to the card. */
      margin-bottom: calc(var(--head) - var(--font-size-label) * 1.5 + 1px + var(--space-xl));
    }
  }
</style>
