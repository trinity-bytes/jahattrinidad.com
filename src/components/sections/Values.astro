---
import TextLink from '../ui/TextLink.astro';
import type { Dictionary } from '../../lib/i18n';
import Backgrounds from './Backgrounds.astro';
import Annotation from '../ui/Annotation.astro';
import AnnotationList from '../ui/annotation/AnnotationList.astro';

interface Props {
  copy: Dictionary['home']['outside']['values'];
  /** The Inside copy: another reading of the same section, shown only in the Inside lens. */
  insideCopy: Dictionary['home']['inside']['values'];
  /** The Garden case study. */
  gardenHref: string;
  gardenImage: { src: string; alt: string };
}

const { copy, insideCopy, gardenHref, gardenImage } = Astro.props;

// The table and the proof card are rendered once per lens; the app shell shows the active one.
const lenses = [
  { show: 'outside', copy },
  { show: 'inside', copy: insideCopy },
] as const;
const notes = [insideCopy.annotations.source];
---

<section class="values" aria-labelledby="values-heading">
  <Backgrounds variant="values" next="surface" seed={2} />
  <div class="container content">
    <header>
      <p class="marker" data-background-text data-reveal="text">
        <span data-show="outside">{copy.marker}</span><span data-show="inside">{insideCopy.marker}</span>
      </p>
      <h2 id="values-heading" data-background-text data-reveal="text">
        <span data-show="outside">{copy.headline.map((phrase, i) => (<>{i > 0 && ' '}<span class="phrase">{phrase}</span></>))}</span><span data-show="inside">{insideCopy.headline.map((phrase, i) => (<>{i > 0 && ' '}<span class="phrase">{phrase}</span></>))}</span>
      </h2>
      <p class="sub" data-show="outside" data-background-text data-reveal="text">{copy.sub}</p>
      <div class="sub sub-frame" data-show="inside" data-reveal>
        <p data-background-text>{insideCopy.sub}</p>
        <Annotation
          n={1}
          x="calc(100% + 8px)"
          y="50%"
          pinX="calc(100% - 8px)"
          pinY="-8px"
          bound={{ x: '-8px', y: '-8px', width: 'calc(100% + 16px)', height: 'calc(100% + 16px)' }}
          {...notes[0]}
        />
      </div>
    </header>

    {
      lenses.map(({ show, copy }) => (
        <div class="layout" data-show={show}>
          <div class="table">
            <p class="column-labels label" aria-hidden="true" data-reveal>
              <span>{copy.valueLabel}</span>
              <span>{copy.teamLabel}</span>
            </p>
            <ul class="rows" data-reveal-children>
              {
                copy.rows.map((row) => (
                  <li>
                    <h3 data-background-text>{row.title.map((phrase, i) => (<>{i > 0 && ' '}<span class="phrase">{phrase}</span></>))}</h3>
                    <p data-background-text>{row.description}</p>
                  </li>
                ))
              }
            </ul>
          </div>

          <aside class="proof" data-reveal aria-labelledby={`proof-label-${show}`}>
            <p id={`proof-label-${show}`} class="label" data-background-text>{copy.proofLabel}</p>
            <div class="card">
              <img src={gardenImage.src} alt={gardenImage.alt} width="376" height="196" loading="lazy" />
              <div class="card-body">
                <h3 data-background-text>{copy.gardenTitle}</h3>
                <p data-background-text>{copy.gardenDescription}</p>
                <dl>
                  {
                    copy.facts.map((fact) => (
                      <div>
                        <dt><span data-background-text>{fact.figure}</span></dt>
                        <dd data-background-text>{fact.description}</dd>
                      </div>
                    ))
                  }
                </dl>
                <TextLink class="proof-link" href={gardenHref} label={copy.gardenLink} data-background-text />
              </div>
            </div>
          </aside>
        </div>
      ))
    }
  </div>
  <AnnotationList items={notes} label={insideCopy.notesLabel} />
</section>

<style>
  .values {
    position: relative;
    padding: var(--section-pad) 0;
    background: var(--color-bg);
  }
  /* While the rise glow is live, the top 120px are transparent so the hero's ground bleed shows
     through (Hero.astro). GlowTransition moves --seam-edge from 120px to 0 over the first 140px of
     scroll, so the surface closes over the band from the bottom up, keeping pace with the glow.
     Without the glow (no JS) the section keeps its solid background and the old edge. */
  .values:has(> [data-glow-transition='rise'][data-ready]) {
    background: linear-gradient(to bottom, transparent calc(var(--seam-edge, 120px) - 60px), var(--color-bg) var(--seam-edge, 120px));
  }

  .content {
    position: relative;
  }

  h2,
  h3,
  p,
  dl,
  dd,
  ul {
    margin: 0;
    padding: 0;
  }

  /* A line breaks between phrases, and inside one only when it does not fit. */
  .phrase {
    display: inline-block;
  }

  .marker {
    font: var(--type-marker);
    letter-spacing: var(--type-marker-tracking);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .label {
    font: var(--type-meta);
    letter-spacing: var(--type-meta-tracking);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  h2 {
    max-width: 62rem;
    /* With the phrases unbreakable, filling each line gives the boards' breaks; balance would not. */
    text-wrap: wrap;
    margin-top: var(--space-sm);
    font: 600 var(--font-size-h1) / 1.05 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--color-heading);
  }

  .sub {
    max-width: 40rem;
    margin-top: var(--space-xl);
    font-size: var(--font-size-body);
    line-height: 1.5;
  }

  /* The Inside sub is narrower than the Outside one, and carries the annotation. */
  .sub-frame {
    position: relative;
    max-width: 38.75rem;
  }

  .layout {
    margin-top: var(--space-2xl);
  }

  .column-labels {
    display: none;
  }

  .rows {
    list-style: none;
  }

  .rows li {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg) 0 var(--space-xl);
    border-top: 1px solid var(--color-heading);
  }

  .rows li:last-child {
    border-bottom: 1px solid var(--color-heading);
  }

  .rows h3 {
    font: 600 var(--font-size-h3) / 1.15 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--color-heading);
  }

  .rows p {
    font-size: var(--font-size-body);
    line-height: 1.5;
  }

  .proof {
    margin-top: var(--space-xl);
  }

  .proof .label {
    margin-bottom: var(--space-sm);
  }

  .card {
    overflow: hidden;
    background: var(--color-card);
    border-radius: var(--radius-lg);
  }

  .card img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 376 / 196;
    object-fit: cover;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
    padding: var(--space-xl);
  }

  .card h3 {
    font: 600 var(--font-size-h4) / 1.2 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--color-heading);
  }

  .card-body > p {
    font-size: var(--font-size-small);
    line-height: 1.5;
  }

  dl {
    width: 100%;
  }

  dl div {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: var(--space-md);
    align-items: center;
    padding: var(--space-xs) 0;
    border-top: 1px solid var(--color-border);
    font-size: var(--font-size-caption);
    line-height: 1.4;
  }

  dt span {
    display: inline-block;
    padding: 0 var(--space-xs);
    color: var(--color-highlight-text);
    background: var(--color-highlight);
    border-radius: var(--radius-sm);
  }

  @media (min-width: 48rem) {
    .layout {
      margin-top: var(--space-3xl);
    }

    .column-labels,
    .rows li {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3xl);
    }

    .column-labels {
      padding-bottom: var(--space-sm);
    }

    .rows li {
      align-items: start;
      padding: var(--space-2xl-b) 0 var(--space-3xl);
    }

    .proof {
      margin-top: var(--space-xl);
    }
  }

  @media (min-width: 64.0625rem) {
    .layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 23.5rem;
      gap: var(--space-4xl);
      align-items: start;
    }

    .proof {
      margin-top: 0;
    }
  }
</style>
