---
import TextLink from '../ui/TextLink.astro';
import { getDictionary, type Locale } from '../../lib/i18n';
import { Image } from 'astro:assets';
import sky from '../../assets/hero/sky.png';
import Chat from './contact/Chat.astro';
import Annotation from '../ui/Annotation.astro';
import { cvPath } from '../../lib/cv';
import AnnotationList from '../ui/annotation/AnnotationList.astro';
import type { Dictionary } from '../../lib/i18n';

interface Props {
  lang: Locale;
  marker: string;
  /** Phrases of the heading: a line breaks between them, and inside one only when it does not fit. */
  headline: string[];
  strings: Dictionary['contact'];
  /** The Inside lens's copy: its marker and headline replace the two above, and it carries the annotation. */
  inside: Dictionary['home']['inside']['contact'];
  chat: Dictionary['chat'];
  /** CONTACT_EMAIL from src/lib/consts.ts. */
  email: string;
  /** Left out until the profile URL is in the links collection. */
  linkedInHref?: string;
}

const { lang, marker, headline, strings, inside, chat, email, linkedInHref } = Astro.props;
const newTab = getDictionary(lang).common.newTab;
const notes = [inside.annotations.composer];
const facts = [
  { label: strings.lookingFor, value: strings.lookingForValue },
  { label: strings.available, value: strings.availableValue },
  { label: strings.basedIn, value: strings.basedInValue },
];
---
{/*
  The sky runs into the footer (D17): the footer's hill is positioned 260px above its own top, so it
  rises over this section's bottom padding. Render the footer directly after this section, with no
  margin between them.
*/}
<section id="contact" class="contact" aria-labelledby="contact-heading">
  <Image class="sky" src={sky} alt="" widths={[768, 1440, 2000]} sizes="100vw" loading="lazy" />
  <div class="dusk" data-show="inside" aria-hidden="true"></div>
  <div class="sun-mask" data-show="inside" aria-hidden="true"></div>
  <div class="content">
    <p class="marker" data-show="outside" data-reveal="text">{marker}</p>
    <p class="marker" data-show="inside" data-reveal="text">{inside.marker}</p>
    <h2 id="contact-heading" data-reveal="text"><span data-show="outside">{headline.map((phrase, i) => (<>{i > 0 && ' '}<span class="phrase">{phrase}</span></>))}</span><span data-show="inside">{inside.headline.map((phrase, i) => (<>{i > 0 && ' '}<span class="phrase">{phrase}</span></>))}</span></h2>
    <dl class="facts" data-reveal-children>
      {facts.map(({ label, value }) => (
        <div class="fact">
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
    <Chat lang={lang} strings={strings} chat={chat}>
      <Annotation
        slot="annotation"
        n={1}
        x="calc(100% + 8px)"
        y="50%"
        pinX="calc(100% - 8px)"
        pinY="-8px"
        bound={{ x: '-8px', y: '-8px', width: 'calc(100% + 16px)', height: 'calc(100% + 16px)' }}
        {...notes[0]}
      />
    </Chat>
    <div class="fallback" data-reveal>
      <span class="or">{strings.or}</span>
      <TextLink type="button" destination="in-page" leadingGlyph="copy" label={strings.copyEmail} data-copy-email={email} data-copied={strings.copied}>
        <span data-copy-label>{strings.copyEmail}</span>
      </TextLink>
      <noscript><TextLink destination="in-page" href={`mailto:${email}`} label={email} /></noscript>
      {linkedInHref && <TextLink destination="external" href={linkedInHref} label={strings.linkedIn} newTab={newTab} />}
      <TextLink destination="external" href={cvPath(lang)} label={strings.cv} newTab={newTab} />
    </div>
    <AnnotationList class="notes" items={notes} label={inside.notesLabel} />
  </div>
</section>
<script>
  /*
   * Scroll parallax: the sky (and the Inside sun drawn over it) drifts down while the section passes, so it
   * moves slower than the copy and reads as far away. Scrubbed from the section entering the viewport to
   * the end of the page (the footer closes it). Reduced motion: the sky stays put.
   */
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const contact = document.querySelector<HTMLElement>('#contact:not([data-lens-preview] *)');
  if (contact) {
    /** How far the sky travels each way, as a fraction of the section's height (the sky overhangs by 10%). */
    const DRIFT = 0.08;
    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
      gsap.fromTo(contact,
        { '--sky-y': () => `${-contact.offsetHeight * DRIFT}px` },
        {
          '--sky-y': () => `${contact.offsetHeight * DRIFT}px`,
          ease: 'none',
          scrollTrigger: {
            trigger: contact,
            start: 'top bottom',
            end: () => ScrollTrigger.maxScroll(window),
            scrub: 0.4,
            invalidateOnRefresh: true,
          },
        });
      return () => contact.style.removeProperty('--sky-y');
    });
    new MutationObserver(() => ScrollTrigger.refresh()).observe(document.documentElement, { attributes: true, attributeFilter: ['data-lens'] });
  }
</script>
<script>
  import { copyText } from './contact/copy';
  const button = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const label = button?.querySelector<HTMLElement>('[data-copy-label]');
  const announcements = document.getElementById('announcements');
  if (button && label) {
    const idle = label.textContent ?? '';
    let reset = 0;
    button.addEventListener('click', async () => {
      const email = button.dataset.copyEmail ?? '';
      // Clipboard access can be denied: show the address so it can be copied by hand.
      const message = (await copyText(email)) ? (button.dataset.copied ?? email) : email;
      label.textContent = message;
      if (announcements) announcements.textContent = message;
      clearTimeout(reset);
      reset = window.setTimeout(() => {
        label.textContent = idle;
        if (announcements) announcements.textContent = '';
      }, 2500);
    });
  }
</script>
<style>
  .contact { position: relative; isolation: isolate; overflow: hidden; background: var(--color-bg); color: var(--color-heading); }
  /* The board mirrors the shared sky so the sun sits to the right of the form. */
  /* 20% taller than the section (10% over each edge) so the scroll parallax below never shows its edges.
     The parallax moves --sky-y, read through `translate` so the mirroring transform stays untouched. */
  .sky { position: absolute; inset: -10% 0 auto; z-index: -1; width: 100%; height: 120%; object-fit: cover; transform: scaleX(-1); translate: 0 var(--sky-y, 0px); }
  /*
   * Inside: the sky is not mirrored and keeps its own size, so the sun lands where the board
   * puts it (--sun-x, --sun-y), under the dusk overlay. The sun sits at 30.1% across the image
   * and 43.94% of its width down (the same numbers the hero uses).
   */
  .contact {
    container-type: inline-size;
    /* Mobile board 2212:634. */
    --sky-w: 2000px;
    --sun-x: 117px;
    --sun-y: 485px;
    --sun-size: 166px;
  }
  :global([data-lens='inside']) .sky {
    inset: auto;
    z-index: -3;
    width: var(--sky-w);
    height: auto;
    max-width: none;
    left: calc(var(--sun-x) - var(--sky-w) * 0.301);
    top: calc(var(--sun-y) - var(--sky-w) * 0.4394);
    transform: none;
  }
  /* Outside: the copy's lower rows (hint, "Or", links) sit over the mid-tone hills. A haze of the pale sun
     lifts the sky behind the content column only, fading out to the right so the landscape stays. */
  .contact::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(ellipse 48% 34% at 18% 64%, color-mix(in srgb, var(--sun-soft) 82%, transparent) 0 45%, transparent 100%);
  }
  /* Phones: the content column is the whole width, so the haze is too. */
  @media (max-width: 47.99rem) {
    .contact::after { background: radial-gradient(ellipse 95% 34% at 35% 64%, color-mix(in srgb, var(--sun-soft) 82%, transparent) 0 45%, transparent 100%); }
  }
  :global([data-lens='inside']) .contact::after { content: none; }
  .dusk { position: absolute; inset: 0; z-index: -2; background: var(--color-dusk); pointer-events: none; }
  .sun-mask { position: absolute; z-index: -1; left: calc(var(--sun-x) - var(--sun-size) / 2); top: calc(var(--sun-y) - var(--sun-size) / 2); width: var(--sun-size); height: var(--sun-size); border-radius: 50%; background: var(--dusk-sun); filter: blur(calc(var(--sun-size) / 4)); pointer-events: none; translate: 0 var(--sky-y, 0px); }
  .content > :global(.notes) { padding-inline: 0; }
  .content { max-width: calc(var(--content-max) + 2 * var(--gutter)); margin-inline: auto; padding: var(--section-pad) var(--gutter); display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-2xl-b); }
  .marker { margin: 0; font: var(--type-marker); letter-spacing: var(--type-marker-tracking); text-transform: uppercase; color: var(--color-text); }
  h2 { margin: 0; max-width: 60rem; font: 600 var(--font-size-h1)/1.05 var(--font-display); letter-spacing: -0.02em; color: var(--color-heading); }
  /* Phones: the question flows as one text, as the 390 boards set it. */
  @media (max-width: 47.99rem) { .phrase:not(:only-child) { display: inline; } }
  /* The boards fill each line; balance would split the Outside question elsewhere. */
  h2 { text-wrap: wrap; }
  .phrase { display: inline-block; }
  .facts { display: grid; grid-template-columns: 1fr; width: 100%; max-width: 55rem; margin: 0; }
  .fact { display: flex; flex-direction: column; gap: 0.375rem; padding: var(--space-md) var(--space-xl) var(--space-md) 0; border-top: 1px solid var(--color-heading); }
  .fact:last-child { padding-bottom: 0; }
  dt { font: var(--type-meta); letter-spacing: var(--type-meta-tracking); text-transform: uppercase; color: var(--color-text); }
  dd { margin: 0; white-space: pre-line; font: 400 var(--font-size-body)/1.5 var(--font-sans); color: var(--color-heading); }
  /*
   * Chatting (set by the chat client on the first message): the card replaces the composer and the
   * "Or" row. Mobile board 2353:103 also gives up the headline and facts; tablet 2358:302 keeps them
   * above a full-width card; desktop 2358:226 puts them in a left column beside the card.
   */
  .contact[data-chatting] .fallback { display: none; }
  /* Beside the card the column is narrow: the heading fills its lines, as the chat-open board does. */
  .contact[data-chatting] .phrase { display: inline; }
  .contact[data-chatting] h2, .contact[data-chatting] .facts { display: none; }
  .fallback { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-xl); }
  .or { font: var(--type-meta); letter-spacing: 0.02em; color: var(--color-text); }
  @media (min-width: 48rem) {
    /* Tablet board 2213:634. */
    .contact { --sky-w: 1600px; --sun-x: 230px; --sun-y: 478px; --sun-size: 73.5px; }
    .fallback { flex-direction: row; flex-wrap: wrap; align-items: center; }
    .fact { padding-bottom: 0; }
    .facts { grid-template-columns: 20rem 11.5rem 1fr; max-width: none; }
    .contact[data-chatting] h2 { display: block; }
    .contact[data-chatting] .facts { display: grid; }
  }
  @media (min-width: 64.0625rem) {
    /* Desktop board 2191:840: the sky is centred and grows with the page past 1440. */
    .contact { --sky-w: max(1782px, 123.75cqw); --sun-x: calc(50cqw - 355px); --sun-y: 602px; --sun-size: 64px; }
    .facts { grid-template-columns: repeat(3, 1fr); max-width: 55rem; }
  }
  @media (min-width: 80rem) {
    /* Desktop chat: the card (620 x 640) sits in the right column from the marker line. */
    .contact[data-chatting] .content { position: relative; min-height: calc(40rem + 2 * var(--section-pad)); }
    .contact[data-chatting] .content > :global(.chat) { position: absolute; top: var(--section-pad); right: var(--gutter); width: 38.75rem; }
    .contact[data-chatting] h2 { max-width: min(36.25rem, calc(100% - 41rem)); }
    .contact[data-chatting] .facts { grid-template-columns: 1fr; max-width: 36.25rem; }
    .contact[data-chatting] .fact { padding-bottom: var(--space-md); }
  }
</style>
