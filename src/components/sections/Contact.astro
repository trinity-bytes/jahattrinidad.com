---
import { Image } from 'astro:assets';
import sky from '../../assets/hero/sky.png';
import Icon from '../ui/Icon.astro';
import Annotation from '../ui/Annotation.astro';
import AnnotationList from '../ui/annotation/AnnotationList.astro';
import type { Dictionary } from '../../lib/i18n';

interface Props {
  marker: string;
  headline: string;
  strings: Dictionary['contact'];
  /** The Inside lens's copy: its marker and headline replace the two above, and it carries the annotation. */
  inside: Dictionary['home']['inside']['contact'];
  chat: Dictionary['chat'];
  /** CONTACT_EMAIL from src/lib/consts.ts. */
  email: string;
  /** Left out until the profile URL is in the links collection. */
  linkedInHref?: string;
}

const { marker, headline, strings, inside, chat, email, linkedInHref } = Astro.props;
const notes = [inside.annotations.composer];
const facts = [
  { label: strings.lookingFor, value: strings.lookingForValue },
  { label: strings.available, value: strings.availableValue },
  { label: strings.basedIn, value: strings.basedInValue },
];
---
<!--
  The sky runs into the footer (D17): the footer's hill is positioned 260px above its own top, so it
  rises over this section's bottom padding. Render the footer directly after this section, with no
  margin between them.
-->
<section id="contact" class="contact" aria-labelledby="contact-heading">
  <Image class="sky" src={sky} alt="" widths={[768, 1440, 2000]} sizes="100vw" loading="lazy" />
  <div class="dusk" data-show="inside" aria-hidden="true"></div>
  <div class="sun-mask" data-show="inside" aria-hidden="true"></div>
  <div class="content">
    <p class="marker" data-show="outside">{marker}</p>
    <p class="marker" data-show="inside">{inside.marker}</p>
    <h2 id="contact-heading"><span data-show="outside">{headline}</span><span data-show="inside">{inside.headline}</span></h2>
    <dl class="facts">
      {facts.map(({ label, value }) => (
        <div class="fact">
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
    <!-- Static preview: the live chat arrives in phase 7. Disabled controls keep their names so the layout is announced. -->
    <form class="composer">
      <div class="field">
        <input type="text" name="message" aria-label={strings.composerLabel} placeholder={chat.composerPlaceholder} disabled />
        <button type="submit" class="send" aria-label={strings.send} disabled>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m5 12 7-7 7 7" /><path d="M12 19V5" /></svg>
        </button>
        <Annotation
          n={1}
          x="calc(100% + 9px)"
          y="50%"
          pinX="-9px"
          pinY="-9px"
          bound={{ x: '-9px', y: '-9px', width: 'calc(100% + 18px)', height: 'calc(100% + 18px)' }}
          {...notes[0]}
        />
      </div>
      <ul class="suggestions" aria-label={chat.suggestionsLabel}>
        <li><button type="button" disabled>{chat.hiring}</button></li>
        <li><button type="button" disabled>{chat.project}</button></li>
      </ul>
    </form>
    <div class="fallback">
      <span class="or">{strings.or}</span>
      <button type="button" class="link" data-copy-email={email} data-copied={strings.copied}>
        <Icon name="copy" size={20} />
        <span data-copy-label>{strings.copyEmail}</span>
      </button>
      {linkedInHref && (
        <a class="link" href={linkedInHref} target="_blank" rel="noopener noreferrer">
          {strings.linkedIn}
          <Icon name="arrow-up-right" size={18} />
        </a>
      )}
    </div>
    <AnnotationList class="notes" items={notes} label={inside.notesLabel} />
  </div>
</section>
<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const label = button?.querySelector<HTMLElement>('[data-copy-label]');
  const announcements = document.getElementById('announcements');
  if (button && label) {
    const idle = label.textContent ?? '';
    let reset = 0;
    button.addEventListener('click', async () => {
      const email = button.dataset.copyEmail ?? '';
      let message: string;
      try {
        await navigator.clipboard.writeText(email);
        message = button.dataset.copied ?? email;
      } catch {
        // Clipboard access can be denied: show the address so it can be copied by hand.
        message = email;
      }
      label.textContent = message;
      if (announcements) announcements.textContent = message;
      clearTimeout(reset);
      reset = window.setTimeout(() => {
        label.textContent = idle;
        if (announcements) announcements.textContent = '';
      }, 2500);
    });
  }
</script>
<style>
  .contact { position: relative; isolation: isolate; overflow: hidden; background: var(--color-bg); color: var(--color-heading); }
  /* The board mirrors the shared sky so the sun sits to the right of the form. */
  .sky { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1); }
  /*
   * Inside: the sky is not mirrored and keeps its own size, so the sun lands where the board
   * puts it (--sun-x, --sun-y), under the dusk overlay. The sun sits at 30.1% across the image
   * and 43.94% of its width down (the same numbers the hero uses).
   */
  .contact {
    container-type: inline-size;
    /* Mobile board 2212:634. */
    --sky-w: 2000px;
    --sun-x: 117px;
    --sun-y: 485px;
    --sun-size: 166px;
  }
  :global([data-lens='inside']) .sky {
    inset: auto;
    z-index: -3;
    width: var(--sky-w);
    height: auto;
    max-width: none;
    left: calc(var(--sun-x) - var(--sky-w) * 0.301);
    top: calc(var(--sun-y) - var(--sky-w) * 0.4394);
    transform: none;
  }
  .dusk { position: absolute; inset: 0; z-index: -2; background: var(--color-dusk); pointer-events: none; }
  .sun-mask { position: absolute; z-index: -1; left: calc(var(--sun-x) - var(--sun-size) / 2); top: calc(var(--sun-y) - var(--sun-size) / 2); width: var(--sun-size); height: var(--sun-size); border-radius: 50%; background: var(--dusk-sun); filter: blur(calc(var(--sun-size) / 4)); pointer-events: none; }
  .content > :global(.notes) { padding-inline: 0; }
  .content { max-width: calc(var(--content-max) + 2 * var(--gutter)); margin-inline: auto; padding: 5rem var(--gutter) 6.5rem; display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-xl); }
  .marker { margin: 0; font: 500 0.8125rem/1.3 var(--font-mono); letter-spacing: 0.08em; color: var(--color-text); }
  h2 { margin: 0; max-width: 56.25rem; font: 600 var(--font-size-heading-lg)/1.05 var(--font-display); letter-spacing: -0.03em; color: var(--color-heading); }
  .facts { display: grid; grid-template-columns: 1fr; width: 100%; max-width: 55rem; margin: 0; }
  .fact { display: flex; flex-direction: column; gap: 0.375rem; padding: var(--space-md) var(--space-xl) 0 0; border-top: 1px solid var(--color-heading); }
  dt { font: 500 var(--font-size-label)/1.33 var(--font-mono); color: var(--color-text); }
  dd { margin: 0; white-space: pre-line; font: 500 1.25rem/1.35 var(--font-sans); }
  .composer { display: flex; flex-direction: column; gap: var(--space-sm); width: 100%; max-width: 38.75rem; }
  .field { position: relative; display: flex; align-items: center; justify-content: space-between; gap: var(--space-sm); height: 4rem; padding: 0 var(--space-xs) 0 1.75rem; border: 1px solid var(--color-heading); border-radius: 999px; background: var(--color-card); }
  input { flex: 1; min-width: 0; text-overflow: ellipsis; border: 0; background: none; font: 400 1.125rem/1.3 var(--font-sans); color: var(--color-heading); }
  input::placeholder { color: var(--color-placeholder); opacity: 1; }
  .send { display: grid; place-items: center; flex: none; width: 3rem; height: 3rem; padding: 0; border: 0; border-radius: 50%; background: var(--color-accent); color: var(--color-accent-text); }
  .suggestions { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin: 0; padding: 0; list-style: none; }
  .suggestions button { min-height: 2.75rem; padding: 0.5625rem 1.125rem; border: 1.5px solid var(--color-heading); border-radius: 999px; background: var(--color-card); font: 500 0.9375rem/1.3 var(--font-sans); color: var(--color-heading); }
  /* The preview is disabled but must read as the finished design, not as greyed-out controls. */
  input:disabled, button:disabled { opacity: 1; cursor: default; }
  .fallback { display: flex; align-items: center; gap: 1.75rem; flex-wrap: wrap; }
  .or { font: 500 var(--font-size-label)/1.33 var(--font-mono); color: var(--color-text); }
  .link { display: inline-flex; align-items: center; gap: 0.625rem; min-height: 2.75rem; padding: 0; border: 0; background: none; font: 500 1.125rem/1.3 var(--font-sans); color: var(--color-heading); text-decoration: underline; text-underline-offset: 0.2em; cursor: pointer; }
  a.link { gap: var(--space-xs); }
  .link:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 3px; }
  @media (min-width: 48rem) {
    /* Tablet board 2213:634. */
    .contact { --sky-w: 1600px; --sun-x: 230px; --sun-y: 478px; --sun-size: 73.5px; }
    .content { padding-block: 6.5rem 10.5rem; }
    .facts { grid-template-columns: 20rem 11.5rem 1fr; max-width: none; }
  }
  @media (min-width: 64.0625rem) {
    /* Desktop board 2191:840: the sky is centred and grows with the page past 1440. */
    .contact { --sky-w: max(1782px, 123.75cqw); --sun-x: calc(50cqw - 355px); --sun-y: 585px; --sun-size: 64px; }
    .content { padding-block: 8.75rem 12.25rem; gap: 2rem; }
    .facts { grid-template-columns: repeat(3, 1fr); max-width: 55rem; }
  }
</style>
