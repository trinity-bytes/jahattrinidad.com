---
import Icon from '../ui/Icon.astro';
import type { Dictionary } from '../../lib/i18n';

interface Props {
  home: string;
  workPath: string;
  notesPath: string;
  strings: Dictionary['nav'];
}
const { home, workPath, notesPath, strings } = Astro.props;
const links = [
  { label: strings.work, href: `${home}#work`, id: 'work', route: workPath },
  { label: strings.experience, href: `${home}#experience`, id: 'experience' },
  { label: strings.notes, href: `${home}#notes`, id: 'notes', route: notesPath },
];
const contact = `${home}#contact`;
const pathname = Astro.url.pathname;
---
<header class="site-nav" data-nav data-state="scrolled">
  <nav aria-label={strings.navigation} class="nav-inner">
    <a class="brand" href={home}><span class="brand-outside">{strings.brand}</span><span class="brand-inside">{strings.brandInside}</span></a>
    <div class="desktop-links">
      {links.map((link) => <a href={link.href} data-section-link={link.id} aria-current={link.route && pathname.startsWith(link.route) ? 'page' : undefined}>{link.label}</a>)}
    </div>
    <a class="contact" href={contact} data-section-link="contact">{strings.contact}</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation" aria-label={strings.openMenu} data-open-label={strings.openMenu} data-close-label={strings.closeMenu}>
      <span class="menu-icon"><Icon name="menu" size={20} /></span><span class="close-icon"><Icon name="x" size={20} /></span>
    </button>
  </nav>
  <div id="mobile-navigation" class="mobile-links" hidden>
    {links.map((link) => <a href={link.href} data-section-link={link.id} aria-current={link.route && pathname.startsWith(link.route) ? 'page' : undefined}>{link.label}</a>)}
  </div>
</header>
<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (nav) {
    const hero = document.querySelector<HTMLElement>('[data-hero], #hero');
    if (hero && 'IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        nav.dataset.state = entry.isIntersecting ? 'top' : 'scrolled';
      }).observe(hero);
    }
    const button = nav.querySelector<HTMLButtonElement>('.menu-toggle');
    const menu = nav.querySelector<HTMLElement>('#mobile-navigation');
    const setOpen = (open: boolean) => {
      if (!button || !menu) return;
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? button.dataset.closeLabel! : button.dataset.openLabel!);
      menu.hidden = !open;
    };
    button?.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    menu?.addEventListener('click', (event) => { if ((event.target as Element).closest('a')) setOpen(false); });
    nav.addEventListener('keydown', (event) => { if (event.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') { setOpen(false); button.focus(); } });
    const sections = Array.from(document.querySelectorAll<HTMLElement>('#work, #experience, #notes, #contact'));
    if (sections.length && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          nav.querySelectorAll<HTMLAnchorElement>('[data-section-link]').forEach((link) => {
            if (link.dataset.sectionLink === entry.target.id) link.setAttribute('aria-current', 'true');
            else link.removeAttribute('aria-current');
          });
        }
      }, { rootMargin: '-20% 0px -70% 0px' });
      sections.forEach((section) => observer.observe(section));
    }
  }
</script>
<style>
  .site-nav { position: sticky; top: 0; z-index: 50; color: var(--color-heading); background: var(--color-bg); border-bottom: 1px solid var(--color-border); }
  .site-nav[data-state='top'] { margin-bottom: -120px; background: transparent; border-bottom: 0; }
  @supports (backdrop-filter: blur(20px)) {
    .site-nav[data-state='scrolled'] { background: light-dark(color-mix(in srgb, var(--color-bg) 82%, transparent), color-mix(in srgb, var(--color-bg) 78%, transparent)); backdrop-filter: blur(20px); }
  }
  @media (prefers-reduced-transparency: reduce) { .site-nav[data-state='scrolled'] { background: var(--color-bg); backdrop-filter: none; } }
  .site-nav[data-state='top'] .nav-inner { min-height: 120px; }
  .nav-inner { min-height: 69px; padding: var(--space-sm) var(--gutter-desktop); display: flex; align-items: center; gap: 2rem; }
  a { color: inherit; text-decoration: none; }
  .brand { font-family: var(--font-display), sans-serif; font-size: 1.375rem; font-weight: 600; letter-spacing: -0.02em; margin-right: auto; white-space: nowrap; }
  .brand-inside { display: none; font-family: var(--font-mono), monospace; font-size: 1.25rem; }
  :global([data-lens='inside']) .brand-outside { display: none; }
  :global([data-lens='inside']) .brand-inside { display: inline; }
  .desktop-links { display: flex; align-items: center; gap: 2rem; }
  .desktop-links a, .mobile-links a { position: relative; font-size: 1rem; font-weight: 500; }
  [aria-current]::before { content: ''; position: absolute; left: -14px; top: 50%; width: 7px; height: 7px; border-radius: 50%; background: var(--color-signal); border: 1px solid var(--color-heading); transform: translateY(-50%); }
  .contact { border-radius: 999px; background: var(--color-accent); color: var(--color-accent-text); padding: var(--space-sm) var(--space-lg); font-size: 1rem; font-weight: 500; }
  .menu-toggle { display: none; width: 44px; height: 44px; padding: 0; align-items: center; justify-content: center; border: 1px solid var(--color-border); border-radius: 50%; color: inherit; background: transparent; cursor: pointer; }
  .close-icon, [aria-expanded='true'] .menu-icon { display: none; }
  [aria-expanded='true'] .close-icon { display: block; }
  .mobile-links { padding: var(--space-md) var(--gutter-mobile) var(--space-xl); background: var(--color-bg); }
  .mobile-links:not([hidden]) { display: flex; flex-direction: column; gap: var(--space-lg); }
  @media (max-width: 47.99rem) {
    .nav-inner { padding-inline: var(--gutter-tablet); gap: var(--space-xs); }
    .desktop-links { display: none; }
    .menu-toggle { display: inline-flex; }
  }
  @media (min-width: 48rem) and (max-width: 64rem) { .site-nav[data-state='top'] { margin-bottom: -104px; } .site-nav[data-state='top'] .nav-inner { min-height: 104px; } .nav-inner { padding-inline: var(--gutter-tablet); gap: 2rem; } .desktop-links { gap: 2rem; } }
  @media (max-width: 47.99rem) { .site-nav[data-state='top'] { margin-bottom: -88px; } .site-nav[data-state='top'] .nav-inner { min-height: 88px; } .nav-inner { padding-inline: var(--gutter-mobile); } .brand { font-size: 1.25rem; } }
  @media (forced-colors: active) { .contact { border: 1px solid ButtonText; } }
</style>
