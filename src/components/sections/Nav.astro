---
import Icon from '../ui/Icon.astro';
import type { Dictionary } from '../../lib/i18n';

interface Props {
  home: string;
  workPath: string;
  notesPath: string;
  strings: Dictionary['nav'];
  profileLinks?: { label: string; href: string }[];
  /** EN / ES / PT switch (Nav set `2185:122`), in switch order. */
  languages?: { lang: string; hrefLang: string; code: string; name: string; href: string; current: boolean }[];
}
const { home, workPath, notesPath, strings, profileLinks = [], languages = [] } = Astro.props;
const links = [
  { label: strings.work, href: `${home}#work`, id: 'work', route: workPath },
  { label: strings.experience, href: `${home}#experience`, id: 'experience' },
  { label: strings.notes, href: `${home}#notes`, id: 'notes', route: notesPath },
];
const contact = `${home}#contact`;
const pathname = Astro.url.pathname;
const isHome = pathname.replace(/\/$/, '') === home.replace(/\/$/, '');
const profileIcons = {
  GitHub: 'brand-github', LinkedIn: 'brand-linkedin', Instagram: 'brand-instagram',
  YouTube: 'brand-youtube', X: 'brand-x',
} as const;
---
<div class="nav-sentinel" data-nav-sentinel aria-hidden="true"></div>
{isHome && <script is:inline>if ('IntersectionObserver' in window && window.scrollY === 0) document.documentElement.dataset.navLogoInitial = 'hidden';</script>}
<header class="site-nav" data-nav data-state="scrolled" data-scroll-spy={isHome ? '' : undefined}>
  <nav aria-label={strings.navigation} class="nav-inner">
    <a class="brand" href={home}><span class="brand-outside">{strings.brand}</span><span class="brand-inside">{strings.brandInside}</span></a>
    <div class="desktop-links">
      <span class="pill" data-nav-pill aria-hidden="true"></span>
      {links.map((link) => <a href={link.href} data-section-link={link.id} aria-current={link.route && pathname.startsWith(link.route) ? 'page' : undefined}>{link.label}</a>)}
      {languages.length > 1 && <div class="lang-switch" role="group" aria-label={strings.language}>
        {languages.map((language, index) => <>{index > 0 && <span class="lang-sep" aria-hidden="true">/</span>}<a href={language.href} hreflang={language.hrefLang} lang={language.lang} data-locale-choice={language.lang} aria-label={language.name} aria-current={language.current ? 'true' : undefined}>{language.code}</a></>)}
      </div>}
    </div>
    <a class="contact" data-magnetic href={contact} data-section-link="contact">{strings.contact}</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation" aria-label={strings.openMenu} data-open-label={strings.openMenu} data-close-label={strings.closeMenu}>
      <span class="menu-icon"><Icon name="menu" size={20} /></span><span class="close-icon"><Icon name="x" size={20} /></span>
    </button>
  </nav>
  <div id="mobile-navigation" class="mobile-menu" hidden>
    <div class="scrim" data-menu-scrim></div>
    <div class="sheet" data-lenis-prevent>
      <ul class="sheet-links">
        {links.map((link, index) => (
          <li><a href={link.href} data-section-link={link.id} aria-current={link.route && pathname.startsWith(link.route) ? 'page' : undefined}><span class="index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span class="label">{link.label}</span></a></li>
        ))}
      </ul>
      {languages.length > 1 && <div class="sheet-languages" role="group" aria-label={strings.language}>
        {languages.map((language) => <a href={language.href} hreflang={language.hrefLang} lang={language.lang} data-locale-choice={language.lang} aria-current={language.current ? 'true' : undefined}>{language.name}</a>)}
      </div>}
      <div class="sheet-footer">
        <p class="availability"><span class="dot" aria-hidden="true"></span>{strings.availability}</p>
        {profileLinks.length > 0 && <ul class="profiles" aria-label={strings.elsewhere}>
          {profileLinks.map((link) => {
            const icon = profileIcons[link.label as keyof typeof profileIcons];
            return icon && <li><a href={link.href} rel="me noopener" aria-label={link.label}><Icon name={icon} size={icon === 'brand-x' ? 17 : 19} /></a></li>;
          })}
        </ul>}
      </div>
    </div>
  </div>
</header>
<script>
  import { glowCoverTop, GLOW_COVER_CHANGE } from './glow/cover';

  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (nav) {
    const sentinel = document.querySelector<HTMLElement>('[data-nav-sentinel]');
    const heroName = document.querySelector<HTMLElement>('#hero-name');
    if ('IntersectionObserver' in window) {
      if (sentinel) new IntersectionObserver(([entry]) => {
        nav.dataset.state = entry.intersectionRatio === 1 ? 'top' : 'scrolled';
      }, { threshold: 1 }).observe(sentinel);
    }
    if (heroName) {
      // The brand shows once the hero's name has left sight: less than a quarter of it is still seen between
      // the bottom of the bar and whatever covers it from below (the viewport's bottom, or the rising glow,
      // which covers the name while it is still on screen).
      if (document.documentElement.dataset.navLogoInitial === 'hidden') nav.dataset.logo = 'hidden';
      let frame = 0;
      const update = () => {
        frame = 0;
        const box = heroName.getBoundingClientRect();
        const nearest = Math.min(Math.max(innerWidth / 2, box.left), box.right);
        const top = Math.max(box.top, nav.offsetHeight);
        const bottom = Math.min(box.bottom, innerHeight, glowCoverTop(nearest) ?? Infinity);
        nav.dataset.logo = bottom - top > box.height * 0.25 ? 'hidden' : 'visible';
      };
      const schedule = () => { frame ||= requestAnimationFrame(update); };
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule);
      window.addEventListener(GLOW_COVER_CHANGE, schedule);
      update();
    }
    delete document.documentElement.dataset.navLogoInitial;
    const button = nav.querySelector<HTMLButtonElement>('.menu-toggle');
    const menu = nav.querySelector<HTMLElement>('#mobile-navigation');
    const root = document.documentElement;
    const desktop = matchMedia('(min-width: 48rem)');
    const isOpen = () => button?.getAttribute('aria-expanded') === 'true';
    /** Everything outside the header is inert while the sheet is open, so focus and clicks cannot leave it. */
    const setBackgroundInert = (inert: boolean) => {
      for (const child of Array.from(document.body.children)) {
        if (child === nav || child.id === 'announcements' || child.tagName === 'SCRIPT') continue;
        (child as HTMLElement).inert = inert;
      }
    };
    const setOpen = (open: boolean, returnFocus = true) => {
      if (!button || !menu || open === isOpen()) return;
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? button.dataset.closeLabel! : button.dataset.openLabel!);
      menu.hidden = !open;
      nav.dataset.menu = open ? 'open' : 'closed';
      root.toggleAttribute('data-menu-open', open);
      setBackgroundInert(open);
      if (open) menu.querySelector<HTMLElement>('.sheet a')?.focus();
      else if (returnFocus) button.focus();
    };
    button?.addEventListener('click', () => setOpen(!isOpen()));
    menu?.addEventListener('click', (event) => {
      const target = event.target as Element;
      if (target.closest('a')) setOpen(false, false);
      else if (target.hasAttribute('data-menu-scrim')) setOpen(false);
    });
    desktop.addEventListener('change', () => { if (desktop.matches) setOpen(false, false); });
    document.addEventListener('keydown', (event) => {
      if (!isOpen()) return;
      if (event.key === 'Escape') { event.preventDefault(); setOpen(false); return; }
      if (event.key !== 'Tab') return;
      const stops = Array.from(nav.querySelectorAll<HTMLElement>('a[href], button')).filter((el) => el.offsetParent !== null || el.closest('.sheet'));
      const first = stops[0];
      const last = stops[stops.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
    });
    // The pill behind the current desktop link: it slides between links and fades out when none is current
    // (the hero, an unlisted section, Contact, which is its own button).
    const pill = nav.querySelector<HTMLElement>('[data-nav-pill]');
    const placePill = () => {
      if (!pill) return;
      const link = nav.querySelector<HTMLElement>('.desktop-links > a[aria-current]');
      if (!link) {
        pill.dataset.visible = 'false';
        return;
      }
      // From hidden it appears in place (no slide in from the last link), then fades in.
      if (pill.dataset.visible !== 'true') pill.dataset.jump = '';
      pill.style.setProperty('--x', `${link.offsetLeft}px`);
      pill.style.setProperty('--w', `${link.offsetWidth}px`);
      void pill.offsetWidth;
      delete pill.dataset.jump;
      pill.dataset.visible = 'true';
    };
    placePill();
    document.fonts?.ready.then(placePill);
    window.addEventListener('resize', placePill);

    // Only Home's links point at sections on the page; elsewhere a link is current by its route (aria-current="page"),
    // even when that page reuses a section id (the Notes index has #notes and #contact).
    const sections = 'scrollSpy' in nav.dataset
      ? Array.from(document.querySelectorAll<HTMLElement>('#work, #experience, #notes, #contact'))
      : [];
    if (sections.length) {
      // The current section is the one crossing a line 30% down the viewport; in the hero or in a section
      // the nav does not list, none is. Recomputed on every scroll frame, so it clears as well as sets.
      const sectionLinks = Array.from(nav.querySelectorAll<HTMLAnchorElement>('[data-section-link]'));
      let current: string | null | undefined;
      let frame = 0;
      const update = () => {
        frame = 0;
        const line = innerHeight * 0.3;
        const crossing = sections.find((section) => {
          const box = section.getBoundingClientRect();
          return box.top <= line && box.bottom > line;
        });
        const id = crossing?.id ?? null;
        if (id === current) return;
        current = id;
        sectionLinks.forEach((link) => {
          if (link.dataset.sectionLink === id) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        });
        placePill();
      };
      const schedule = () => { frame ||= requestAnimationFrame(update); };
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule);
      update();
    }
  }
</script>
<style>
  .nav-sentinel { height: 1px; margin-bottom: -1px; pointer-events: none; }
  .site-nav { position: sticky; top: 0; z-index: 50; color: var(--color-heading); }
  :global(body:has([data-hero], #hero)) .site-nav { margin-bottom: -69px; }
  .site-nav::before { content: ''; position: absolute; inset: 0; background: var(--color-bg); border-bottom: 1px solid var(--color-border); opacity: 1; transition: opacity 240ms cubic-bezier(0.23, 1, 0.32, 1); pointer-events: none; }
  /* Back to floating (the top of the page) is slower and softer than docking: the bar fades and the row
     settles down over ~0.5s, where docking stays quick so the bar is there as soon as content scrolls under it. */
  .site-nav[data-state='top']::before { opacity: 0; transition: opacity 480ms cubic-bezier(0.25, 1, 0.5, 1); }
  @supports (backdrop-filter: blur(20px)) {
    .site-nav::before { background: light-dark(color-mix(in srgb, var(--color-bg) 82%, transparent), color-mix(in srgb, var(--color-bg) 78%, transparent)); backdrop-filter: blur(20px); }
  }
  @media (prefers-reduced-transparency: reduce) { .site-nav::before { background: var(--color-bg); backdrop-filter: none; } }
  .nav-inner { box-sizing: border-box; max-width: calc(var(--content-max) + 2 * var(--gutter-desktop)); margin-inline: auto; min-height: 69px; padding: var(--space-sm) var(--gutter-desktop); display: flex; align-items: center; gap: 2rem; transition: transform 240ms cubic-bezier(0.23, 1, 0.32, 1); }
  .site-nav[data-state='top'] .nav-inner { transform: translateY(25.5px); transition: transform 560ms cubic-bezier(0.25, 1, 0.5, 1); }
  a { color: inherit; text-decoration: none; }
  .brand { font-family: var(--font-display), sans-serif; font-size: 1.375rem; font-weight: 600; letter-spacing: -0.02em; margin-right: auto; white-space: nowrap; }
  .brand { opacity: 1; transform: translateY(0); visibility: visible; transition: opacity 240ms cubic-bezier(0.23, 1, 0.32, 1), transform 240ms cubic-bezier(0.23, 1, 0.32, 1), visibility 0s; }
  .site-nav[data-logo='hidden']:not([data-menu='open']) .brand { opacity: 0; transform: translateY(-4px); visibility: hidden; transition: opacity 180ms cubic-bezier(0.23, 1, 0.32, 1), transform 180ms cubic-bezier(0.23, 1, 0.32, 1), visibility 0s 180ms; }
  :global(html[data-nav-logo-initial='hidden']) .brand { opacity: 0; visibility: hidden; transition: none; }
  .brand-inside { display: none; font-family: var(--font-mono), monospace; font-size: 1.25rem; font-weight: 500; letter-spacing: 0; }
  :global([data-lens='inside']) .brand-outside { display: none; }
  :global([data-lens='inside']) .brand-inside { display: inline; }
  .desktop-links { display: flex; align-items: center; gap: 2rem; }
  /* Lang switch: Nav set 2185:122 — IBM Plex Mono 14, gap 6, current underlined. */
  .lang-switch { display: flex; align-items: center; gap: 6px; font-family: var(--font-mono), monospace; font-size: 0.875rem; color: var(--color-text-muted); white-space: nowrap; }
  .lang-switch a { padding-block: 4px; }
  .lang-switch a:hover { color: var(--color-heading); }
  .lang-switch [aria-current] { color: var(--color-heading); font-weight: 500; text-decoration: underline; text-underline-position: from-font; }
  .desktop-links a, .mobile-links a { position: relative; font-size: 1rem; font-weight: 500; }
  /* Current section: a soft pill (the tint of the mobile menu's current language) slides behind the link. */
  .desktop-links { position: relative; }
  .desktop-links > a { z-index: 1; }
  .pill {
    position: absolute;
    top: 50%;
    left: 0;
    height: 2.25rem;
    width: calc(var(--w, 0px) + 1.75rem);
    border-radius: 999px;
    background: light-dark(color-mix(in srgb, var(--color-heading) 8%, transparent), color-mix(in srgb, var(--color-heading) 12%, transparent));
    transform: translate(calc(var(--x, 0px) - 0.875rem), -50%);
    opacity: 0;
    pointer-events: none;
    transition: transform 420ms cubic-bezier(0.23, 1, 0.32, 1), width 420ms cubic-bezier(0.23, 1, 0.32, 1), opacity 200ms ease;
  }
  .pill[data-visible='true'] { opacity: 1; }
  .pill[data-jump] { transition: opacity 200ms ease; }
  @media (prefers-reduced-motion: reduce) { .pill { transition: opacity 120ms ease; } }
  .contact { border-radius: 999px; background: var(--color-accent); color: var(--color-accent-text); padding: var(--space-sm) var(--space-lg); font-size: 1rem; font-weight: 500; }
  .menu-toggle { display: none; width: 44px; height: 44px; padding: 0; align-items: center; justify-content: center; border: 1px solid color-mix(in srgb, var(--color-heading) 35%, transparent); border-radius: 50%; color: inherit; background: transparent; cursor: pointer; }
  .close-icon, [aria-expanded='true'] .menu-icon { display: none; }
  [aria-expanded='true'] .close-icon { display: block; }
  /* Mobile menu open state (boards 2349:86 / 2349:159). The header's backdrop-filter would trap the fixed scrim, so it is off while open. */
  .site-nav[data-menu='open']::before { opacity: 0; backdrop-filter: none; }
  .site-nav[data-menu='open'][data-state='scrolled'] .nav-inner { transform: translateY(9.5px); }
  .nav-inner { position: relative; z-index: 2; }
  :global(html[data-menu-open]) { overflow: hidden; }
  .mobile-menu { display: none; }
  .mobile-menu:not([hidden]) { display: block; }
  .scrim { position: fixed; inset: 0; z-index: 0; background: light-dark(color-mix(in srgb, var(--green-950) 32%, transparent), color-mix(in srgb, var(--green-950) 50%, transparent)); animation: menu-fade 200ms cubic-bezier(0.23, 1, 0.32, 1); }
  .sheet { position: fixed; top: 0; left: 0; right: 0; z-index: 1; max-height: 100dvh; overflow-y: auto; overscroll-behavior: contain; display: flex; flex-direction: column; padding: 108px var(--gutter-mobile) 40px; background: var(--color-card); color: var(--color-heading); border-radius: 0 0 28px 28px; box-shadow: 0 16px 40px color-mix(in srgb, var(--green-950) 18%, transparent); animation: menu-sheet 200ms cubic-bezier(0.23, 1, 0.32, 1); }
  .sheet ul { list-style: none; margin: 0; padding: 0; }
  .sheet-links { border-top: 1px solid var(--color-border); }
  .sheet-links li { border-bottom: 1px solid var(--color-border); }
  .sheet-links a { display: flex; align-items: center; gap: var(--space-md); padding-block: 14px; }
  .index { font-family: var(--font-mono), monospace; font-size: 0.8125rem; font-weight: 500; letter-spacing: 0.04em; color: var(--color-text-muted); }
  .label { font-family: var(--font-display), sans-serif; font-size: 2.5rem; line-height: 2.75rem; font-weight: 600; letter-spacing: -0.02em; }
  .sheet-links a[aria-current] .index { color: var(--color-heading); }
  .availability { display: flex; align-items: center; gap: 10px; margin: 0; font-size: 1rem; line-height: 22px; font-weight: 500; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-signal); flex: none; }
  .sheet-languages { display: flex; height: 44px; margin-top: 40px; border: 1px solid color-mix(in srgb, var(--color-heading) 35%, transparent); border-radius: 999px; }
  .sheet-languages a { position: relative; display: flex; flex: 1; align-items: center; justify-content: center; min-width: 0; min-height: 44px; margin-block: -1px; border-radius: 999px; font-family: var(--font-sans), sans-serif; font-size: 0.9375rem; font-weight: 500; color: color-mix(in srgb, var(--color-heading) 70%, transparent); }
  .sheet-languages a[aria-current] { color: var(--color-heading); background: light-dark(color-mix(in srgb, var(--color-heading) 8%, transparent), color-mix(in srgb, var(--color-heading) 12%, transparent)); }
  .sheet-footer { display: flex; flex-direction: column; gap: 20px; margin-top: 56px; }
  .profiles { display: flex; flex-wrap: wrap; gap: 12px; }
  .profiles a { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; border: 1px solid color-mix(in srgb, var(--color-heading) 35%, transparent); border-radius: 50%; }
  @keyframes menu-fade { from { opacity: 0; } }
  @keyframes menu-sheet { from { opacity: 0; transform: translateY(-16px); } }
  @media (prefers-reduced-motion: reduce) {
    .sheet { animation-name: menu-fade; }
    .site-nav::before, .site-nav[data-state='top']::before { transition: opacity 80ms; }
    .site-nav[data-state='top'] .nav-inner { transition: none; }
    .brand { transition: opacity 80ms, visibility 0s; }
    .site-nav[data-logo='hidden']:not([data-menu='open']) .brand { transform: none; transition: opacity 80ms, visibility 0s 80ms; }
    .nav-inner { transition: none; }
  }
  @media (min-width: 48rem) { .mobile-menu { display: none !important; } }
  @media (max-width: 47.99rem) {
    .nav-inner { padding-inline: var(--gutter-tablet); gap: var(--space-xs); }
    .desktop-links { display: none; }
    .menu-toggle { display: inline-flex; }
  }
  @media (min-width: 48rem) and (max-width: 64rem) { .site-nav[data-state='top'] .nav-inner { transform: translateY(17.5px); } .nav-inner { padding-inline: var(--gutter-tablet); gap: 2rem; } .desktop-links { gap: 2rem; } }
  @media (max-width: 47.99rem) { .site-nav[data-state='top'] .nav-inner { transform: translateY(9.5px); } .nav-inner { padding-inline: var(--gutter-mobile); } .brand { font-size: 1.25rem; } }
  @media (forced-colors: active) { .contact { border: 1px solid ButtonText; } }
</style>
