---
// Project page v1 (Figma `2443:12`): the lighter, openly technical page of a `tier: project` entry.
// Overview and the decision table follow the case study (CaseStudy.astro) so both pages read as one family.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { Dictionary } from '../../lib/i18n';
import Backgrounds from './Backgrounds.astro';
type Data = CollectionEntry<'projects'>['data'];
type Page = NonNullable<Data['page']>;
interface Props {
  page: Page;
  decisions: Data['decisions'];
  cover?: ImageMetadata;
  coverAlt?: string;
  website?: string;
  strings: Pick<Dictionary, 'caseStudy' | 'projectPage'>;
}
const { page, decisions, cover, coverAlt = '', website, strings } = Astro.props;
const t = strings.caseStudy;
const p = strings.projectPage;
const [head, ...rows] = page.how.table?.rows ?? [];
---
<article class="project-page">
  <section class="overview band">
    <Backgrounds variant="work" next="none" />
    <div class="container inner">
      {cover && <div class="browser"><div class="browser-bar"><i></i><i></i><i></i>{website && <span>{new URL(website).hostname}</span>}</div><Image src={cover} alt={coverAlt} /></div>}
      <p class="marker" data-background-text>{t.atAGlance}</p>
      <dl class="glance">{page.glance.map((fact) => <div><dt data-background-text>{fact.label}</dt><dd data-background-text>{fact.value}</dd></div>)}</dl>
    </div>
  </section>
  <section class="how band pale">
    <Backgrounds variant="experience" next="none" />
    <div class="container inner">
      <p class="marker" data-background-text>{p.howMarker}</p>
      <h2 data-background-text>{page.how.headline}</h2>
      {page.how.sub && <p class="sub" data-background-text>{page.how.sub}</p>}
      <ol class="steps">
        {page.how.steps.map((step, index) => (
          <li>
            <span class="number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3 data-background-text>{step.title}</h3>
            <p data-background-text>{step.text}</p>
            {step.formula && <pre class="formula"><code>{step.formula}</code></pre>}
          </li>
        ))}
      </ol>
      {page.how.table && (
        <figure class="table">
          <figcaption class="marker" data-background-text>{page.how.table.title}</figcaption>
          <div class="table-scroll">
            <table>
              <thead><tr>{head.map((cell) => <th scope="col">{cell}</th>)}</tr></thead>
              <tbody>{rows.map((row) => <tr>{row.map((cell, index) => (index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}</tr>)}</tbody>
            </table>
          </div>
          {page.how.table.note && <p class="note" data-background-text>{page.how.table.note}</p>}
        </figure>
      )}
    </div>
  </section>
  {decisions.length > 0 && (
    <section class="decisions band">
      <Backgrounds variant="work" next="none" />
      <div class="container inner">
        <p class="marker" data-background-text>{p.decisionMarker}</p>
        <h2 data-background-text>{page.decisionHeadline}</h2>
        <div class="table-head"><span>{t.choice}</span><span>{t.why}</span><span>{t.cost}</span></div>
        {decisions.slice(0, 2).map((d) => (
          <div class="decision">
            <div><span class="stack-label">{t.choice}</span><h3 data-background-text>{d.choice}</h3><small>{d.subtitle ?? `${p.insteadOf} ${d.rejected}`}</small></div>
            <div><span class="stack-label">{t.why}</span><p data-background-text>{d.because}</p></div>
            <div><span class="stack-label">{t.cost}</span><p data-background-text>{d.cost}</p></div>
          </div>
        ))}
      </div>
    </section>
  )}
</article>
<style>
  .band {
    position: relative;
    background: var(--cream);
    padding: 7.5rem 0;
  }
  .pale {
    background: var(--card);
  }
  .inner {
    position: relative;
  }
  /* Contain the negative margin so the section background never covers the hero. */
  .overview {
    padding-top: 0;
    padding-bottom: 7.5rem;
  }
  .overview .inner {
    display: flow-root;
  }
  .browser {
    position: relative;
    max-width: 72rem;
    container-type: inline-size;
    margin: -4rem auto 6rem;
    overflow: hidden;
    border-radius: 1rem;
    background: var(--card);
    box-shadow: 0 24px 64px color-mix(in srgb, var(--green-950) 18%, transparent);
  }
  .browser :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .browser-bar {
    height: clamp(12px, 3.472cqw, 40px);
    display: flex;
    align-items: center;
    gap: clamp(2px, 0.694cqw, 8px);
    padding: 0 clamp(6px, 1.736cqw, 20px);
    color: var(--green-700);
    font: clamp(4px, 1.042cqw, 12px) var(--font-mono);
  }
  .browser-bar i {
    width: clamp(3px, 0.868cqw, 10px);
    height: clamp(3px, 0.868cqw, 10px);
    border-radius: 50%;
    background: var(--green-300);
  }
  .browser-bar span {
    margin: auto;
  }
  .marker,
  dt,
  small,
  .number {
    font: 500 13px/1.5 var(--font-mono);
    color: var(--green-700);
  }
  .marker {
    margin: 0;
    line-height: 1;
  }
  h2 {
    max-width: 820px;
    font: 600 var(--font-size-heading-section)/1.1 var(--font-display);
    letter-spacing: -0.02em;
    margin: 1.25rem 0 1.25rem;
  }
  h3 {
    font: 600 var(--font-size-heading-sm)/1.12 var(--font-display);
    letter-spacing: -0.02em;
    margin: 0;
  }
  p {
    line-height: 1.5;
    margin: 0;
  }
  dl,
  dd {
    margin: 0;
  }
  .glance {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 24px;
    margin-top: 40px;
  }
  .glance > div {
    border-top: 1px solid var(--green-950);
    padding: 16px 24px 0 0;
  }
  .glance dd {
    font-size: 20px;
  }
  .sub {
    max-width: 720px;
    font-size: 1.125rem;
    color: var(--color-text);
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: 4rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 2rem;
  }
  .steps li {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  /* The formula card takes the experiment tiles' terminal look (WorkMore.astro). */
  .formula {
    margin: auto 0 0;
    padding: 1.125rem 1.25rem;
    border-radius: 12px;
    background: var(--green-950);
    color: var(--green-300);
    font: 500 14px/1.6 var(--font-mono);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .table {
    margin: 4.5rem 0 0;
  }
  .table-scroll {
    margin-top: 1.25rem;
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font: 400 14px/1.4 var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  th,
  td {
    padding: 14px 24px;
    text-align: left;
    white-space: nowrap;
  }
  thead th {
    background: color-mix(in srgb, var(--green-950) 6%, transparent);
    font-weight: 500;
  }
  tbody th {
    font-weight: 500;
  }
  tbody tr + tr {
    border-top: 1px solid var(--color-border);
  }
  .note {
    margin-top: 1rem;
    max-width: 900px;
    font-size: 15px;
  }
  .decisions h2 {
    margin-bottom: 3rem;
  }
  .table-head,
  .decision {
    display: grid;
    grid-template-columns: 1.05fr 1fr 1fr;
    gap: 2rem;
  }
  .table-head {
    font: 500 13px var(--font-mono);
    color: var(--green-700);
    padding-bottom: 10px;
  }
  .decision {
    border-top: 1px solid var(--color-border);
    padding: 28px 0;
  }
  .decision h3 {
    font-size: 26px;
    margin-bottom: 0.625rem;
  }
  .stack-label {
    display: none;
    font: 500 12px/1.5 var(--font-mono);
    color: var(--green-700);
    margin-bottom: 10px;
  }
  @media (max-width: 1024px) {
    .band {
      padding: 5rem 0;
    }
    .overview {
      padding-top: 0;
      padding-bottom: 5rem;
    }
    .browser {
      margin-bottom: 4rem;
    }
    .decision {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .table-head {
      display: none;
    }
    .stack-label {
      display: block;
    }
  }
</style>
