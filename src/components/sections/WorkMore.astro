---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getDictionary, type Dictionary, type Locale } from '../../lib/i18n';
import Backgrounds from './Backgrounds.astro';
import Icon from '../ui/Icon.astro';
import { repoStats } from '../../lib/github';
import { formatDate } from '../../lib/format';
interface Props { projects: CollectionEntry<'projects'>[]; experiments: CollectionEntry<'projects'>[]; lang: string; strings: Dictionary['work']; /** Project page URL by entry id, for the projects that have one (built by the page). */ pageHrefs: Record<string, string> }
const { projects, experiments, lang, strings: t, pageHrefs } = Astro.props;
// Every link in this section leaves the site: ↗ and a new tab, with the screen-reader note.
const newTab = getDictionary(lang as Locale).common.newTab;
const out = { target: '_blank', rel: 'noopener noreferrer' } as const;
const dict = getDictionary(lang as Locale);
// Live numbers from the GitHub API at build time; null when GitHub cannot be reached (the tile keeps its chips).
const stats = await Promise.all(experiments.map(({ data }) => repoStats(data.repoUrl)));
---
<section class="more">
  <Backgrounds variant="experience" next="none" />
  <div class="container inner">
    {projects.length > 0 && (
      <div>
        <p class="marker" data-background-text>{t.moreMarker}</p>
        <h2 data-background-text>{t.moreHeading}</h2>
        <p class="intro" data-background-text>{t.moreSub}</p>
        <div class="grid">
          {projects.map((entry) => { const { data } = entry; return (
            <article class="card">
              <div class="frame">
                <div class="bar" aria-hidden="true">● ● ●</div>
                <div class="capture">
                  {data.coverImage && <Image src={data.coverImage} alt={data.coverImageAlt ?? ''} />}
                </div>
              </div>
              <div class="body">
                {data.kind && <p class="marker">{data.kind}</p>}
                <h3>{data.title}</h3>
                <p>{data.description}</p>
                <div class="links">
                  {pageHrefs[entry.id] && <a class="internal" href={pageHrefs[entry.id]}>{dict.work.seeProject}<span aria-hidden="true">→</span></a>}
                  {data.demoUrl && <a href={data.demoUrl} {...out}>{data.demoLabel ?? t.live}<Icon name="arrow-up-right" size={15} /><span class="visually-hidden"> {newTab}</span></a>}
                  {data.repoUrl && <a href={data.repoUrl} {...out}>{t.code}<Icon name="arrow-up-right" size={15} /><span class="visually-hidden"> {newTab}</span></a>}
                </div>
              </div>
            </article>
          ); })}
        </div>
      </div>
    )}
    {experiments.length > 0 && (
      <div class="experiments">
        <p class="marker" data-background-text>{t.experimentsMarker}</p>
        <h2 data-background-text>{t.experimentsHeading}</h2>
        <div class="grid">
          {experiments.map(({ data }, index) => {
            const s = stats[index];
            return (
              <article class:list={['experiment', { 'has-peek': data.peekImage, 'has-stats': s }]}>
                <div class="text">
                  <p class="prompt">$ {data.kind ?? data.stack.join(' · ')}</p>
                  <h3 title={data.title}>{data.title}</h3>
                  <p class="description">{data.description}</p>
                  <div class="meta">
                    <ul class="chips">{data.stack.map((item) => <li>{item}</li>)}</ul>
                    {s && (
                      <p class="stats">
                        <span aria-hidden="true">★ {s.stars}   ⑂ {s.forks}{s.language && `   ${s.language}`}   {t.updated(formatDate(s.pushedAt, lang as Locale))}</span>
                        <span class="visually-hidden">{[t.stars(s.stars), t.forks(s.forks), s.language, t.updated(formatDate(s.pushedAt, lang as Locale))].filter(Boolean).join(', ')}</span>
                      </p>
                    )}
                    <span class="links">
                      {data.demoUrl && <a href={data.demoUrl} {...out}>{t.live}<Icon name="arrow-up-right" size={15} /><span class="visually-hidden"> {newTab}</span></a>}
                      {data.repoUrl && <a href={data.repoUrl} {...out}>{t.code}<Icon name="arrow-up-right" size={15} /><span class="visually-hidden"> {newTab}</span></a>}
                    </span>
                  </div>
                </div>
                {data.peekImage && (
                  <figure class="peek" aria-hidden="true">
                    <Image src={data.peekImage} alt="" widths={[268, 536]} sizes="268px" />
                    {data.peekCaption && <figcaption>{data.peekCaption}</figcaption>}
                  </figure>
                )}
              </article>
            );
          })}
        </div>
        <a href="https://github.com/trinity-bytes" {...out} data-background-text>{t.moreExperiments}<Icon name="arrow-up-right" size={15} /><span class="visually-hidden"> {newTab}</span></a>
      </div>
    )}
  </div>
</section>
<style>
  .more {
    position: relative;
    padding: 7.5rem 0;
    background: var(--color-bg);
  }
  .inner {
    position: relative;
  }
  .marker {
    font: 500 13px var(--font-mono);
    color: var(--color-text-muted);
  }
  h2 {
    font: 600 var(--font-size-heading-lg)/1.05 var(--font-display);
    margin: 12px 0;
  }
  h3 {
    font: 600 var(--font-size-heading-sm)/1.1 var(--font-display);
    margin: 10px 0;
  }
  .intro {
    max-width: 620px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 48px 0;
  }
  .card {
    background: var(--color-card);
    border-radius: 16px;
    overflow: hidden;
  }
  .frame {
    background: var(--color-surface);
    padding: 20px 20px 0;
  }
  .bar {
    background: var(--color-bg);
    color: var(--green-500);
    font: 10px var(--font-mono);
    padding: 8px;
    border-radius: 10px 10px 0 0;
  }
  .capture {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-border);
  }
  .capture :global(img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .body {
    padding: 28px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
  }
  /* External links: text, then the ↗ icon. */
  .links a,
  .experiments > a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  /* The card's main action: its project page on this site (→), as a button. */
  .links a.internal {
    gap: 8px;
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--green-950);
    color: var(--cream);
    text-decoration: none;
    font-weight: 500;
  }
  .links a.internal:hover {
    background: var(--green-800);
  }
  .experiments {
    margin-top: 7rem;
  }
  /* Experiments preview v2 (Figma `2442:12`, states `2524:2560`): the "peek" stays inside the tile. On
     hover or focus (desktop) the text column narrows, the README capture slides in from the right and the
     stats replace the chips. The tile's height is fixed there, so no state ever moves the grid. */
  .experiments .grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .experiment {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 0fr;
    min-height: 300px;
    padding: 28px 32px;
    border-radius: 16px;
    background: var(--green-950);
    color: var(--cream);
    border: 1px solid transparent;
    transition: grid-template-columns 200ms ease, border-color 200ms ease;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }
  .prompt,
  .chips li,
  .stats,
  .peek figcaption {
    font: 500 12px/1.5 var(--font-mono);
    color: var(--green-300);
  }
  .prompt,
  .description {
    margin: 0;
  }
  .experiment h3 {
    margin: 0;
    font: 500 clamp(22px, 2vw, 26px)/1.25 var(--font-mono);
    color: var(--cream);
  }
  .description {
    color: color-mix(in srgb, var(--cream) 82%, var(--green-300));
    line-height: 1.5;
  }
  .meta {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .chips li {
    padding: 3px 10px;
    border: 1px solid color-mix(in srgb, var(--green-300) 35%, transparent);
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .stats {
    display: none;
    margin: 0;
    white-space: pre;
  }
  .meta .links {
    margin-left: auto;
  }
  .experiment .links a {
    color: var(--cream);
  }
  .peek {
    margin: 0 0 0 0;
    min-width: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 8px;
    opacity: 0;
    transform: translateX(12px);
    transition: opacity 200ms ease, transform 200ms ease;
  }
  .peek :global(img) {
    display: block;
    width: 268px;
    max-width: 100%;
    flex: 1;
    min-height: 0;
    object-fit: cover;
    object-position: top center;
    border-radius: 10px;
    border: 1px solid color-mix(in srgb, var(--green-300) 30%, transparent);
    background: #13301a;
  }
  .peek figcaption {
    white-space: nowrap;
  }
  @media (hover: hover) {
    .experiment:is(:hover, :focus-within) {
      border-color: var(--green-300);
    }
  }
  /* Touch screens have no hover, and narrower tiles have no room: no peek, the chips stay. */
  @media (min-width: 1025px) {
    .experiment {
      height: 300px;
      grid-template-rows: minmax(0, 1fr);
    }
  }
  @media (hover: hover) and (min-width: 1025px) {
    .experiment.has-peek:is(:hover, :focus-within) {
      grid-template-columns: minmax(0, 1fr) min(268px, 42%);
      column-gap: 24px;
      padding-right: 16px;
    }
    .experiment:is(:hover, :focus-within) .peek {
      opacity: 1;
      transform: none;
    }
    .experiment.has-stats:is(:hover, :focus-within) .chips {
      display: none;
    }
    .experiment.has-stats:is(:hover, :focus-within) .stats {
      display: block;
    }
    /* The narrow column must not need more height: one line of title, three of description. */
    .experiment.has-peek:is(:hover, :focus-within) h3 {
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }
    .experiment.has-peek:is(:hover, :focus-within) .description {
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
      line-clamp: 3;
    }
    /* Stats, then the links on their own row (board 2524:2560). */
    .experiment.has-peek:is(:hover, :focus-within) .meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
    .experiment.has-peek:is(:hover, :focus-within) .meta .links {
      margin-left: 0;
    }
    .experiment.has-peek:is(:hover, :focus-within) .stats {
      white-space: pre-wrap;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .experiment,
    .peek {
      transition: none;
    }
    .peek {
      transform: none;
    }
  }
  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .more {
      padding: 6rem 0;
    }
  }
  @media (max-width: 767px) {
    .grid,
    .experiments .grid {
      grid-template-columns: 1fr;
    }
    .more {
      padding: 5rem 0;
    }
  }
</style>
