---
import Button from '../ui/Button.astro';
import TextLink from '../ui/TextLink.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getDictionary, type Dictionary, type Locale } from '../../lib/i18n';
import Backgrounds from './Backgrounds.astro';
import Icon from '../ui/Icon.astro';
import { repoStats } from '../../lib/github';
import { formatDate } from '../../lib/format';
interface Props { projects: CollectionEntry<'projects'>[]; experiments: CollectionEntry<'projects'>[]; lang: string; strings: Dictionary['work']; /** Project page URL by entry id, for the projects that have one (built by the page). */ pageHrefs: Record<string, string> }
const { projects, experiments, lang, strings: t, pageHrefs } = Astro.props;
// Every link in this section leaves the site: ↗ and a new tab, with the screen-reader note.
const newTab = getDictionary(lang as Locale).common.newTab;
const dict = getDictionary(lang as Locale);
// Live numbers from the GitHub API at build time; null when GitHub cannot be reached (the tile keeps its chips).
const stats = await Promise.all(experiments.map(({ data }) => repoStats(data.repoUrl)));
// The browser bar shows where the project lives. This site has no demo link (a visitor is already on
// it), so its card shows the site's own hostname: the project whose repository is named after it.
const siteHost = Astro.site?.hostname;
const barHost = (data: CollectionEntry<'projects'>['data']) =>
  data.demoUrl ? new URL(data.demoUrl).hostname
  : siteHost && data.repoUrl?.replace(/\/$/, '').endsWith(`/${siteHost}`) ? siteHost
  : undefined;
---
<section class="more">
  <Backgrounds variant="experience" next="none" />
  <div class="container inner">
    {projects.length > 0 && (
      <div>
        <p class="marker" data-background-text>{t.moreMarker}</p>
        <h2 data-background-text>{t.moreHeading}</h2>
        <p class="intro" data-background-text>{t.moreSub}</p>
        <div class="grid">
          {projects.map((entry) => { const { data } = entry; return (
            <article class="card">
              <div class="frame">
                <div class="bar" aria-hidden="true"><i></i><i></i><i></i>{barHost(data) && <span>{barHost(data)}</span>}</div>
                <div class="capture">
                  {data.coverImage && <Image src={data.coverImage} alt={data.coverImageAlt ?? ''} />}
                </div>
              </div>
              <div class="body">
                {data.kind && <p class="marker">{data.kind}</p>}
                <h3>{data.title}</h3>
                <p>{data.description}</p>
                <div class="links">
                  {pageHrefs[entry.id] && <Button href={pageHrefs[entry.id]} label={dict.work.seeProject} icon="arrow-right" />}
                  <span class="secondary-links">
                    {data.demoUrl && <TextLink destination="external" href={data.demoUrl} label={data.demoLabel ?? t.live} newTab={newTab} />}
                    {data.repoUrl && <TextLink destination="external" href={data.repoUrl} label={t.code} newTab={newTab} />}
                  </span>
                </div>
              </div>
            </article>
          ); })}
        </div>
      </div>
    )}
    {experiments.length > 0 && (
      <div class="experiments">
        <p class="marker" data-background-text>{t.experimentsMarker}</p>
        <h2 data-background-text>{t.experimentsHeading}</h2>
        <div class="grid">
          {experiments.map(({ data }, index) => {
            const s = stats[index];
            return (
              <article class:list={['experiment', { 'has-peek': data.peekImage, 'has-stats': s }]} data-surface="dark">
                <div class="text">
                  <p class="prompt">$ {data.kind ?? data.stack.join(' · ')}</p>
                  <h3 title={data.title}>{data.title}</h3>
                  <p class="description">{data.description}</p>
                  <div class="meta">
                    <ul class="chips">{data.stack.map((item) => <li>{item}</li>)}</ul>
                    {s && (
                      <p class="stats">
                        <span class="stat-values" aria-hidden="true"><span><Icon name="star" size={12} />{s.stars}</span><span><Icon name="git-fork" size={12} />{s.forks}</span>{s.language && <span>{s.language}</span>}<span>{t.updated(formatDate(s.pushedAt, lang as Locale))}</span></span>
                        <span class="visually-hidden">{[t.stars(s.stars), t.forks(s.forks), s.language, t.updated(formatDate(s.pushedAt, lang as Locale))].filter(Boolean).join(', ')}</span>
                      </p>
                    )}
                    <span class="links">
                      {data.demoUrl && <TextLink destination="external" href={data.demoUrl} label={t.live} newTab={newTab} />}
                      {data.repoUrl && <TextLink destination="external" href={data.repoUrl} label={t.code} newTab={newTab} />}
                    </span>
                  </div>
                </div>
                {data.peekImage && (
                  <figure class="peek" aria-hidden="true">
                    <Image src={data.peekImage} alt="" widths={[268, 536]} sizes="268px" />
                    {data.peekCaption && <figcaption>{data.peekCaption}</figcaption>}
                  </figure>
                )}
              </article>
            );
          })}
        </div>
        <TextLink destination="external" href="https://github.com/trinity-bytes" label={t.moreExperiments} newTab={newTab} data-background-text />
      </div>
    )}
  </div>
</section>
<style>
  .more {
    position: relative;
    padding: var(--section-pad) 0;
    background: var(--color-bg);
  }
  .inner {
    position: relative;
  }
  .marker {
    font: 500 13px var(--font-mono);
    color: var(--color-text-muted);
  }
  h2 {
    font: 600 var(--font-size-heading-lg)/1.05 var(--font-display);
    margin: var(--space-sm) 0;
  }
  h3 {
    font: 600 var(--font-size-h3)/1.15 var(--font-display);
    letter-spacing: -0.02em;
    margin: 10px 0;
  }
  .intro {
    max-width: 620px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 48px 0;
  }
  .card {
    display: flex;
    flex-direction: column;
    background: var(--color-card);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  /* Option B (owner 2026-11-26, components 2520:50 and 2522:481): the card is the browser window.
     The bar is the card's top edge and the capture fills the full width under it, no inset. */
  .frame {
    background: var(--color-surface);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: 36px; /* Browser-bar height has no token. */
    background: var(--color-bg);
    color: var(--green-500);
    font: var(--type-meta);
    padding: 0 var(--space-md);
  }
  .bar i {
    flex: none;
    width: var(--space-xs);
    height: var(--space-xs);
    border-radius: 50%;
    background: var(--green-500);
  }
  .bar span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .capture {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-border);
  }
  .capture :global(img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .body {
    padding: 28px var(--space-lg); /* 28px card inset has no token. */
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .body > .links {
    margin-top: auto;
  }
  .body > .marker {
    font: var(--type-meta);
    text-transform: uppercase;
  }
  .body h3, .experiment h3 {
    text-wrap: balance;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-xl);
  }
  .secondary-links { display: flex; flex-wrap: wrap; gap: var(--space-md); }
  .experiments {
    margin-top: 7rem;
  }
  /* Experiments preview v2 (Figma `2442:12`, states `2524:2560`): the "peek" stays inside the tile. On
     hover or focus (desktop) the text column narrows, the README capture slides in from the right and the
     stats replace the chips. The tile's height is fixed there, so no state ever moves the grid. */
  .experiments .grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .experiment {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 0fr;
    min-height: 300px;
    padding: 28px var(--space-2xl-b); /* 28px tile inset has no token. */
    border-radius: var(--radius-lg);
    background: var(--green-950);
    color: var(--cream);
    border: 1px solid transparent;
    transition: border-color var(--dur-ui) var(--ease-out);
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    min-width: 0;
  }
  .prompt,
  .chips li,
  .stats,
  .peek figcaption {
    font: var(--type-meta);
    color: var(--green-300);
  }
  .prompt,
  .description {
    margin: 0;
  }
  .experiment h3 {
    margin: 0;
    font: 600 var(--font-size-h3)/1.25 var(--font-display);
    color: var(--green-300);
  }
  .description {
    color: var(--green-300);
    line-height: 1.5;
  }
  .meta {
    position: relative;
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-md);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    list-style: none;
    margin: 0;
    padding: 0;
    transition: opacity var(--dur-ui) var(--ease-out), visibility var(--dur-ui);
  }
  .chips li {
    padding: 3px 10px;
    border: 1px solid color-mix(in srgb, var(--green-300) 35%, transparent);
    border-radius: var(--radius-full);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .stats {
    position: absolute;
    inset: 0 auto auto 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--dur-ui) var(--ease-out), visibility var(--dur-ui);
    margin: 0;
  }
  .stat-values { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-sm); }
  .stat-values > span { display: inline-flex; align-items: center; gap: var(--space-2xs); }
  .meta .links {
    margin-left: auto;
  }
  .experiment .links :global(a) {
    color: var(--green-300);
  }
  .experiment .links :global(.text-link-label) {
    text-decoration-color: var(--green-300);
  }
  .peek {
    margin: 0 0 0 0;
    min-width: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    opacity: 0;
    transform: translateX(var(--space-sm));
    transition: opacity var(--dur-ui) var(--ease-out), transform var(--dur-ui) var(--ease-out);
  }
  .peek :global(img) {
    display: block;
    width: 268px;
    max-width: 100%;
    flex: 1;
    min-height: 0;
    object-fit: cover;
    object-position: top center;
    border-radius: 10px;
    border: 1px solid color-mix(in srgb, var(--green-300) 30%, transparent);
    background: #13301a;
  }
  .peek figcaption {
    white-space: nowrap;
  }
  @media (hover: hover) {
    .experiment.has-peek:is(:hover, :focus-within) {
      border-color: var(--green-300);
    }
  }
  /* Touch screens have no hover, and narrower tiles have no room: no peek, the chips stay. */
  @media (min-width: 1025px) {
    .experiment {
      height: 300px;
      grid-template-rows: minmax(0, 1fr);
    }
    .experiment .text { gap: var(--space-md); }
    .experiment .meta { margin-top: 0; }
    .experiment .meta .links { margin-left: 0; }
  }
  @media (hover: hover) and (min-width: 1025px) {
    .experiment.has-peek:is(:hover, :focus-within) {
      grid-template-columns: minmax(0, 1fr) min(268px, 42%);
      column-gap: 24px;
      padding-right: var(--space-md);
    }
    .experiment:is(:hover, :focus-within) .peek {
      opacity: 1;
      transform: none;
    }
    .experiment.has-peek.has-stats:is(:hover, :focus-within) .chips {
      opacity: 0;
      visibility: hidden;
    }
    .experiment.has-peek.has-stats:is(:hover, :focus-within) .stats {
      opacity: 1;
      visibility: visible;
    }
    /* The narrow column must not need more height: one line of title, three of description. */
    .experiment.has-peek:is(:hover, :focus-within) h3 {
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }
    .experiment.has-peek:is(:hover, :focus-within) .description {
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
      line-clamp: 3;
    }
    /* Stats, then the links on their own row (board 2524:2560). */
    .experiment.has-peek:is(:hover, :focus-within) .meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-xs);
    }
    .experiment.has-peek:is(:hover, :focus-within) .meta .links {
      margin-left: 0;
    }
    .experiment.has-peek:is(:hover, :focus-within) .stats {
      white-space: pre-wrap;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .experiment,
    .peek,
    .chips,
    .stats {
      transition: none;
    }
    .peek {
      transform: none;
    }
  }
  @media (max-width: 1024px) {
    .experiment { min-height: 0; }
    .experiment .meta .links {
      margin-left: 0;
      flex-basis: 100%;
    }
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .experiments .grid { grid-template-columns: 1fr; }
  }
  @media (min-width: 768px) and (max-width: 1024px) {
    .body > .links { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 767px) {
    .grid,
    .experiments .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
