---
/*
 * Hero of the four non-Home pages (Work index 2239:18, case study 2298:3, Notes index 2304:2,
 * post 2303:3). Same layers as the Home hero (sky + far hills, display word, near hill) without
 * the portrait, and without the Inside state: these pages render Outside only (D21).
 *
 * The page's h1 is the display word on Work and Notes (the Home hero does the same with the name);
 * on the case study and the post the title is in the default slot and carries the h1 itself.
 * Paint order, back to front: sky, display word, near hill, intro.
 *
 * Layer geometry is taken per board: `work` and `post` share one landscape, `case` and `notes`
 * another (mirrored on desktop). Tablet and mobile use the Home hero's landscape for `case`.
 *
 * Covers (visual-design "Page covers v1", 2026-11-21): the Home keeps the sunset; these pages take
 * another hour of the same world so they read one step below it. Work: Andean terraces in the
 * morning. Notes and posts: early morning mist. Case study: a drafting desk by a window, one
 * full-bleed layer with cream scrims for the text and the nav, and no near hill. The near hill,
 * lit by the Home's sunset, is cooled with a filter to match the morning light.
 *
 * Parallax: on scroll the sky drifts slowest, the display word a little faster and the hill
 * fastest, all slower than the page. `--parallax` (the scroll offset in px, capped at the hero's
 * height) is read through `translate`, so the mirroring `transform` stays untouched. Reduced
 * motion: none.
 */
import { Picture } from 'astro:assets';
import workSky from '../../assets/covers/work-terraces.png';
import notesSky from '../../assets/covers/notes-mist.png';
import studyDesk from '../../assets/covers/study-desk.png';
import hill from '../../assets/hero/near-hill.png';

interface Props {
  variant: 'work' | 'case' | 'notes' | 'post';
  /** Display word drawn between the sky and the near hill (Work and Notes). It is the page's h1. */
  word?: string;
}
const { variant, word } = Astro.props;
const sky = { work: workSky, notes: notesSky, post: notesSky, case: studyDesk }[variant];
const isCase = variant === 'case';
---

<section class:list={['hero', variant]} data-hero aria-labelledby={word ? 'hero-word' : undefined}>
  <Picture
    src={sky}
    formats={['avif', 'webp']}
    widths={[768, 1440, 2400, 3400]}
    sizes="(min-width: 64.0625rem) 115vw, 260vw"
    alt=""
    class="layer sky"
    loading="eager"
    fetchpriority="high"
  />
  {word && <h1 id="hero-word" class="word">{word}</h1>}
  {isCase ? (
    <div class="scrim" aria-hidden="true" />
  ) : (
    <Picture
      src={hill}
      formats={['avif', 'webp']}
      widths={[768, 1440, 2400, 2952]}
      sizes="(min-width: 64.0625rem) 115vw, 310vw"
      alt=""
      class="layer hill"
      loading="eager"
    />
  )}
  <div class="intro"><slot /></div>
</section>

<style>
  /* Mobile first (390 boards); each layer is placed from the hero's centre so widths in between stay composed. */
  .hero {
    --word-size: 150px;
    --word-top: 508px;
    --word-right: 26px;
    --sky-w: 1381px;
    --sky-left: calc(50cqw - 434px);
    --sky-top: -214px;
    --hill-w: 735.947px;
    --hill-left: calc(50cqw - 271.581px);
    --hill-top: 249.223px;
    --intro-top: 100px;
    /* Left and right edge of the content: the page gutter, or the centred content column past 1440. */
    --edge: max(var(--gutter), (100cqw - var(--content-max)) / 2);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    container-type: inline-size;
    height: 701px;
    background: var(--color-light-sun);
  }
  .layer { position: absolute; display: block; max-width: none; height: auto; pointer-events: none; }
  .sky { width: var(--sky-w); left: var(--sky-left); top: var(--sky-top); translate: 0 calc(var(--parallax, 0) * 0.4px); }
  .hill { width: var(--hill-w); left: var(--hill-left); top: var(--hill-top); translate: 0 calc(var(--parallax, 0) * 0.12px); }
  .word { translate: 0 calc(var(--parallax, 0) * 0.24px); }

  /* The near hill is lit by the Home's sunset: cooled toward the morning of each cover. */
  .work .hill, .post .hill { filter: brightness(1.04) saturate(0.85) hue-rotate(6deg); }
  .notes .hill { filter: brightness(1.06) contrast(0.95) saturate(0.7) hue-rotate(8deg); }
  /* Work: the terraces sit lower than the sunset did, so the intro stays on the light sky. */
  .work { --sky-shift: 60px; }
  .work .sky { top: calc(var(--sky-top) + var(--sky-shift)); }

  /* Case study: one full-bleed interior, under cream scrims for the intro and the nav. */
  .case { background: var(--cream); }
  .case .sky { inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to bottom,
      color-mix(in srgb, var(--cream) 96%, transparent) 0%,
      color-mix(in srgb, var(--cream) 88%, transparent) 55%,
      color-mix(in srgb, var(--cream) 30%, transparent) 78%,
      color-mix(in srgb, var(--cream) 5%, transparent) 100%);
  }

  .word {
    position: absolute;
    right: var(--word-right);
    top: var(--word-top);
    margin: 0;
    color: var(--color-hero-name-fill);
    font: 500 var(--word-size) / 0.92 var(--font-display), sans-serif;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  .intro {
    position: absolute;
    top: var(--intro-top);
    left: var(--edge);
    right: var(--edge);
    max-width: 660px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    color: var(--color-hero-text);
  }
  .intro :global(p), .intro :global(h1) { margin: 0; }


  /* Intro parts shared by the four pages; the pages supply the markup. */
  .intro :global(.eyebrow) { font: 500 13px / 1.3 var(--font-mono), monospace; letter-spacing: 0.08em; text-transform: uppercase; }
  .intro :global(.headline) { max-width: 660px; font: 600 var(--font-size-heading-sm) / 1.15 var(--font-display), sans-serif; letter-spacing: -0.02em; color: var(--color-heading); }
  .intro :global(.sub) { max-width: 520px; font: 400 var(--font-size-body) / 1.5 var(--font-sans), sans-serif; }
  .intro :global(.title) { font: 600 2.125rem / 1.05 var(--font-display), sans-serif; letter-spacing: -0.02em; color: var(--color-heading); }
  .intro :global(.actions) { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  /* Mobile landscape of the case study and the post. */
  .case {
    --sky-w: 1981.415px;
    --sky-left: calc(50cqw - 735.812px);
    --sky-top: -372.209px;
    --hill-w: 2371.52px;
    --hill-left: calc(50cqw - 929.202px);
    --hill-top: -412.142px;
    --intro-top: 112px;
    height: 700px;
  }
  .notes { --word-size: 116px; --word-top: 539px; --word-right: 32px; }
  .post {
    --sky-top: -114px;
    --hill-top: 349.223px;
    --intro-top: 104px;
    height: 620px;
  }

  @media (min-width: 48rem) {
    .hero {
      --word-size: 250px;
      --word-top: 448px;
      --sky-w: 1356px;
      --sky-left: calc(50cqw - 554px);
      --sky-top: -203px;
      --hill-w: 864px;
      --hill-left: calc(50cqw - 417px);
      --hill-top: 202px;
      --intro-top: 136px;
      height: 702px;
    }
    .intro { max-width: 640px; }
    .intro :global(.sub) { font-size: 1.125rem; line-height: 1.4444; }
    .case .intro :global(.sub), .post .intro :global(.sub) { max-width: none; }
    .intro :global(.title) { font-size: 2.75rem; }
    .intro :global(.actions) { flex-direction: row; }
    .intro :global(.back) { min-height: 0; }
    .case {
      --sky-w: 2554.781px;
      --sky-left: calc(50cqw - 829.723px);
      --sky-top: -674.569px;
      --hill-w: 2831.111px;
      --hill-left: calc(50cqw - 872.667px);
      --hill-top: -704.71px;
      --intro-top: 150px;
      height: 745px;
    }
    .case .intro, .post .intro { max-width: none; }
    .scrim {
      background:
        linear-gradient(to bottom,
          color-mix(in srgb, var(--cream) 96%, transparent) 0%,
          color-mix(in srgb, var(--cream) 90%, transparent) 12%,
          color-mix(in srgb, var(--cream) 40%, transparent) 22%,
          transparent 32%),
        linear-gradient(to right,
          color-mix(in srgb, var(--cream) 94%, transparent) 0%,
          color-mix(in srgb, var(--cream) 85%, transparent) 55%,
          color-mix(in srgb, var(--cream) 10%, transparent) 85%,
          transparent 100%);
    }
    .notes { --word-size: 210px; --word-top: 485px; --word-right: 40px; }
    .post { --intro-top: 136px; height: 560px; }
  }

  @media (min-width: 64.0625rem) {
    .hero {
      --word-size: 300px;
      --word-top: 396px;
      --word-right: calc(var(--edge) - 31px);
      /* Sky and hill tops keep the sun (65.9% down the sky, ratio 0.6668) and the ridge (69% down the
         hill, ratio 0.7127) at the same height at every width; the px values are the 1440 board. */
      --sky-w: max(114.236cqw, (var(--edge) + 431px) / 0.301);
      --sky-left: calc(var(--edge) + 431px - var(--sky-w) * 0.301);
      --sky-top: min(0px, calc(438.9px - var(--sky-w) * 0.4394));
      --hill-w: 106.458cqw;
      --hill-left: -20px;
      --hill-top: calc(627.9px - 52.35cqw);
      --intro-top: 180px;
      height: 704px;
    }
    .intro { max-width: 660px; }
    .intro :global(.title) { font-size: 3.75rem; letter-spacing: -0.02em; }
    .intro :global(.sub) { line-height: 1.5; }
    .case .intro :global(.sub) { max-width: 520px; }
    /* Case study and Notes: the landscape is mirrored, so the sun sits on the right. */
    .case, .notes {
      --sky-w: 100cqw;
      --sky-left: 0px;
      --sky-top: min(0px, calc(417.8px - 43.94cqw));
      --hill-w: 112.292cqw;
      /* The hill PNG ends in a transparent strip (3.4% of its width); mirrored, it sits on the left. */
      --hill-left: min(-89px, -6cqw);
      --hill-top: calc(628.2px - 55.22cqw);
      height: 745px;
    }
    /* The covers are not mirrored (the study desk and the mist face the intro on their own); the hill still is. */
    .notes .hill { transform: scaleX(-1); }
    .work { --sky-shift: 154px; }
    .scrim {
      background:
        linear-gradient(to bottom,
          color-mix(in srgb, var(--cream) 96%, transparent) 0%,
          color-mix(in srgb, var(--cream) 90%, transparent) 13%,
          color-mix(in srgb, var(--cream) 55%, transparent) 22%,
          color-mix(in srgb, var(--cream) 15%, transparent) 32%,
          transparent 42%),
        linear-gradient(to right,
          color-mix(in srgb, var(--cream) 94%, transparent) 0%,
          color-mix(in srgb, var(--cream) 86%, transparent) 36%,
          transparent 62%);
    }
    .notes { --word-top: 437px; --word-right: var(--edge); }
    .case .intro { max-width: 660px; }
    .post .intro { max-width: 980px; }
    .post { --intro-top: 180px; height: 560px; }
  }

  /* Project pages (boards 2522:449, 2558:1666, 2558:2305): the title is Heading/H1 in the hero's green. */
  .hero.case .intro :global(.title) { font-size: var(--font-size-h1); line-height: 1.05; letter-spacing: -0.02em; color: var(--color-hero-text); }

  /* Notes index and post (boards 2520:151, 2522:1212, 2522:2234): the intro starts at the section
     padding, labels are muted and the sub takes the title colour for contrast (NL-05, NL-10). */
  .hero.notes, .hero.post { --intro-top: var(--section-pad); }
  .notes .intro { gap: var(--space-xl); }
  .notes .intro :global(.eyebrow) { color: var(--color-text-muted); }
  .notes .intro :global(.headline) { font-size: var(--font-size-h3); line-height: 1.15; }
  .hero:is(.notes, .post) .intro :global(.sub) { max-width: 35.625rem; color: var(--color-heading); font-size: var(--font-size-body); line-height: 1.5; }
  .hero.post .intro :global(.sub) { max-width: 44.375rem; }
  .post .intro { gap: var(--space-md); }
  .hero.post .intro :global(.title) { max-width: 53.125rem; font: 600 var(--font-size-h1) / 1.05 var(--font-display), sans-serif; letter-spacing: -0.02em; color: var(--color-heading); }
  .post .intro :global(.meta) { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-md); }
  /* The back link keeps its 44px in the layout, as drawn, instead of pulling its padding back. */
  .post .intro :global(.meta .meta-back) { margin-block: 0; }
  .post .intro :global(.meta-line) { font: var(--type-meta); letter-spacing: var(--type-meta-tracking); text-transform: uppercase; color: var(--color-text-muted); }
  @media (min-width: 48rem) {
    .post .intro :global(.meta) { flex-direction: row; align-items: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sky, .hill, .word { translate: none; }
  }
</style>

<script>
  // Parallax of the hero layers: writes the scroll offset, capped at the hero's height, to --parallax.
  const hero = document.querySelector<HTMLElement>('section.hero[data-hero]');
  const motion = window.matchMedia('(prefers-reduced-motion: no-preference)');
  if (hero) {
    let frame = 0;
    const update = () => {
      frame = 0;
      const offset = Math.min(Math.max(window.scrollY, 0), hero.offsetHeight);
      hero.style.setProperty('--parallax', String(Math.round(offset * 10) / 10));
    };
    const onScroll = () => { if (!frame) frame = requestAnimationFrame(update); };
    const toggle = () => {
      if (motion.matches) { window.addEventListener('scroll', onScroll, { passive: true }); update(); }
      else { window.removeEventListener('scroll', onScroll); hero.style.removeProperty('--parallax'); }
    };
    motion.addEventListener('change', toggle);
    toggle();
  }
</script>
