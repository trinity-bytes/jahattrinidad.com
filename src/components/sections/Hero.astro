---
/*
 * Home hero, both states. Paint order (visual-design design.md §5), back to front:
 * sky + far hills, display name, near hill, portrait. The layers are separate
 * elements so a depth effect can move them independently later.
 *
 * The page's h1 is the display name: it is the identity the board gives the most
 * weight, and the descriptor, headline and sub read right after it as its context.
 * On tablet and mobile the name overlaps the portrait, so an outline copy of it is
 * drawn above the portrait, masked to the portrait's alpha (board layer 05).
 *
 * Inside (design.md §5 "Inside differences") adds a dusk overlay right above the sky, a
 * dimmed sun, an outlined name, a darker near hill, the Inside copy, and the annotations:
 * side labels on desktop, numbered pins plus a notes band below the hero on tablet and
 * mobile. Everything that differs only in colour is a token (tokens.css) that flips with
 * the lens; copy that differs is rendered twice with data-show (design.md §2).
 *
 * The sky layer's position is kept in custom properties (--sky-*), so the sun pin and the
 * dimmed-sun mask follow it at every width.
 */
import { Picture, getImage } from 'astro:assets';
import sky from '../../assets/hero/sky.png';
import hill from '../../assets/hero/near-hill.png';
import portrait from '../../assets/hero/portrait.png';
import Icon from '../ui/Icon.astro';
import Annotation from '../ui/Annotation.astro';
import AnnotationList from '../ui/annotation/AnnotationList.astro';
import type { Dictionary } from '../../lib/i18n';

interface Props {
  strings: Dictionary['home']['outside']['hero'];
  insideStrings: Dictionary['home']['inside']['hero'];
  workHref: string;
}
const { strings, insideStrings, workHref } = Astro.props;

// Annotation order is the number shown on tablet and mobile.
const note = insideStrings.annotations;
const notes = [note.sky, note.hill, note.name, note.portrait];

const portraitMask = await getImage({ src: portrait, format: 'webp', width: 1040 });
---

<section
  class="hero"
  id="hero"
  data-hero
  aria-labelledby="hero-name"
  style={`--portrait-mask: url(${portraitMask.src})`}
>
  <Picture
    src={sky}
    formats={['avif', 'webp']}
    widths={[768, 1440, 2400, 3400]}
    sizes="(min-width: 64.0625rem) max(1993px, 139vw), 260vw"
    alt=""
    class="layer sky"
    loading="eager"
    fetchpriority="high"
  />
  <div class="dusk" data-show="inside" aria-hidden="true"></div>
  <div class="sun-mask" data-show="inside" aria-hidden="true"></div>
  <h1 id="hero-name" class="name">{strings.name}</h1>
  <Picture
    src={hill}
    formats={['avif', 'webp']}
    widths={[768, 1440, 2400, 2952]}
    sizes="(min-width: 64.0625rem) 124vw, 310vw"
    alt=""
    class="layer hill"
    loading="eager"
  />
  <Picture
    src={portrait}
    formats={['avif', 'webp']}
    widths={[300, 360, 520, 1040, 1400]}
    sizes="(min-width: 64.0625rem) 623px, (min-width: 48rem) 440px, 380px"
    alt=""
    class="layer portrait"
    loading="eager"
  />
  <div class="portrait-outline" aria-hidden="true">
    <span class="name">{strings.name}</span>
  </div>
  <div class="intro">
    <p class="eyebrow">{strings.eyebrow}</p>
    <p class="headline" data-show="outside">{strings.headline}</p>
    <p class="headline" data-show="inside">{insideStrings.headline}</p>
    <p class="sub" data-show="outside">{strings.sub}</p>
    <p class="sub" data-show="inside">{insideStrings.sub}</p>
    <a class="cta" data-magnetic href={workHref}>{strings.cta}<Icon name="arrow-right" size={18} /></a>
  </div>
  <p class="footnote">
    <span class="marker" data-show="inside">{insideStrings.marker}</span>
    <span class="hint" data-show="inside">{insideStrings.hint}<span aria-hidden="true"> ↑</span></span>
  </p>

  <div class="follow" data-follow="sky">
    <Annotation
      n={1}
      x="var(--sun-x)"
      y="var(--sun-y)"
      side="above"
      leader="max(0px, calc(var(--sun-y) - var(--name-top) + 49px))"
      {...note.sky}
    />
  </div>
  <div class="follow" data-follow="hill">
    <Annotation n={2} x="calc(var(--edge) + 419px)" y="calc(100% - 40px)" side="right" pinX="var(--hill-pin-x)" pinY="var(--hill-pin-y)" {...note.hill} />
  </div>
  <div class="follow" data-follow="name">
    <Annotation
      n={3}
      x="var(--name-label-x, calc(var(--edge) + 36px))"
      y="var(--name-top)"
      side="above"
      leader={49}
      pinX="var(--name-pin-x, var(--edge))"
      pinY="var(--name-pin-y, calc(var(--name-top) + var(--font-size-display) * 0.276))"
      bound={{
        x: 'var(--name-left, var(--edge))',
        y: 'var(--name-top)',
        width: 'calc(var(--font-size-display) * 2.69)',
        height: 'calc(var(--font-size-display) * 0.92)',
      }}
      {...note.name}
    />
  </div>
  <Annotation
    n={4}
    x="var(--portrait-left)"
    y="var(--portrait-label-y, calc(var(--portrait-top) + 230px))"
    side="left"
    pinX="var(--portrait-pin-x, calc(var(--portrait-left) + var(--portrait-w)))"
    pinY="var(--portrait-pin-y, calc(var(--portrait-top) + (100% - var(--portrait-top)) * 0.35))"
    bound={{ x: 'var(--portrait-left)', y: 'var(--portrait-top)', width: 'var(--portrait-w)', height: 'calc(100% - var(--portrait-top))' }}
    {...note.portrait}
  />
</section>
<AnnotationList items={notes} label={insideStrings.notesLabel} />

<style>
  .hero {
    /* Left and right edge of the content: the page gutter, or the centred content column past 1440 (as the sections below). */
    --edge: max(var(--gutter), (100cqw - var(--content-max)) / 2);
    --name-top: 628px;
    /* The portrait is 120px taller than the board (80px wider at 2:3, same top, same centre), so its
       legs run past the hero's bottom edge into the 120px ground bleed instead of ending over it. */
    --portrait-w: 380px;
    --portrait-left: calc(50cqw - 178px);
    --portrait-top: 412px;
    --sky-w: 1981.415px;
    --sky-left: calc(50cqw - 735.812px);
    --sky-top: -402.209px;
    /* Where the sun sits inside the sky image (30.1% across, 43.94% of the width down). */
    --sun-x: calc(var(--sky-left) + var(--sky-w) * var(--sun-image-x, 0.301));
    --sun-y: calc(var(--sky-top) + var(--sky-w) * var(--sun-image-y, 0.4394));
    /* Inside pin of the near hill on small screens: just below the name bound, at its right edge (mobile). */
    --hill-pin-x: calc(100cqw - var(--edge) - 3px);
    --hill-pin-y: calc(var(--name-top) + var(--font-size-display) * 0.92 - 1px);
    position: relative;
    isolation: isolate;
    /* Ground bleed: the layers keep painting 120px below the hero's box, under the transparent top
       band of Values (see Values.astro), so on the first pixels of scroll the strip under the fold is
       more grass, not the hero's straight bottom edge. By the time that edge would show, the rise
       glow already covers it. The layout height (and what fits in the viewport) is unchanged. */
    overflow-x: clip;
    overflow-y: visible;
    clip-path: inset(0 0 -120px 0);
    container-type: inline-size;
    height: 862px;
    background: var(--color-light-sun);
  }
  .layer { position: absolute; display: block; max-width: none; height: auto; pointer-events: none; }
  .sky { width: var(--sky-w); left: var(--sky-left); top: var(--sky-top); }
  .hill { width: 2371.52px; left: calc(50% - 929.202px); top: -412.142px; filter: var(--hero-hill-filter); }

  /* Inside: the dusk overlay sits directly above the sky; the mask dims the sun under it. */
  .dusk { position: absolute; inset: 0 0 -120px; background: var(--color-dusk); pointer-events: none; }
  .sun-mask {
    --size: calc(var(--sky-w) * 0.0224);
    position: absolute;
    left: calc(var(--sun-x) - var(--size) / 2);
    top: calc(var(--sun-y) - var(--size) / 2);
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    background: var(--dusk-sun);
    filter: blur(calc(var(--size) / 12));
    pointer-events: none;
  }
  .portrait { width: var(--portrait-w); left: var(--portrait-left); top: var(--portrait-top); }

  .name {
    position: absolute;
    left: var(--name-left, var(--edge));
    top: var(--name-top);
    margin: 0;
    color: var(--color-hero-name-fill);
    -webkit-text-stroke: var(--hero-stroke-width) var(--color-hero-name-stroke);
    font: 500 var(--font-size-display) / 0.92 var(--font-display), sans-serif;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  /* Same box as the portrait; the outline copy of the name is placed back in hero coordinates. */
  .portrait-outline {
    position: absolute;
    left: var(--portrait-left);
    top: var(--portrait-top);
    width: var(--portrait-w);
    aspect-ratio: 2 / 3;
    pointer-events: none;
    mask: var(--portrait-mask) center / 100% 100% no-repeat;
  }
  .portrait-outline .name {
    left: calc(var(--name-left, var(--edge)) - var(--portrait-left));
    top: calc(var(--name-top) - var(--portrait-top));
    color: transparent;
    -webkit-text-stroke: var(--hero-stroke-width) var(--color-hero-outline);
  }

  .intro {
    position: absolute;
    top: 100px;
    left: var(--edge);
    right: var(--edge);
    max-width: 660px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }
  .intro p { margin: 0; }
  /* Spacing groups the copy: the eyebrow labels the headline (16px), headline and sub are one message
     (20px), and the button is the next step, set apart (28px; 36px on desktop). */
  .intro .eyebrow { margin-bottom: -4px; }
  .intro .cta { margin-top: 8px; }
  .eyebrow { font: 500 13px / 1.3 var(--font-mono), monospace; letter-spacing: 0.065em; color: var(--color-hero-text); }
  .headline {
    font: 600 var(--font-size-heading-sm) / 1.15 var(--font-display), sans-serif;
    letter-spacing: -0.02em;
    color: var(--color-heading);
  }
  .sub { max-width: 520px; font: 400 var(--font-size-body) / 1.5 var(--font-sans), sans-serif; color: var(--color-hero-text); }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 49px;
    padding: 14px 24px;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-accent-text);
    font: 500 16px / 1.3 var(--font-sans), sans-serif;
    text-decoration: none;
  }
  .cta:hover { text-decoration: underline; }

  .footnote {
    position: absolute;
    left: var(--edge);
    bottom: 19px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 166px;
    color: var(--color-hero-footnote);
    font: 400 12px / 1.33 var(--font-mono), monospace;
  }
  .marker { font-weight: 500; letter-spacing: 0.08em; }
  .hint-arrow { display: none; }

  @media (min-width: 48rem) {
    .hero {
      --name-top: 530px;
      --portrait-w: 440px;
      --portrait-left: calc(50cqw - 28px);
      --portrait-top: 327px;
      height: 867px;
    }
    .hero {
      --sky-w: 2554.781px;
      --sky-left: calc(50cqw - 829.723px);
      --sky-top: -704.569px;
      --hill-pin-x: calc(var(--edge) + 14px);
      --hill-pin-y: calc(var(--name-top) + var(--font-size-display) * 0.92 + 8px);
    }
    .hill { width: 2831.111px; left: calc(50% - 872.667px); top: -704.71px; }
    .intro { top: 136px; max-width: 600px; }
    .footnote { bottom: 18px; max-width: none; flex-direction: row; gap: 32px; }
  }

  @media (min-width: 64.0625rem) {
    .hero {
      --font-size-display: 270px;
      --hero-h: clamp(840px, 100vh, 1250px);
      --hero-h: clamp(840px, 100svh, 1250px);
      --name-top: calc(var(--hero-h) - 347px);
      --name-left: calc(var(--edge) - 11px);
      --name-label-x: calc(var(--name-left) + 32px);
      --name-pin-x: calc(var(--name-left) + 32px);
      --name-pin-y: var(--name-top);
      --portrait-w: 623px;
      --portrait-left: calc(100cqw - var(--edge) - 539px);
      /* Bottom-anchored (cropped by the hero bottom), but never above y 85 (the board), so the head
         stays clear of the nav links on short screens; there the crop just goes deeper. */
      --portrait-top: max(85px, calc(var(--hero-h) - 815px));
      --portrait-pin-x: var(--portrait-left);
      --portrait-pin-y: calc(var(--portrait-top) + 335px);
      /* Pin 335px below the portrait top: y 420 on the 900px board, never higher, so the label stays below the intro copy. */
      --portrait-label-y: calc(var(--portrait-top) + 335px);
      /* Board: sky (-120, -350), 1993 × 1329; sun (479, 529), 371px above the bottom.
         Grow only to cover the horizontal edges or the top; the board width retains the bottom bleed. */
      --sun-image-x: 0.3005519318;
      --sun-image-y: 0.4410436528;
      --sky-w: max(1993px, (var(--edge) + 415px) / var(--sun-image-x), (100cqw - var(--edge) - 415px) / (1 - var(--sun-image-x)), (var(--hero-h) - 371px) / var(--sun-image-y));
      --sky-left: calc(var(--edge) + 415px - var(--sky-w) * var(--sun-image-x));
      --sky-top: calc(var(--hero-h) - 371px - var(--sky-w) * var(--sun-image-y));
      --hill-w: 123.1944444cqw;
      --hill-left: -2.6388889cqw;
      --hill-top: calc(var(--hero-h) - 147.5669919px - 60.5856256cqw);
      --hill-pin-x: calc(var(--hill-left) + var(--hill-w) * 0.3145434047);
      --hill-pin-y: calc(var(--hill-top) + var(--hill-w) * 0.5400225479);
      height: var(--hero-h);
    }
    /* The 1774 × 1264 hill starts at (-38, -120); keep its 69% ridge at the same height. */
    .hill { width: var(--hill-w); left: var(--hill-left); top: var(--hill-top); }
    .portrait { height: 935px; }
    .intro { top: 180px; max-width: 660px; }
    .intro .cta { margin-top: 16px; }
    .footnote { bottom: 42px; }
    .hint-arrow { display: inline; }
  }

  @media (forced-colors: active) { .cta { border: 1px solid ButtonText; } }

  /* Inside annotations that ride with a parallax layer: a transparent box the size of the hero, so the
     annotation inside keeps its hero coordinates (and the hero stays its container for cqw). */
  .follow { position: absolute; inset: 0; pointer-events: none; }

  /* Pointer parallax: --mx / --my (-1..1, the pointer's place in the viewport, eased by script).
     The big name tilts toward the pointer in perspective (2.5D) and shifts slightly; nothing else
     moves with the pointer. Only individual properties (`translate`, `rotate`), so they add to the GSAP
     transforms of the load and the scroll parallax; !important because GSAP writes `translate: none;
     rotate: none` inline on every element it transforms. The outline copy of the name (inside the
     portrait's box) gets the same tilt from the same perspective point, so the two stay registered. */
  .hero {
    --mx: 0;
    --my: 0;
    --name-cx: calc(var(--name-left, var(--edge)) + var(--font-size-display) * 1.345);
    --name-cy: calc(var(--name-top) + var(--font-size-display) * 0.46);
    perspective: 1100px;
    perspective-origin: var(--name-cx) var(--name-cy);
  }
  .portrait-outline {
    perspective: 1100px;
    perspective-origin: calc(var(--name-cx) - var(--portrait-left)) calc(var(--name-cy) - var(--portrait-top));
  }
  [data-follow='name'] { translate: calc(var(--mx) * 14px) calc(var(--my) * 8px) !important; }
  .name {
    translate: calc(var(--mx) * 14px) calc(var(--my) * 8px) !important;
    rotate: calc(var(--my) * -1) calc(var(--mx) + 0.0001) 0 calc(hypot(var(--mx), var(--my)) * 14deg) !important;
  }

  /* Load choreography: starting states while html[data-hero-intro] is set (see the inline script).
     The hero is clipped to nothing (the page surface shows, never the hero's own fill) until the sun circle opens it. */
  :global(html[data-hero-intro]) .hero { clip-path: circle(0px at 50% 60%); }
  :global(html[data-hero-intro]) .name { transform: translateY(55%); }
  :global(html[data-hero-intro]) .portrait,
  :global(html[data-hero-intro]) .intro > *,
  :global(html[data-hero-intro]) .footnote { opacity: 0; }
  :global(html[data-hero-intro] [data-nav]) { opacity: 0; }
  :global(html[data-hero-intro] [data-lens-dock]) { opacity: 0; }
</style>

<script is:inline>
  // Mark the page before first paint so the load choreography starts from its first frame, not after a flash.
  // Only at the top of a fresh load, with motion allowed; a safety timeout releases everything if the script below never runs.
  if (window.scrollY === 0 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.dataset.heroIntro = '';
    setTimeout(() => delete document.documentElement.dataset.heroIntro, 3500);
  }
</script>

<script>
  /*
   * Hero motion (GSAP):
   *   Load: the sky settles, "Jahat" rises from behind the hill (it is painted under the near hill),
   *         then the portrait, the intro lines (staggered), the footnote and the nav.
   *   Scroll: depth by lag. Far layers fall behind the page as the hero leaves (sky most, name less);
   *         the hill and the portrait move with the page, since the portrait is cropped by the hero's
   *         bottom and must never rise past it. The sun sinks as you scroll down.
   * Reduced motion: neither runs. Only transform and opacity are animated.
   */
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const root = document.documentElement;
  const hero = document.querySelector<HTMLElement>('#hero:not([data-lens-preview] *)');

  if (hero) {
    const q = (selector: string) => Array.from(hero.querySelectorAll<HTMLElement>(selector));
    const sky = q('.sky');
    const sunMask = q('.sun-mask');
    const followSky = q('[data-follow="sky"]');
    const followName = q('[data-follow="name"]');
    const names = q('.name');
    const hill = q('.hill');
    const followHill = q('[data-follow="hill"]');
    const portrait = q('.portrait');
    const intro = q('.intro > *');
    const footnote = q('.footnote');
    const nav = document.querySelector<HTMLElement>('[data-nav]');
    // The nav's own items, left to right, for the intro's one-by-one entrance (only the visible ones:
    // the brand is hidden at load on the Home, the desktop links and the menu button swap by width).
    const navItems = nav
      ? Array.from(nav.querySelectorAll<HTMLElement>('.brand, .desktop-links > a, .lang-switch, .contact, .menu-toggle'))
          .filter((item) => item.offsetParent !== null && getComputedStyle(item).visibility !== 'hidden')
      : [];
    const media = gsap.matchMedia();

    /** The sun's centre in hero coordinates, from the same --sun-x / --sun-y the Inside annotations use. */
    function sunCentre(): { x: number; y: number } {
      const probe = document.createElement('div');
      probe.style.cssText = 'position:absolute;left:var(--sun-x);top:var(--sun-y);width:0;height:0';
      hero!.append(probe);
      const box = hero!.getBoundingClientRect();
      const point = probe.getBoundingClientRect();
      probe.remove();
      return { x: point.left - box.left, y: point.top - box.top };
    }

    /**
     * Load: a circle the size of the sun opens from the sun until it covers the hero (expo.inOut, an
     * After Effects-style easy ease). Each text block appears only once the circle encloses all of it,
     * so nothing is seen sliced by the edge; the name rises from behind the hill as the circle reaches it.
     */
    async function playIntro() {
      const image = sky[0] instanceof HTMLImageElement ? sky[0] : null;
      // Start only once the sky can paint (or after a short wait), so the circle never opens on an empty fill.
      await Promise.race([image?.decode?.().catch(() => {}), new Promise((done) => setTimeout(done, 700))]);

      const box = hero!.getBoundingClientRect();
      const sun = sunCentre();
      const far = (x: number, y: number) => Math.hypot(x - sun.x, y - sun.y);
      const startRadius = 22;
      const endRadius = Math.max(far(0, 0), far(box.width, 0), far(0, box.height), far(box.width, box.height));
      const duration = 1.6;
      const ease = gsap.parseEase('expo.inOut');
      /** Seconds until the circle's radius reaches `distance` (inverts the ease by bisection). */
      const reach = (distance: number) => {
        const target = (distance - startRadius) / (endRadius - startRadius);
        if (target <= 0) return 0;
        if (target >= 1) return duration;
        let low = 0;
        let high = 1;
        for (let i = 0; i < 24; i++) {
          const mid = (low + high) / 2;
          if (ease(mid) < target) low = mid;
          else high = mid;
        }
        return high * duration;
      };
      /** Distance from the sun to the farthest corner of an element (it is fully inside the circle past this). */
      const enclosed = (element: HTMLElement) => {
        const r = element.getBoundingClientRect();
        if (!r.width) return null;
        const left = r.left - box.left;
        const top = r.top - box.top;
        return Math.max(far(left, top), far(left + r.width, top), far(left, top + r.height), far(left + r.width, top + r.height));
      };

      const circle = { r: startRadius };
      const timeline = gsap.timeline({
        onComplete: () => {
          delete root.dataset.heroIntro;
          window.dispatchEvent(new CustomEvent('hero-intro-done'));
          hero!.style.clipPath = '';
          // Inline opacity stays until here: the starting CSS still applies while html[data-hero-intro] is set.
          gsap.set([...portrait, ...intro, ...footnote, nav, document.querySelector('[data-lens-dock]')], { clearProps: 'opacity' });
          // GSAP writes `translate: none` with a y tween; clear it so the magnetic Contact keeps its own.
          gsap.set(navItems, { clearProps: 'opacity,transform,translate' });
        },
      });
      timeline.to(circle, {
        r: endRadius,
        duration,
        ease: 'expo.inOut',
        onUpdate: () => { hero!.style.clipPath = `circle(${circle.r}px at ${sun.x}px ${sun.y}px)`; },
      }, 0);
      // Scale the sky around the sun itself, so the sun stays centred in the opening circle.
      const skyBox = image?.getBoundingClientRect();
      const origin = skyBox ? `${sun.x - (skyBox.left - box.left)}px ${sun.y - (skyBox.top - box.top)}px` : '50% 50%';
      timeline.fromTo(sky, { scale: 1.04, transformOrigin: origin }, { scale: 1, duration: duration + 0.6, ease: 'power2.out' }, 0);

      const nameAt = Math.min(...names.map((name) => { const d = enclosed(name); return d === null ? Infinity : reach(d * 0.7); }));
      // y: 0 explicitly: GSAP would otherwise read the CSS starting translateY(55%) as a px y and keep it.
      timeline.fromTo(names, { y: 0, yPercent: 55 }, { y: 0, yPercent: 0, duration: 1.1, ease: 'expo.out' }, Number.isFinite(nameAt) ? nameAt : 0.4);
      // The portrait steps up into place (it is cropped by the hero's bottom, so it reads as entering the frame).
      // It starts as soon as the circle touches its near edge and travels long and evenly enough to be seen;
      // its opacity completes early so what reads is the movement, not a fade.
      const portraitBox = portrait[0]?.getBoundingClientRect();
      const portraitAt = portraitBox
        ? reach(far(portraitBox.left - box.left + portraitBox.width * 0.25, portraitBox.top - box.top + portraitBox.height * 0.4))
        : 0.5;
      timeline
        .fromTo(portrait, { y: 160 }, { y: 0, duration: 1.6, ease: 'power3.out' }, portraitAt)
        .fromTo(portrait, { opacity: 0 }, { opacity: 1, duration: 0.6, ease: 'power1.out' }, portraitAt);
      for (const element of [...intro, ...footnote]) {
        const distance = enclosed(element);
        timeline.fromTo(element, { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' }, distance === null ? duration : reach(distance));
      }
      // The nav comes in item by item, each dropping softly from above, left to right.
      if (nav) {
        timeline.set(nav, { opacity: 1 }, duration - 0.3);
        timeline.fromTo(navItems, { opacity: 0, y: -18 }, { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out', stagger: 0.08 }, duration - 0.3);
      }
      // The lens dock is fixed to the viewport, outside the hero: it pops in when the circle reaches it.
      const dock = document.querySelector<HTMLElement>('[data-lens-dock]');
      const lensButton = dock?.querySelector<HTMLElement>('[data-lens-open]');
      if (dock && lensButton) {
        const d = lensButton.getBoundingClientRect();
        const at = reach(far(d.left - box.left + d.width / 2, d.top - box.top + d.height / 2));
        timeline
          .fromTo(dock, { opacity: 0 }, { opacity: 1, duration: 0.35, ease: 'power1.out' }, at)
          // The lens scales through its own --scale (its transform also carries the drag offset).
          .fromTo(lensButton, { '--scale': 0.4 }, { '--scale': 1, duration: 0.7, ease: 'back.out(2.2)', clearProps: '--scale' }, at);
      }
    }

    media.add('(prefers-reduced-motion: no-preference)', () => {
      if ('heroIntro' in root.dataset) void playIntro();

      // Scroll parallax, scrubbed over the hero's exit. Values are fractions of the hero's height:
      // the farther the layer, the more it lags. The portrait, nearest, moves with the page (it never
      // rises, so its cut never shows); the hill lags a little behind it, so the two read as planes.
      const parallax = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: 0.4, invalidateOnRefresh: true },
      });
      parallax
        .to([...sky, ...sunMask, ...followSky], { y: () => hero.offsetHeight * 0.35 }, 0)
        .to([...names, ...followName], { y: () => hero.offsetHeight * 0.18 }, 0)
        .to([...hill, ...followHill], { y: () => hero.offsetHeight * 0.08 }, 0);

      return () => delete root.dataset.heroIntro;
    });

    // Pointer parallax (mouse and pen only, see the --mx / --my styles): eased toward the pointer, back to rest when it leaves the window.
    media.add('(prefers-reduced-motion: no-preference) and (pointer: fine)', () => {
      const pointer = { x: 0, y: 0 };
      const paint = () => {
        hero.style.setProperty('--mx', pointer.x.toFixed(4));
        hero.style.setProperty('--my', pointer.y.toFixed(4));
      };
      const toX = gsap.quickTo(pointer, 'x', { duration: 1.2, ease: 'power3.out', onUpdate: paint });
      const toY = gsap.quickTo(pointer, 'y', { duration: 1.2, ease: 'power3.out', onUpdate: paint });
      const follow = (event: PointerEvent) => {
        if (event.pointerType === 'touch' || scrollY > hero.offsetHeight) return;
        toX((event.clientX / innerWidth) * 2 - 1);
        toY((event.clientY / innerHeight) * 2 - 1);
      };
      const rest = () => { toX(0); toY(0); };
      window.addEventListener('pointermove', follow, { passive: true });
      root.addEventListener('pointerleave', rest);
      return () => {
        window.removeEventListener('pointermove', follow);
        root.removeEventListener('pointerleave', rest);
        gsap.killTweensOf(pointer);
        hero.style.removeProperty('--mx');
        hero.style.removeProperty('--my');
      };
    });

    // The lens and the hero's viewport-based height move the trigger; keep it current.
    new MutationObserver(() => ScrollTrigger.refresh()).observe(root, { attributes: true, attributeFilter: ['data-lens'] });
  }
</script>
