---
import type { CollectionEntry } from 'astro:content';
import PostRow from '../content/PostRow.astro';
import Backgrounds from './Backgrounds.astro';
import Icon from '../ui/Icon.astro';
import { formatDate } from '../../lib/format';
import type { Dictionary } from '../../lib/i18n';
import { entryPath } from '../../lib/paths';

interface ElsewhereItem {
  platform: string;
  /** Already formatted. */
  date: string;
  excerpt: string;
  href: string;
}

interface Props {
  lang: 'en' | 'es';
  marker: string;
  headline: string;
  strings: Dictionary['notes'];
  /** From listPosts, newest first: the first one is featured. */
  posts: { entry: CollectionEntry<'posts'>; readingTime: number }[];
  /** Where "All writing" goes. */
  allWritingHref: string;
  /** Posts published elsewhere. The column is left out when there are none. */
  elsewhere?: ElsewhereItem[];
  seed?: number;
}

const { lang, marker, headline, strings, posts, allWritingHref, elsewhere = [], seed = 5 } = Astro.props;
const [featured, ...rest] = posts;
const typeLabel = (type: 'essay' | 'tutorial') => strings[type];
const postHref = (entry: CollectionEntry<'posts'>) => entryPath('posts', lang, entry.id);
---
<section id="notes" class="notes" aria-labelledby="notes-heading">
  <Backgrounds variant="notes" next="none" seed={seed} />
  <div class="layout">
    <header>
      <div class="title">
        <p class="marker" data-background-text>{marker}</p>
        <h2 id="notes-heading" data-background-text>{headline}</h2>
      </div>
      <a class="all" href={allWritingHref} data-background-text>{strings.allWriting}<span aria-hidden="true">→</span></a>
    </header>
    <div class="columns">
      <div class="writing">
        <h3 class="label" data-background-text>{strings.writingLatest}</h3>
        {featured && (
          <PostRow
            featured
            href={postHref(featured.entry)}
            title={featured.entry.data.title}
            description={featured.entry.data.description}
            type={featured.entry.data.type}
            typeLabel={typeLabel(featured.entry.data.type)}
            meta={`${strings.minutes(featured.readingTime)} read · ${formatDate(featured.entry.data.publishDate, lang)}`}
          />
        )}
        {rest.length > 0 && (
          <ul class="rows">
            {rest.map(({ entry, readingTime }) => (
              <li>
                <PostRow href={postHref(entry)} title={entry.data.title} type={entry.data.type} typeLabel={typeLabel(entry.data.type)} meta={strings.minutes(readingTime)} />
              </li>
            ))}
          </ul>
        )}
      </div>
      {elsewhere.length > 0 && (
        <div class="elsewhere">
          <h3 class="label" data-background-text>{strings.elsewhereLatest}</h3>
          <ul>
            {elsewhere.map((item) => (
              <li>
                <a href={item.href}>
                  <span class="source"><span data-background-text>{item.platform}</span><span data-background-text>{item.date}<Icon name="arrow-up-right" size={12} /></span></span>
                  <span class="excerpt" data-background-text>{item.excerpt}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </div>
</section>
<style>
  .notes { position: relative; background: var(--color-surface); }
  .layout { position: relative; max-width: calc(var(--content-max) + 2 * var(--gutter)); margin-inline: auto; padding: 4.5rem var(--gutter); display: flex; flex-direction: column; gap: 3.5rem; }
  header { display: flex; flex-direction: column; align-items: flex-start; }
  .title { display: flex; flex-direction: column; gap: var(--space-sm); }
  .marker { margin: 0; font: 500 0.8125rem/1.3 var(--font-mono); color: var(--color-text-muted); }
  h2 { margin: 0; font: 600 var(--font-size-heading-lg)/1.05 var(--font-display); letter-spacing: -0.02em; color: var(--color-heading); }
  .all { display: inline-flex; align-items: center; gap: var(--space-xs); min-height: 2.75rem; font: 500 1.125rem/1.3 var(--font-sans); color: var(--color-heading); text-decoration: underline; text-underline-offset: 0.2em; }
  .columns { display: flex; flex-direction: column; gap: 3.5rem; }
  .writing { min-width: 0; }
  .label { margin: 0; padding-bottom: var(--space-md); font: 500 var(--font-size-label)/1.33 var(--font-mono); text-transform: uppercase; color: var(--color-text-muted); }
  .rows, .elsewhere ul { margin: 0; padding: 0; list-style: none; }
  .rows { margin-top: var(--space-xl); }
  .elsewhere a { display: flex; flex-direction: column; gap: 0.375rem; padding-block: var(--space-lg); border-top: 1px solid var(--color-heading); color: var(--color-heading); text-decoration: none; }
  .elsewhere a:hover .excerpt, .elsewhere a:focus-visible .excerpt { text-decoration: underline; }
  .source { display: flex; justify-content: space-between; gap: var(--space-md); font: 400 var(--font-size-label)/1.33 var(--font-mono); color: var(--color-text-muted); }
  .source > :first-child { font-weight: 500; }
  .source :global(svg) { margin-left: var(--space-xs); vertical-align: -1px; }
  .excerpt { font: 400 1.125rem/1.45 var(--font-sans); }
  @media (min-width: 48rem) {
    .layout { padding-block: 6rem; }
  }
  @media (min-width: 64.0625rem) {
    .layout { padding-block: 7.5rem; }
    header { flex-direction: row; align-items: flex-end; justify-content: space-between; }
    .columns { flex-direction: row; gap: 4rem; align-items: flex-start; }
    .writing { flex: 1; }
    .elsewhere { flex: none; width: 27.5rem; }
  }
</style>
