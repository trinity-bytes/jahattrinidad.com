---
import TextLink from '../ui/TextLink.astro';
import { getDictionary, type Locale } from '../../lib/i18n';
import type { CollectionEntry } from 'astro:content';
import PostRow from '../content/PostRow.astro';
import Backgrounds from './Backgrounds.astro';
import Annotation from '../ui/Annotation.astro';
import AnnotationList from '../ui/annotation/AnnotationList.astro';
import { formatDate } from '../../lib/format';
import type { Dictionary } from '../../lib/i18n';
import { entryPath } from '../../lib/paths';

interface ElsewhereItem {
  platform: string;
  href: string;
}

interface Props {
  lang: Locale;
  /** Locale of the listed posts; differs from `lang` while posts are English-only. */
  postsLang: Locale;
  marker: string;
  headline: string;
  strings: Dictionary['notes'];
  /** The Inside lens's copy: its marker replaces `marker`, and it carries the annotations. */
  inside: Dictionary['home']['inside']['notes'];
  /** From listPosts, newest first: the first one is featured. */
  posts: { entry: CollectionEntry<'posts'>; readingTime: number }[];
  /** Where "All writing" goes. */
  allWritingHref: string;
  /** Profiles elsewhere. The column is left out when there are none. */
  elsewhere?: ElsewhereItem[];
  seed?: number;
  index?: boolean;
}

const { lang, postsLang, marker, headline, strings, inside, posts, allWritingHref, elsewhere = [], seed = 5, index = false } = Astro.props;
const dictionary = getDictionary(lang);
const newTab = dictionary.common.newTab;
const [featured, ...rest] = posts;
const typeLabel = (type: 'essay' | 'tutorial') => strings[type];
const note = inside.annotations;
// Numbers shown on tablet and mobile: the chip needs a featured post, the rows a second one.
const notes = [note.feed, ...(featured ? [note.collection] : []), ...(rest.length > 0 ? [note.callSite] : [])];
const postHref = (entry: CollectionEntry<'posts'>) => entryPath('posts', postsLang, entry.id);
---
<section id="notes" class:list={["notes", { index }]} aria-labelledby="notes-heading">
  <Backgrounds variant="notes" next="none" seed={seed} />
  <div class="layout">
    <header>
      <div class="title">
        <p class="marker" data-background-text data-show="outside" data-reveal="text">{marker}</p>
        <p class="marker" data-background-text data-show="inside" data-reveal="text">{inside.marker}</p>
        <h2 id="notes-heading" data-background-text data-reveal="text">{headline}</h2>
      </div>
      {index
        ? <TextLink href={allWritingHref} destination="external" label={strings.rssFeed} newTab={newTab} data-background-text data-reveal />
        : <TextLink href={allWritingHref} label={strings.allWriting} data-background-text data-reveal />}
    </header>
    <div class="columns">
      <div class="writing">
        <div class="label-wrap" data-reveal>
          <h3 class="label" data-background-text>{index ? strings.latest : strings.writingLatest}</h3>
          {!index && <Annotation
            n={1}
            x="calc(100% + 6px)"
            y="50%"
            pinX="calc(100% + 6px)"
            pinY="-6px"
            bound={{ x: '-6px', y: '-6px', width: 'calc(100% + 12px)', height: 'calc(100% + 12px)' }}
            {...note.feed}
          />}
        </div>
        {featured && (
          <div class="featured-card" data-reveal>
          <PostRow
            featured
            detailed={index}
            href={postHref(featured.entry)}
            title={featured.entry.data.title}
            description={featured.entry.data.description}
            type={featured.entry.data.type}
            typeLabel={typeLabel(featured.entry.data.type)}
            meta={`${formatDate(featured.entry.data.publishDate, lang)} · ${dictionary.post.readingTime(featured.readingTime)}`}
          />
          {/* Inside: the type chip sits inside the card's link, so its annotation anchors to an invisible copy of the chip. */}
          {!index && <div class="chip-anchor" data-show="inside">
            <span class="chip-size" aria-hidden="true">{typeLabel(featured.entry.data.type)}</span>
            <Annotation
              n={2}
              x="calc(100% + 4px)"
              y="50%"
              pinX="calc(100% + 4px)"
              pinY="-4px"
              bound={{ x: '-4px', y: '-4px', width: 'calc(100% + 8px)', height: 'calc(100% + 8px)' }}
              {...note.collection}
            />
          </div>}
          </div>
        )}
        {rest.length > 0 && (
          <div class="rows-wrap">
            <ul class="rows" data-reveal-children>
              {rest.map(({ entry, readingTime }) => (
                <li>
                  <PostRow href={postHref(entry)} title={entry.data.title} type={entry.data.type} typeLabel={typeLabel(entry.data.type)} detailed={index} meta={`${formatDate(entry.data.publishDate, lang)} · ${dictionary.post.readingTime(readingTime)}`} />
                </li>
              ))}
            </ul>
            {!index && <Annotation
              n={3}
              x="36px"
              y="calc(100% + 4px)"
              side="below"
              leader={24}
              pinX="-4px"
              pinY="-4px"
              bound={{ x: '-4px', y: '-4px', width: 'calc(100% + 8px)', height: 'calc(100% + 8px)' }}
              {...note.callSite}
            />}
          </div>
        )}
      </div>
      {elsewhere.length > 0 && (
        <div class="elsewhere">
          <h3 class="label" data-background-text data-reveal>{strings.elsewhereLatest}</h3>
          <ul data-reveal-children>
            {elsewhere.map((item) => (
              <li><TextLink href={item.href} destination="external" label={item.platform} newTab={newTab} data-background-text /></li>
            ))}
          </ul>
        </div>
      )}
    </div>
    {!index && <AnnotationList class="notes" items={notes} label={inside.notesLabel} />}
  </div>
</section>
<style>
  .notes { position: relative; background: var(--color-surface); }
  .notes.index { background: var(--color-bg); }
  .layout { position: relative; max-width: calc(var(--content-max) + 2 * var(--gutter)); margin-inline: auto; padding: var(--section-pad) var(--gutter); display: flex; flex-direction: column; gap: var(--space-3xl); }
  header { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-md); }
  .title { display: flex; flex-direction: column; gap: var(--space-sm); }
  .marker { margin: 0; font: var(--type-marker); letter-spacing: var(--type-marker-tracking); text-transform: uppercase; color: var(--color-text-muted); }
  h2 { margin: 0; font: 600 var(--font-size-heading-lg)/1.05 var(--font-display); letter-spacing: -0.02em; color: var(--color-heading); }
  .columns { display: flex; flex-direction: column; gap: 3.5rem; }
  .writing { min-width: 0; }
  .label-wrap { position: relative; width: fit-content; margin-bottom: var(--space-sm); }
  .label { margin: 0; font: var(--type-meta); letter-spacing: var(--type-meta-tracking); text-transform: uppercase; color: var(--color-text-muted); }
  .featured-card, .rows-wrap { position: relative; }
  .rows-wrap { margin-top: var(--space-xl); }
  .rows, .elsewhere ul { margin: 0; padding: 0; list-style: none; }
  .layout > :global(.notes) { padding: 0; }
  .chip-anchor { position: absolute; left: var(--post-card-pad-x); top: var(--post-card-pad-y); }
  /* Same box as the chip in PostRow. */
  .chip-size { display: block; padding: var(--space-2xs) var(--space-xs); border: 1px solid transparent; font: var(--type-meta); letter-spacing: var(--type-meta-tracking); text-transform: uppercase; visibility: hidden; }

  /* Notes index (boards 2520:167 and 2522:878): one 32px step between every block. */
  .index .layout { gap: var(--space-2xl-b); }
  .index header, .index .title { gap: var(--space-2xl-b); }
  .index h2 { font-size: var(--font-size-h2); line-height: 1.1; }
  .index .columns { gap: var(--space-2xl-b); }
  .index .label-wrap { margin-bottom: var(--space-2xl-b); }
  .index .featured-card { --post-card-pad-x: var(--space-lg); --post-card-pad-y: var(--space-lg); }
  .index .rows { display: flex; flex-direction: column; gap: var(--space-2xl-b); }
  .index .rows-wrap { margin-top: var(--space-2xl-b); }
  .elsewhere, .elsewhere ul { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-2xl-b); }

  @media (min-width: 64.0625rem) {
    header { flex-direction: row; align-items: flex-end; justify-content: space-between; }
    .columns { flex-direction: row; gap: 4rem; align-items: flex-start; }
    .writing { flex: 1; }
    .index header { flex-direction: column; align-items: flex-start; justify-content: flex-start; }
    .index .writing { flex: 0 1 42.5rem; }
    .index .elsewhere { flex: none; width: 18.75rem; }
  }
</style>
