---
import type { Locale } from '../../lib/i18n';
import type { CollectionEntry } from 'astro:content';
import ExperienceRow from '../content/ExperienceRow.astro';
import Backgrounds from './Backgrounds.astro';
import AnnotationList from '../ui/annotation/AnnotationList.astro';
import { formatPeriod } from '../../lib/format';
import type { Dictionary } from '../../lib/i18n';

interface Props {
  lang: Locale;
  marker: string;
  headline: string;
  sub: string;
  strings: Dictionary['experience'];
  /** The Inside lens's copy; its headline, sub and marker replace the three above. */
  inside: Dictionary['home']['inside']['experience'];
  /** From listExperience(lang), already ordered. */
  entries: CollectionEntry<'experience'>[];
  seed?: number;
}

const { lang, marker, headline, sub, strings, inside, entries, seed = 4 } = Astro.props;

const groups = (['work', 'volunteering', 'beyond-class'] as const)
  .map((group) => ({ group, label: strings.groups[group], items: entries.filter((entry) => entry.data.group === group) }))
  .filter(({ items }) => items.length > 0);

const carriesOver = entries
  .flatMap((entry) => (entry.data.carriesOver ? [entry.data.carriesOver] : []))
  .sort((a, b) => a.order - b.order);

// Inside tool notes, numbered in reading order (the number shown on tablet and mobile).
const noted = groups.flatMap(({ items }) => items).filter((entry) => entry.data.toolNote);
const notes = noted.map((entry) => entry.data.toolNote!);
const noteOf = (entry: CollectionEntry<'experience'>) => {
  const n = noted.indexOf(entry) + 1;
  return n > 0 ? { n, ...entry.data.toolNote! } : undefined;
};
---
<section id="experience" class="experience" aria-labelledby="experience-heading">
  <Backgrounds variant="experience" next="surface" seed={seed} />
  <div class="layout">
    <div class="intro">
      <p class="marker" data-background-text data-show="outside" data-reveal="text">{marker}</p>
      <p class="marker" data-background-text data-show="inside" data-reveal="text">{inside.marker}</p>
      <h2 id="experience-heading" data-background-text data-reveal="text"><span data-show="outside">{headline}</span><span data-show="inside">{inside.headline}</span></h2>
      <p class="sub" data-background-text data-show="outside" data-reveal="text">{sub}</p>
      <p class="sub" data-background-text data-show="inside" data-reveal="text">{inside.sub}</p>
      {carriesOver.length > 0 && (
        <div class="carries" data-reveal>
          <h3 class="carries-label" data-background-text><span data-show="outside">{strings.carriesOver}</span><span data-show="inside">{inside.carriesOver}</span></h3>
          <ul>
            {carriesOver.map((item) => (
              <li>
                <p class="carries-title" data-background-text data-show="outside">{item.title}</p>
                <p class="carries-title" data-background-text data-show="inside">{item.insideTitle ?? item.title}</p>
                {/* The line breaks before its date range, never inside it. */}
                <p class="carries-from" data-background-text>{item.from.slice(0, item.from.lastIndexOf(' ') + 1)}<span class="dates">{item.from.slice(item.from.lastIndexOf(' ') + 1)}</span></p>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
    <div class="groups">
      {groups.map(({ group, label, items }) => (
        <div class="group" data-reveal>
          <h3 class="group-label" data-background-text>{label}</h3>
          <ul>
            {items.map((entry) => (
              <ExperienceRow
                period={formatPeriod(entry.data.start, entry.data.end, lang, strings.now)}
                role={entry.data.role}
                organisation={entry.data.organisation}
                description={entry.data.description}
                tags={entry.data.tags}
                image={entry.data.image}
                imageAlt={entry.data.imageAlt}
                toolNote={noteOf(entry)}
              />
            ))}
          </ul>
        </div>
      ))}
    </div>
    {notes.length > 0 && <AnnotationList class="notes" items={notes} label={inside.notesLabel} />}
  </div>
</section>
<style>
  .experience { position: relative; background: var(--color-bg); }
  .layout { position: relative; max-width: calc(var(--content-max) + 2 * var(--gutter)); margin-inline: auto; padding: var(--section-pad) var(--gutter); display: flex; flex-direction: column; gap: var(--space-3xl); }
  .intro { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-md); }
  .marker { margin: 0 0 calc(var(--space-sm) - var(--space-md)); font: var(--type-marker); letter-spacing: var(--type-marker-tracking); text-transform: uppercase; color: var(--color-text-muted); }
  h2 { margin: 0; font: 600 var(--font-size-h2)/1.1 var(--font-display); letter-spacing: -0.02em; color: var(--color-heading); }
  .sub { margin: 0; max-width: 22.5rem; font: 400 var(--font-size-body)/1.5 var(--font-sans); color: var(--color-text); }
  .carries { width: 100%; padding-top: var(--space-xl); }
  .carries-label { margin: 0; padding-bottom: var(--space-sm); font: var(--type-meta); letter-spacing: var(--type-meta-tracking); text-transform: uppercase; color: var(--color-text-muted); }
  .carries ul, .group ul { margin: 0; padding: 0; list-style: none; }
  .carries li { display: flex; flex-direction: column; gap: var(--space-2xs); padding-block: var(--space-md); border-top: 1px solid var(--color-border); }
  .carries-title { margin: 0; font: 600 var(--font-size-h5)/1.25 var(--font-display); letter-spacing: -0.02em; color: var(--color-heading); }
  .layout > :global(.notes) { padding: 0; }
  .carries-from { margin: 0; font: 400 var(--font-size-caption)/1.4 var(--font-sans); color: var(--color-text-muted); }
  .dates { white-space: nowrap; }
  .groups { display: flex; flex-direction: column; gap: var(--space-3xl); min-width: 0; }
  .group-label { display: flex; align-items: center; gap: var(--space-xs); margin: 0; padding-bottom: var(--space-sm); font: var(--type-meta); letter-spacing: var(--type-meta-tracking); text-transform: uppercase; color: var(--color-text-muted); }
  .group-label::before { content: ''; width: 0.375rem; height: 0.375rem; border-radius: 50%; background: var(--color-signal); }
  @media (min-width: 64.0625rem) {
    .layout { flex-direction: row; gap: var(--space-4xl); align-items: flex-start; }
    .intro { flex: none; width: 26.25rem; position: sticky; top: 7.5rem; }
    .carries-from { max-width: 21rem; }
    .groups { flex: 1; }
  }
</style>
