---
import Button from '../../ui/Button.astro';
import Icon from '../../ui/Icon.astro';
import { getDictionary, type Locale } from '../../../lib/i18n';
/*
 * The Contact composer and the conversation it grows into (task 7.3, boards 2353:103 to 2354:320,
 * tablet 2358:302, desktop 2358:226). One element: idle it is the composer with its suggestions;
 * on the first message or chip the client (chat-client.ts) sets `data-open` and it becomes the card.
 * Every message, summary and button the script produces is cloned from the <template>s below so the
 * scoped styles reach it; the conversation logic itself lives in src/lib/chat/engine.ts.
 *
 * Without JavaScript the controls stay disabled and the section's "Copy my email" and mailto
 * fallback are the way in.
 */
import { Image } from 'astro:assets';
import photo from '../../../assets/profile/jahat.jpg';
import { CONTACT_EMAIL, GARDEN_CASE_STUDY, WEB3FORMS_ACCESS_KEY } from '../../../lib/consts';
import { cvPath } from '../../../lib/cv';
import { collectionPath, entryPath } from '../../../lib/paths';
import type { Dictionary } from '../../../lib/i18n';

interface Props {
  lang: Locale;
  strings: Dictionary['contact'];
  chat: Dictionary['chat'];
}

const { lang, strings, chat } = Astro.props;
const ui = chat.ui;
const script = chat.script;
const garden = entryPath('projects', lang, GARDEN_CASE_STUDY);
const work = collectionPath('projects', lang);
---
<div
  class="chat"
  data-chat
  data-reveal
  data-lang={lang}
  data-email={CONTACT_EMAIL}
  data-key={WEB3FORMS_ACCESS_KEY}
  data-garden={garden}
  data-work={work}
  data-cv={cvPath(lang)}
  data-copied={strings.copied}
  data-placeholder={chat.composerPlaceholder}
  data-placeholder-short={chat.composerPlaceholderShort}
  data-mode="idle"
  role="group"
  aria-label={ui.cardLabel}
>
  <div class="head" data-card-part>
    <Image class="avatar" src={photo} alt="" width={40} height={40} widths={[40, 80, 120]} sizes="40px" loading="lazy" />
    <div class="who">
      <p class="name">{ui.author}</p>
      <p class="status"><span class="dot" aria-hidden="true"></span>{ui.status}</p>
    </div>
  </div>
  <div class="pinned" data-card-part>
    <p class="label">{ui.youWrote}</p>
    <p class="first" data-pinned></p>
  </div>
  <div class="log" data-lenis-prevent data-card-part data-log role="log" aria-live="polite" aria-relevant="additions" aria-label={ui.logLabel}></div>
  <div class="area">
    <form class="composer" data-form novalidate>
      <div class="field">
        <input type="text" name="message" data-input autocomplete="off" aria-label={strings.composerLabel} placeholder={chat.composerPlaceholder} disabled />
        <button type="submit" class="send" aria-label={strings.send} disabled>
          <Icon name="send" sizing="control" />
        </button>
        <slot name="annotation" />
      </div>
      {/* Honeypot: people never see or fill it; bots that tick it are dropped by Web3Forms. */}
      <input type="checkbox" name="botcheck" data-botcheck class="trap" tabindex="-1" autocomplete="off" aria-hidden="true" />
    </form>
    <ul class="chips" data-chips aria-label={chat.suggestionsLabel}>
      {script.idle.chips.map((chip) => (
        <li><Button type="button" variant="secondary" label={chip.label} data-chip={chip.value} disabled /></li>
      ))}
    </ul>
    <p class="note" data-note>{ui.privacy}</p>
  </div>

  <template data-tpl="chip"><li><Button type="button" variant="secondary" label="" data-chip /></li></template>
  <template data-tpl="bot"><div class="msg bot"><div class="bubble"><p></p></div></div></template>
  <template data-tpl="visitor"><div class="msg visitor"><div class="bubble"><p></p></div></div></template>
  <template data-tpl="typing"><div class="msg bot" data-typing><div class="bubble typing"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="visually-hidden">{ui.typing}</span></div></div></template>
  <template data-tpl="error"><div class="msg bot" data-transient><div class="bubble error"><Icon name="alert-circle" size={18} /><p></p></div></div></template>
  <template data-tpl="sent"><div class="msg bot"><div class="bubble sent"><Icon name="check" size={18} /><p></p></div></div></template>
  <template data-tpl="next"><ul class="next"></ul></template>
  <template data-tpl="step"><li><Button href="#" variant="secondary" label="" icon="arrow-right" /></li></template>
  {/* A step that leaves the site (the CV PDF): ↗, a new tab and the screen-reader note. */}
  <template data-tpl="step-out"><li><Button href="#" variant="secondary" label="" newTab={getDictionary(lang).common.newTab} /></li></template>
  <template data-tpl="summary">
    <div class="block" data-block data-state="summary">
      <div class="card">
        <p class="label">{script.summary.title}</p>
        <ul class="rows"></ul>
      </div>
      <div class="confirm">
        <Button type="button" label={script.summary.confirm} data-confirm />
        <Button type="button" class="sending" label={script.summary.sending} icon="loader" data-sending aria-disabled="true" />
      </div>
    </div>
  </template>
  <template data-tpl="row">
    <li class="row">
      <div class="text"><p class="key"></p><p class="value"></p></div>
      <button type="button" class="pencil" data-edit><Icon name="pencil" sizing="control" /></button>
    </li>
  </template>
  <template data-tpl="actions">
    <div class="actions" data-transient>
      <Button type="button" label={script.failed.retry} icon="rotate-ccw" data-retry />
      <Button type="button" variant="secondary" label={script.failed.copy} icon="copy" data-copy><span data-copy-label>{script.failed.copy}</span></Button>
    </div>
  </template>
</div>
<script>
  import { initChat } from './chat-client';
  initChat();
</script>
<style>
  /* Idle: the composer of Contact section 2516:702 (Composer 2515:570). Open: ChatCard 2519:1180,
     one 16px inset, Label/Meta for every label, 44px controls. */
  .chat { display: flex; flex-direction: column; width: 100%; color: var(--color-heading); }
  .head, .pinned, .log { display: none; }
  .area { display: flex; flex-direction: column; gap: var(--space-sm); }
  .field { position: relative; display: flex; align-items: center; justify-content: space-between; gap: var(--space-sm); height: 4rem; padding: 0 var(--space-xs) 0 1.75rem; border: 1px solid var(--color-heading); border-radius: var(--radius-full); background: var(--color-card); }
  input[type='text'] { flex: 1; min-width: 0; text-overflow: ellipsis; border: 0; background: none; font: 400 1.125rem/1.5 var(--font-sans); color: var(--color-heading); }
  input[type='text']::placeholder { color: var(--color-placeholder); opacity: 1; }
  input[type='text']:focus-visible { outline: none; }
  .field:has(input:focus-visible) { outline: var(--focus-width) solid var(--color-focus); outline-offset: var(--focus-offset); }
  .send { display: grid; place-items: center; flex: none; width: 3rem; height: 3rem; padding: 0; border: 0; border-radius: 50%; background: var(--color-accent); color: var(--color-accent-text); cursor: pointer; transition: background-color var(--dur-press) var(--ease-out), scale var(--dur-press) var(--ease-out); }
  /* The paper plane's weight sits up and to the right: nudged for optical centring. */
  .send :global(svg) { translate: -1px 1px; }
  .send:not(:disabled):active { background: var(--color-accent-hover); scale: 0.97; }
  .trap { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .chips { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin: 0; padding: 0; list-style: none; }
  .chips:empty { display: none; }
  .note { margin: 0; font: var(--type-meta); letter-spacing: 0.02em; color: var(--color-text); }
  /* Without JavaScript the controls stay disabled: keep them reading as the finished design. */
  input:disabled, button:disabled { opacity: 1; cursor: default; }

  /* Open: the conversation card. */
  .chat[data-open] { max-width: none; height: 44.6875rem; overflow: hidden; border: 1px solid var(--color-heading); border-radius: 28px; background: var(--color-card); }
  .chat[data-open] .head, .chat[data-open] .pinned { display: flex; flex: none; }
  .chat[data-open] .log { display: flex; }
  .head { align-items: center; gap: var(--space-sm); padding: var(--space-md); border-bottom: 1px solid var(--color-border); }
  .avatar { flex: none; width: 2.5rem; height: 2.5rem; border-radius: 50%; object-fit: cover; }
  .who { display: flex; flex-direction: column; gap: 2px; }
  .name { margin: 0; font: 500 var(--font-size-small)/1.25rem var(--font-sans); color: var(--color-heading); }
  .status, .label, .key { margin: 0; font: var(--type-meta); letter-spacing: var(--type-meta-tracking); text-transform: uppercase; color: var(--color-text-muted); }
  .status { display: flex; align-items: center; gap: 6px; }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-signal); }
  /* Inside: the composer's annotation describes the idle composer. In the conversation it would run off
     the screen, so it leaves with its numbered list (which closes the Contact section, outside the card). */
  .chat[data-open] :global(.annotation),
  :global(#contact[data-chatting] .annotation-list) { display: none; }
  .pinned { flex-direction: column; gap: var(--space-2xs); padding: var(--space-md); border-bottom: 1px solid var(--color-border); background: var(--color-surface); }
  .first, .value { margin: 0; overflow-wrap: anywhere; font: 400 var(--font-size-small)/1.5 var(--font-sans); color: var(--color-heading); }
  .log { flex: 1; min-height: 0; flex-direction: column; gap: var(--space-sm); padding: var(--space-md); overflow-y: auto; overscroll-behavior: contain; }
  /* Bottom-anchored but still scrollable: the first child's auto margin takes the free space. */
  .log > :global(:first-child) { margin-top: auto; }
  .chat[data-open] .area { flex: none; padding: 0 var(--space-md) var(--space-md); }
  .chat[data-open] .field { height: auto; padding: 6px 6px 6px var(--space-lg); background: var(--color-bg); }
  .chat[data-open] input[type='text'] { font: 400 var(--font-size-small)/1.5 var(--font-sans); }
  .chat[data-open] .send { width: 2.75rem; height: 2.75rem; }

  .msg { display: flex; flex: none; }
  .msg.visitor { justify-content: flex-end; }
  .bubble { display: flex; gap: var(--space-xs); max-width: 80%; padding: var(--space-sm) var(--space-md); border: 1px solid var(--color-border); border-radius: var(--radius-xl) var(--radius-xl) var(--radius-xl) 6px; background: var(--color-surface); font: 400 var(--font-size-small)/1.5 var(--font-sans); color: var(--color-text); }
  .bubble p { margin: 0; overflow-wrap: anywhere; }
  .visitor .bubble { border-color: var(--color-accent); border-radius: var(--radius-xl) var(--radius-xl) 6px var(--radius-xl); background: var(--color-accent); color: var(--color-accent-text); }
  .bubble :global(svg) { flex: none; margin-top: 2px; }
  .bubble.sent :global(svg) { color: var(--color-text-muted); }
  .bubble.error { border-color: var(--color-heading); background: var(--color-tutorial-chip); color: var(--color-tutorial-chip-text); }
  .bubble.typing { align-items: center; padding-block: var(--space-md); }
  .dots { display: flex; gap: 5px; }
  .dots i { width: 7px; height: 7px; border-radius: 50%; background: var(--color-text-muted); }
  .dots i:nth-child(2) { opacity: 0.6; }
  .dots i:nth-child(3) { opacity: 0.3; }

  .block { display: flex; flex: none; flex-direction: column; align-items: flex-start; gap: var(--space-sm); }
  .card { display: flex; flex-direction: column; gap: var(--space-2xs); width: 100%; padding: var(--space-md); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-card-raised); }
  .rows { margin: 0; padding: 0; list-style: none; }
  .row { display: flex; align-items: center; gap: var(--space-xs); padding: var(--space-xs) 0; border-bottom: 1px solid var(--color-border); }
  .row:last-child { border-bottom: 0; }
  .text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .pencil { display: grid; place-items: center; flex: none; width: 2.75rem; height: 2.75rem; padding: 0; border: 0; border-radius: 50%; background: none; color: var(--color-heading); cursor: pointer; transition: background-color var(--dur-press) var(--ease-out), scale var(--dur-press) var(--ease-out); }
  /* color-current differs from the card in both lenses (HI-06). */
  .pencil:active { background: var(--color-current); scale: 0.97; }
  @media (hover: hover) and (pointer: fine) {
    .pencil:hover { background: var(--color-current); }
    .send:not(:disabled):hover { background: var(--color-accent-hover); }
  }
  .confirm .sending { display: none; }
  .block[data-state='sending'] .confirm [data-confirm], .block[data-state='failed'] .confirm, .block[data-state='sent'] .confirm { display: none; }
  .block[data-state='sending'] .confirm .sending { display: inline-flex; cursor: default; opacity: 0.75; }
  .block[data-state='sending'] .pencil { opacity: 0.35; pointer-events: none; }
  .block[data-state='sent'] .card { opacity: 0.6; }
  .block[data-state='sent'] .pencil { display: none; }
  .actions, .next { display: flex; flex-wrap: wrap; gap: var(--space-xs); flex: none; margin: 0; padding: 0; list-style: none; }
  .actions { flex-direction: column; align-items: flex-start; }

  /* States that have no composer: summary, sending and failed show only the note. */
  .chat[data-mode='summary'] .chips, .chat[data-mode='summary'] .composer,
  .chat[data-mode='sending'] .chips, .chat[data-mode='sending'] .composer,
  .chat[data-mode='failed'] .chips, .chat[data-mode='failed'] .composer { display: none; }
  /* While Jahat is typing the composer waits. */
  .chat[data-busy] .field { opacity: 0.6; }
  .chat[data-busy] .chips { pointer-events: none; opacity: 0.6; }

  @media (min-width: 48rem) {
    .chat[data-open] { height: 40rem; }
  }
  @media (min-width: 64.0625rem) {
    .chat { max-width: 38.75rem; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .msg, .block, .next, .actions { animation: rise 240ms ease-out; }
    .dots i { animation: pulse 1.2s ease-in-out infinite; }
    .dots i:nth-child(2) { animation-delay: 0.2s; }
    .dots i:nth-child(3) { animation-delay: 0.4s; }
    .sending :global(svg) { animation: turn 1s linear infinite; }
  }
  @media (prefers-reduced-motion: reduce) {
    .send, .pencil { transition: none; }
    .send:not(:disabled):active, .pencil:active { scale: none; }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(8px); } }
  @keyframes pulse { 50% { transform: translateY(-2px); } }
  @keyframes turn { to { transform: rotate(360deg); } }
</style>
