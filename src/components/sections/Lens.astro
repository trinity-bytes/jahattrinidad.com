---
/*
 * The lens: docked bottom-right of the viewport. Drag it over the page to look
 * through a circle at the Inside, drop it to switch; click, Enter or the I key switch
 * without dragging; Esc or "Back outside" return (design.md §2, board 2109:103).
 * The state lives on <html data-lens> and is not persisted; only "shortcut disabled" and "lens already used" (to stop the idle shake) are kept in localStorage.
 */
import Icon from '../ui/Icon.astro';
import type { Dictionary } from '../../lib/i18n';

interface Props {
  strings: Dictionary['lens'];
}
const { strings } = Astro.props;
---

<div
  class="dock"
  data-lens-dock
  data-inside-announcement={strings.insideAnnouncement}
  data-outside-announcement={strings.outsideAnnouncement}
>
  <button
    class="lens"
    type="button"
    data-lens-open
    aria-label={strings.lookInside}
    aria-describedby="lens-hint"
    aria-keyshortcuts="I"
  >
    <Icon name="search" size={28} />
  </button>
  <span class="pill" id="lens-hint">
    <span class="pill-pointer">{strings.pointerHint}</span>
    <span class="pill-touch">{strings.touchHint}</span>
  </span>
  <button class="back" type="button" data-lens-back aria-keyshortcuts="Escape">
    <Icon name="search" size={20} />
    {strings.backOutside}
    <kbd aria-hidden="true">{strings.escapeKey}</kbd>
  </button>
  <div class="ring" data-lens-ring aria-hidden="true"></div>
</div>

<script>
  import { createPreview, type Preview } from './lens/preview';

  /** Circle radius: 190 px, measured on the Lens states board (2109:103, drawn at half scale). */
  const RADIUS = 190;
  const DRAG_THRESHOLD = 6;
  /** On touch the circle sits above the thumb: lens radius + gap + circle radius. */
  const TOUCH_LIFT = 40 + 8 + RADIUS;
  const SHORTCUT_KEY = 'lens-shortcut-disabled';
  const DISCOVERED_KEY = 'lens-discovered';
  const NUDGE_EVERY = 7000;
  const FIRST_NUDGE = 3800;
  const EDITABLE = 'input, textarea, select, [contenteditable]:not([contenteditable="false"])';

  const root = document.documentElement;
  const dock = document.querySelector<HTMLElement>('[data-lens-dock]');
  const lens = dock?.querySelector<HTMLButtonElement>('[data-lens-open]');
  const back = dock?.querySelector<HTMLButtonElement>('[data-lens-back]');
  const ring = dock?.querySelector<HTMLElement>('[data-lens-ring]');
  const main = document.querySelector<HTMLElement>('main');
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const coarsePointer = matchMedia('(pointer: coarse)');

  if (dock && lens && back && ring && main) {
    ring.style.setProperty('--lens-radius', `${RADIUS}px`);
    type Lens = 'inside' | 'outside';
    type Drag = { id: number; startX: number; startY: number; preview?: Preview; center: { x: number; y: number } };

    let shortcutDisabled = false;
    try { shortcutDisabled = localStorage.getItem(SHORTCUT_KEY) === 'true'; } catch { /* Storage can be unavailable. */ }
    window.addEventListener('lens-shortcut-change', (event) => {
      shortcutDisabled = (event as CustomEvent<{ disabled: boolean }>).detail.disabled;
    });

    function announce(message: string) {
      const region = document.getElementById('announcements');
      if (region) region.textContent = message;
    }

    type Origin = { x: number; y: number; r: number };
    /** Centre and radius (viewport px) of a control, where a reveal starts. */
    function originOf(element: Element): Origin {
      const box = element.getBoundingClientRect();
      return { x: box.left + box.width / 2, y: box.top + box.height / 2, r: Math.min(box.width, box.height) / 2 };
    }

    /**
     * Switches the page state; `cleanup` runs with it so the transition's snapshot can include the preview.
     * The new state is revealed by a circle that opens from `origin` (the lens, the dropped x-ray circle or
     * the Back outside button) with the same expo in-out curve as the hero's load, only quicker.
     */
    function switchTo(next: Lens, cleanup?: () => void, origin?: Origin) {
      if (root.dataset.lens === next) {
        cleanup?.();
        return;
      }
      const from = origin ?? originOf(next === 'inside' ? lens! : back!);
      const apply = () => {
        cleanup?.();
        const hadFocus = dock!.contains(document.activeElement);
        root.dataset.lens = next;
        announce(next === 'inside' ? dock!.dataset.insideAnnouncement! : dock!.dataset.outsideAnnouncement!);
        // The control that had focus is now hidden; hand focus to its counterpart.
        if (hadFocus) (next === 'inside' ? back : lens)!.focus();
      };
      if (reducedMotion.matches || !document.startViewTransition) {
        apply();
        return;
      }
      root.dataset.lensReveal = '';
      const transition = document.startViewTransition(apply);
      transition.ready.then(() => {
        const end = Math.hypot(Math.max(from.x, innerWidth - from.x), Math.max(from.y, innerHeight - from.y));
        root.animate(
          { clipPath: [`circle(${from.r}px at ${from.x}px ${from.y}px)`, `circle(${end}px at ${from.x}px ${from.y}px)`] },
          { duration: 900, easing: 'cubic-bezier(0.87, 0, 0.13, 1)', pseudoElement: '::view-transition-new(root)' },
        );
      }).catch(() => {});
      transition.finished.finally(() => delete root.dataset.lensReveal);
    }

    const toggle = () => switchTo(root.dataset.lens === 'inside' ? 'outside' : 'inside');

    // Drag: pointer events cover mouse, pen and touch.
    let drag: Drag | null = null;
    let last = { x: 0, y: 0 };
    let frame = 0;
    let suppressClick = false;

    function render() {
      frame = 0;
      if (!drag?.preview) return;
      const dx = last.x - drag.startX;
      const dy = last.y - drag.startY;
      lens!.style.setProperty('--dx', `${dx}px`);
      lens!.style.setProperty('--dy', `${dy}px`);
      const x = drag.center.x + dx;
      const y = drag.center.y + dy - (coarsePointer.matches ? TOUCH_LIFT : 0);
      ring!.style.transform = `translate(${x - RADIUS}px, ${y - RADIUS}px)`;
      drag.preview.layer.style.clipPath = `circle(${RADIUS}px at ${x + scrollX}px ${y + scrollY - drag.preview.top}px)`;
    }
    const schedule = () => { frame ||= requestAnimationFrame(render); };

    function startDrag(current: Drag) {
      const box = lens!.getBoundingClientRect();
      current.center = { x: box.left + box.width / 2, y: box.top + box.height / 2 };
      current.preview = createPreview(main!);
      current.preview.layer.style.clipPath = 'circle(0)';
      document.body.append(current.preview.layer);
      dock!.dataset.dragging = '';
      root.dataset.lensDragging = '';
      window.addEventListener('scroll', schedule, { passive: true });
    }

    /** Tears down a drag's preview and lens offset; the caller has already cleared `drag`. */
    function endDrag(ended: Drag | null) {
      cancelAnimationFrame(frame);
      frame = 0;
      window.removeEventListener('scroll', schedule);
      ended?.preview?.layer.remove();
      delete dock!.dataset.dragging;
      delete root.dataset.lensDragging;
      lens!.style.removeProperty('--dx');
      lens!.style.removeProperty('--dy');
    }

    /** Esc or a pointer cancel: back to the dock without switching. */
    function cancelDrag() {
      const cancelled = drag;
      drag = null;
      endDrag(cancelled);
      // With Esc the pointer is still down; its release must not count as a click.
      suppressClick = true;
    }

    lens.addEventListener('pointerdown', (event) => {
      if (event.button !== 0 || !event.isPrimary) return;
      lens.setPointerCapture(event.pointerId);
      drag = { id: event.pointerId, startX: event.clientX, startY: event.clientY, center: { x: 0, y: 0 } };
      delete dock.dataset.hint;
    });
    lens.addEventListener('pointermove', (event) => {
      if (!drag || event.pointerId !== drag.id) return;
      if (!drag.preview && Math.hypot(event.clientX - drag.startX, event.clientY - drag.startY) < DRAG_THRESHOLD) return;
      if (!drag.preview) startDrag(drag);
      last = { x: event.clientX, y: event.clientY };
      schedule();
    });
    lens.addEventListener('pointerup', (event) => {
      // The click that follows a drag or a cancelled drag must not switch.
      setTimeout(() => { suppressClick = false; });
      if (!drag || event.pointerId !== drag.id) return;
      const dropped = drag;
      drag = null;
      if (!dropped.preview) return;
      suppressClick = true;
      // Reveal from the x-ray circle itself, so the circle the visitor was holding simply opens up.
      const x = dropped.center.x + (last.x - dropped.startX);
      const y = dropped.center.y + (last.y - dropped.startY) - (coarsePointer.matches ? TOUCH_LIFT : 0);
      switchTo('inside', () => endDrag(dropped), { x, y, r: RADIUS });
    });
    lens.addEventListener('pointercancel', () => {
      const cancelled = drag;
      drag = null;
      endDrag(cancelled);
    });
    lens.addEventListener('click', () => {
      if (!suppressClick) switchTo('inside');
    });
    back.addEventListener('click', () => switchTo('outside'));

    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        if (drag) cancelDrag();
        else if (root.dataset.lens === 'inside') switchTo('outside');
        return;
      }
      const isShortcut = event.key.toLowerCase() === 'i' && !event.ctrlKey && !event.metaKey && !event.altKey;
      if (!isShortcut || event.repeat || event.isComposing || shortcutDisabled || drag) return;
      if (event.target instanceof Element && event.target.closest(EDITABLE)) return;
      toggle();
    });

    // Until the visitor first uses the lens, it gives a gentle shake every few seconds (only Outside, never
    // while hovered, dragged or in a background tab), so the curious move the pointer to it and find its hint.
    let discovered = false;
    try { discovered = localStorage.getItem(DISCOVERED_KEY) === 'true'; } catch { /* Storage can be unavailable. */ }
    let nudges = 0;
    const discover = () => {
      if (discovered) return;
      discovered = true;
      clearInterval(nudges);
      try { localStorage.setItem(DISCOVERED_KEY, 'true'); } catch { /* Storage can be unavailable. */ }
    };
    lens.addEventListener('pointerdown', discover);
    lens.addEventListener('click', discover);
    window.addEventListener('keydown', (event) => { if (event.key.toLowerCase() === 'i' && !event.repeat) discover(); });
    lens.addEventListener('animationend', () => delete lens.dataset.nudge);
    if (!discovered && !reducedMotion.matches) {
      const nudge = () => {
        if (discovered || root.dataset.lens === 'inside' || drag || lens.matches(':hover, :focus-visible') || document.hidden) return;
        lens.dataset.nudge = '';
      };
      // The first shake comes right after the hero's load (it reveals the lens), then every NUDGE_EVERY.
      setTimeout(nudge, FIRST_NUDGE);
      nudges = window.setInterval(nudge, NUDGE_EVERY);
    }

    // Touch has no hover: show the "Tap the lens" hint for a few seconds once the page has loaded.
    if (coarsePointer.matches) {
      const showHint = () => {
        dock.dataset.hint = '';
        setTimeout(() => delete dock.dataset.hint, 5000);
      };
      if (document.readyState === 'complete') showHint();
      else window.addEventListener('load', showHint, { once: true });
    }
  }
</script>

<style>
  :global(html[data-menu-open]) .dock, :global(html[data-chat-in-view]) .dock { display: none; }
  .dock {
    position: fixed;
    z-index: 60;
    right: var(--gutter);
    bottom: var(--space-2xl);
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }
  .lens {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    padding: 0;
    border: 1.5px solid var(--green-950);
    border-radius: 50%;
    background: var(--card);
    color: var(--green-950);
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    transform: translate(var(--dx, 0), var(--dy, 0)) scale(var(--scale, 1));
    transition: transform 0.2s;
  }
  /* Two tones so the ring shows on the cream page and on the near-black footer ground. */
  .lens:focus-visible { outline: 3px solid var(--green-950); outline-offset: 2px; box-shadow: 0 0 0 2px var(--card); }
  .dock[data-dragging] .lens { --scale: 1.25; cursor: grabbing; transition: none; }

  .pill {
    position: absolute;
    right: calc(100% + 12px);
    top: 50%;
    translate: 0 -50%;
    width: max-content;
    max-width: min(30rem, calc(100vw - 2 * var(--gutter) - 64px - 12px));
    padding: 12px 20px;
    border: 1px solid color-mix(in srgb, var(--green-950) 12%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--card) 70%, transparent);
    backdrop-filter: blur(12px);
    box-shadow: 0 4px 16px color-mix(in srgb, var(--green-950) 14%, transparent);
    color: var(--green-950);
    font: 500 1rem/1.25 var(--font-sans);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s;
  }
  .pill-touch { display: none; }
  .lens:is(:hover, :focus-visible) ~ .pill,
  .dock[data-hint] .pill { opacity: 1; }
  .dock[data-dragging] .pill { opacity: 0; }
  @media (pointer: coarse) {
    .pill-pointer { display: none; }
    .pill-touch { display: inline; }
  }

  .back {
    display: none;
    align-items: center;
    gap: 10px;
    padding: 12px 22px 12px 18px;
    border: 0;
    border-radius: 999px;
    background: var(--green-300);
    color: var(--green-950);
    font: 500 1rem/normal var(--font-sans);
    cursor: pointer;
  }
  .back kbd {
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--green-950);
    color: var(--green-300);
    font: 500 0.75rem/normal var(--font-mono);
  }
  @media (pointer: coarse) { .back kbd { display: none; } }
  :global(:root[data-lens='inside']) .lens,
  :global(:root[data-lens='inside']) .pill { display: none; }
  :global(:root[data-lens='inside']) .back { display: inline-flex; }

  .ring {
    position: fixed;
    top: 0;
    left: 0;
    width: calc(2 * var(--lens-radius));
    height: calc(2 * var(--lens-radius));
    border: 2px solid var(--sun);
    border-radius: 50%;
    pointer-events: none;
    visibility: hidden;
  }
  .dock[data-dragging] .ring { visibility: visible; }

  @media (prefers-reduced-motion: reduce) {
    .lens, .pill { transition: none; }
  }

  /* Built by script, so these rules are global. */
  :global(.lens-preview) {
    position: absolute;
    left: 0;
    z-index: 10;
    width: 100%;
    overflow: hidden;
    pointer-events: none;
    will-change: clip-path;
    background: var(--color-bg);
    color: var(--color-text);
    color-scheme: dark;
    font-family: var(--font-sans), sans-serif;
    font-size: var(--font-size-body);
  }
  :global(:root[data-lens-dragging]) { user-select: none; -webkit-user-select: none; cursor: grabbing; }
  :global(::view-transition-group(root)) { animation-duration: 300ms; }
  /* Lens switch: the new state is revealed by a circle (see switchTo); no crossfade under it. */
  :global(:root[data-lens-reveal]::view-transition-old(root)),
  :global(:root[data-lens-reveal]::view-transition-new(root)) { animation: none; mix-blend-mode: normal; }

  /* The idle shake: a short side-to-side knock with a slight tilt (a round button only reads as moving
     when it travels, not when it spins). `translate` and `rotate` are their own properties, so they never
     fight the drag's transform. */
  .lens[data-nudge] { animation: lens-nudge 0.75s cubic-bezier(0.36, 0.07, 0.19, 0.97); }
  @keyframes lens-nudge {
    0%, 100% { translate: 0; rotate: 0deg; }
    15% { translate: -7px 0; rotate: -10deg; }
    30% { translate: 6px 0; rotate: 8deg; }
    45% { translate: -5px 0; rotate: -6deg; }
    60% { translate: 3px 0; rotate: 4deg; }
    75% { translate: -1.5px 0; rotate: -2deg; }
  }
  @media (prefers-reduced-motion: reduce) { .lens[data-nudge] { animation: none; } }
</style>
