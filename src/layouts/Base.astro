---
import type { Locale } from '../lib/i18n';
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import Nav from '../components/sections/Nav.astro';
import Lens from '../components/sections/Lens.astro';
import Magnetic from '../components/ui/Magnetic.astro';
import SmoothScroll from '../components/sections/SmoothScroll.astro';
import { getDictionary, localizedPath, LOCALES, LOCALE_NAMES } from '../lib/i18n';
import { BCP47 } from '../lib/consts';
import { collectionPath } from '../lib/paths';
import type { SeoResult } from '../lib/seo';
import { localeRedirectScript } from '../lib/locale-redirect';
import { pageTransitionScript } from '../lib/page-transition';

export interface Props {
  lang: Locale;
  seo: SeoResult;
  /** Pages with an Inside state (the Home) opt in to the lens control. */
  lens?: boolean;
  /** Launcher pages (/links/) render without the nav; the skip link and landmarks stay. */
  nav?: boolean;
  /** Profile links for the mobile menu; pages read them from content.ts (layouts may not). */
  profileLinks?: { label: string; href: string }[];
  /** The page renders its own Contact section (PageContact); the nav's Contact link then stays on the page. */
  contactOnPage?: boolean;
  /** Serialized schema.org data (from lib/seo.ts), rendered as JSON-LD in <head>. */
  jsonLd?: string;
  /** The page plays the Home hero's load choreography (Hero.astro): mark it from the head, before first paint. */
  heroIntro?: boolean;
}

const { lang, seo, lens = false, nav = true, profileLinks = [], contactOnPage = false, jsonLd, heroIntro = false } = Astro.props;
const t = getDictionary(lang);

// EN / ES / PT switch: each locale goes to this page's counterpart (its hreflang
// alternate) or, when the page has none, to that locale's Home.
const counterpart = (locale: Locale) =>
  seo.alternates.find((alternate) => alternate.hrefLang === BCP47[locale])?.href;
const languages = LOCALES.map((locale) => ({
  lang: locale,
  hrefLang: BCP47[locale],
  code: locale.toUpperCase(),
  name: LOCALE_NAMES[locale],
  href: locale === lang ? Astro.url.pathname : (counterpart(locale) ? new URL(counterpart(locale)!).pathname : localizedPath(locale, '/')),
  current: locale === lang,
}));

// First-visit redirect to the visitor's language: only real counterparts, never a fallback Home.
const counterparts = Object.fromEntries(
  LOCALES.filter((locale) => locale !== lang && counterpart(locale)).map((locale) => [locale, new URL(counterpart(locale)!).pathname])
);
const localeScript = localeRedirectScript({ redirect: lang === 'en', counterparts });
---

<!doctype html>
<html lang={lang} translate="no" data-lens="outside">
  <head>
    <meta charset="utf-8" />
    <!-- Cross-document View Transitions opt-in (lib/page-transition.ts). Inline, before anything else:
         in an external stylesheet it arrives after the head scripts on a real network, and Chromium then
         treats the new page as not opted in and aborts the transition ("opt-in disabled"). -->
    <style is:inline>@media (prefers-reduced-motion: no-preference) { @view-transition { navigation: auto; } }</style>
    <script is:inline set:html={localeScript} />
    <script is:inline set:html={pageTransitionScript()} />
    {heroIntro && (
      <script is:inline>
        // Hero load choreography marker (Hero.astro). Here in the head, before the hero exists: set from inside
        // the hero component it came after the hero's markup, so phones painted the whole hero for a moment and
        // then hid it. Only at the top of a fresh load, with motion allowed, and not when the page arrives through
        // the page transition (html[data-page-reveal], set by the script above): two circles at once would fight.
        // A safety timeout releases everything if the hero script never runs.
        if (window.scrollY === 0 && !('pageReveal' in document.documentElement.dataset) && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.dataset.heroIntro = '';
          setTimeout(() => delete document.documentElement.dataset.heroIntro, 3500);
        }
      </script>
    )}
    <meta name="google" content="notranslate" />
    <Font cssVariable="--font-epilogue" />
    <Font cssVariable="--font-hanken" />
    <Font cssVariable="--font-plex-mono" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    {seo.alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hrefLang} href={alternate.href} />
    ))}
    <meta property="og:title" content={seo.openGraph['og:title']} />
    <meta property="og:description" content={seo.openGraph['og:description']} />
    <meta property="og:url" content={seo.openGraph['og:url']} />
    <meta property="og:type" content={seo.openGraph['og:type']} />
    <meta property="og:image" content={seo.openGraph['og:image']} />
    <meta property="og:image:width" content={seo.openGraph['og:image:width']} />
    <meta property="og:image:height" content={seo.openGraph['og:image:height']} />
    <meta property="og:image:alt" content={seo.imageAlt ?? t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0a200b" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t.nav.skipToContent}</a>
    {nav && <Nav
      home={localizedPath(lang, '')}
      workPath={collectionPath('projects', lang)}
      notesPath={collectionPath('posts', lang)}
      strings={t.nav}
      newTab={t.common.newTab}
      profileLinks={profileLinks}
      languages={languages}
      contactOnPage={contactOnPage}
    />}
    <slot name="backgrounds" />
    <main id="main-content" tabindex="-1"><slot /></main>
    <slot name="footer" />
    <div class="visually-hidden" aria-live="polite" aria-atomic="true" id="announcements"></div>
    {lens && <Lens strings={t.lens} />}
    <Magnetic />
    <SmoothScroll />
  </body>
</html>

<style is:global>
  @layer base {
    *, *::before, *::after { box-sizing: border-box; }
    body { margin: 0; font-family: var(--font-sans), sans-serif; font-size: var(--font-size-body); line-height: 1.5; background: var(--color-bg); color: var(--color-text); }
    h1, h2, h3, h4 { text-wrap: balance; }
    p, li, dd { text-wrap: pretty; }
    button, input, textarea, select { font: inherit; color: inherit; }
    pre, code { font-family: var(--font-mono), monospace; }
    :focus-visible { outline: var(--focus-width) solid var(--color-focus); outline-offset: var(--focus-offset); }
    /* UI/Control line height. Without it the nav pill inherits 1.5, the bar grows past the 69px that the
       hero pulls itself under (Nav.astro) and a strip of page shows above the sky. Goes away with ui/Button. */
    .site-nav .contact { line-height: 1.25rem; }
    a { color: inherit; text-decoration-color: var(--color-text-muted); text-underline-offset: 0.2em; }
    a:hover { text-decoration-color: currentColor; }
    /* Page-width wrapper with the board gutters; full-bleed sections skip it. */
    .container { max-width: calc(var(--content-max) + 2 * var(--gutter)); margin-inline: auto; padding-inline: var(--gutter); }
    .skip-link { position: fixed; z-index: 100; top: var(--space-sm); left: var(--space-sm); padding: var(--space-sm); background: var(--color-bg); color: var(--color-text); transform: translateY(-200%); }
    .skip-link:focus { transform: translateY(0); }
    /* Copy that differs by lens is rendered twice; only the active state shows (design.md §2). */
    /* The lens preview is an Inside clone: it follows the Inside copy whatever the page state is. */
    :root:not([data-lens='inside']) [data-show='inside']:not([data-lens-preview] *),
    :root[data-lens='inside'] [data-show='outside'],
    [data-lens-preview] [data-show='outside'] { display: none !important; }
    .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  }
  /* Page-to-page transition (lib/page-transition.ts; the @view-transition opt-in is inline at the top of
     the head): while html[data-page-reveal] is set, the reveal is a circle, so the default crossfade is off. */
  :root[data-page-reveal]::view-transition-old(root),
  :root[data-page-reveal]::view-transition-new(root) { animation: none; mix-blend-mode: normal; }
  /* Going back, the page being left closes into the link over the page it returns to. */
  :root[data-page-reveal='shrink']::view-transition-old(root) { z-index: 1; }
</style>
